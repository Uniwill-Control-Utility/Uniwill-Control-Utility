<UserControl x:Class="Universal_x86_Tuning_Utility.Views.Controls.QuickActionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FlowDirection="LeftToRight">

    <UserControl.Resources>
        <Style x:Key="QuickActionCardStyle" TargetType="ui:Card">
            <Setter Property="Padding" Value="12,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Refresh Rate -->
        <ui:Card Grid.Row="0" Grid.Column="0" Margin="0,0,4,4" Padding="12,10"
                 Style="{StaticResource QuickActionCardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowSync20" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Refresh Rate" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <ComboBox x:Name="_cmbRefreshRate"
                          Margin="0,8,0,0"
                          HorizontalContentAlignment="Stretch"
                          SelectionChanged="_cmbRefreshRate_SelectionChanged" />
            </StackPanel>
        </ui:Card>

        <!-- Resolution -->
        <ui:Card Grid.Row="0" Grid.Column="1" Margin="4,0,4,4" Padding="12,10"
                 Style="{StaticResource QuickActionCardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Play20" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Resolution" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <ComboBox x:Name="_cmbResolution"
                          Margin="0,8,0,0"
                          HorizontalContentAlignment="Stretch"
                          SelectionChanged="_cmbResolution_SelectionChanged" />
            </StackPanel>
        </ui:Card>

        <!-- HDR -->
        <ui:Card Grid.Row="0" Grid.Column="2" Margin="4,0,4,4" Padding="12,10"
                 Style="{StaticResource QuickActionCardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Hdr20" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="HDR" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <ui:ToggleSwitch x:Name="_toggleHdr"
                                 Margin="0,8,0,0"
                                 OffContent="Off"
                                 OnContent="On"
                                 Checked="_toggleHdr_Checked"
                                 Unchecked="_toggleHdr_Unchecked" />
            </StackPanel>
        </ui:Card>

        <!-- Night Light -->
        <ui:Card Grid.Row="0" Grid.Column="3" Margin="4,0,0,4" Padding="12,10"
                 Style="{StaticResource QuickActionCardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="WeatherMoon20" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Night Light" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <ui:ToggleSwitch x:Name="_toggleNightLight"
                                 Margin="0,8,0,0"
                                 OffContent="Off"
                                 OnContent="On"
                                 Checked="_toggleNightLight_Checked"
                                 Unchecked="_toggleNightLight_Unchecked" />
            </StackPanel>
        </ui:Card>

        <!-- Microphone Mute -->
        <ui:Card Grid.Row="1" Grid.Column="0" Margin="0,4,4,0" Padding="12,10"
                 Style="{StaticResource QuickActionCardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="MicOff20" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Mic Mute" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <ui:Button x:Name="_btnMicMute"
                           Content="Settings"
                           Margin="0,8,0,0"
                           Appearance="Secondary"
                           Click="_btnMicMute_Click" />
            </StackPanel>
        </ui:Card>

        <!-- Touchpad -->
        <ui:Card Grid.Row="1" Grid.Column="1" Margin="4,4,4,0" Padding="12,10"
                 Style="{StaticResource QuickActionCardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="TapSingle20" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Touchpad" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <ui:Button x:Name="_btnTouchpad"
                           Content="Settings"
                           Margin="0,8,0,0"
                           Appearance="Secondary"
                           Click="_btnTouchpad_Click" />
            </StackPanel>
        </ui:Card>

        <!-- Night Charge -->
        <ui:Card Grid.Row="1" Grid.Column="2" Margin="4,4,4,0" Padding="12,10"
                 Style="{StaticResource QuickActionCardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="BatteryCharge20" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Night Charge" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <ui:Button x:Name="_btnNightCharge"
                           Content="Settings"
                           Margin="0,8,0,0"
                           Appearance="Secondary"
                           Click="_btnNightCharge_Click" />
            </StackPanel>
        </ui:Card>

        <!-- Display Settings -->
        <ui:Card Grid.Row="1" Grid.Column="3" Margin="4,4,0,0" Padding="12,10"
                 Style="{StaticResource QuickActionCardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Desktop20" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Display" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <ui:Button x:Name="_btnDisplay"
                           Content="Settings"
                           Margin="0,8,0,0"
                           Appearance="Secondary"
                           Click="_btnDisplay_Click" />
            </StackPanel>
        </ui:Card>
    </Grid>
</UserControl>
