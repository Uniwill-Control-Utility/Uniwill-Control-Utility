<UserControl x:Class="Universal_x86_Tuning_Utility.Views.Controls.KeyboardMultiColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Color chips row + add/remove buttons -->
        <Border Name="ChipRowBorder"
                Background="Transparent">
            <StackPanel Name="ColorChipsPanel"
                        Orientation="Horizontal"
                        VerticalAlignment="Center" />
        </Border>
    </StackPanel>
</UserControl>
