<UserControl x:Class="Universal_x86_Tuning_Utility.Views.Controls.VfCurveEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight"
             MinHeight="200">

    <Grid Margin="0,8,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Y-axis labels (Frequency MHz) — Canvas for pixel-precise positioning -->
        <Canvas x:Name="_yAxisLabels"
                Grid.Row="0" Grid.Column="0"
                Width="40">
            <Canvas.Height>
                <Binding ElementName="_graphBorder" Path="ActualHeight" Mode="OneWay"/>
            </Canvas.Height>
        </Canvas>

        <!-- Graph area — uses explicit lines instead of Border for precise axis alignment -->
        <Border x:Name="_graphBorder"
                Grid.Row="0" Grid.Column="1"/>

        <!-- Left axis line (full height) -->
        <Line x:Name="_axisLineLeft"
              Grid.Row="0" Grid.Column="1"
              X1="0" Y1="0"
              Stroke="{DynamicResource TextFillColorDisabledBrush}"
              StrokeThickness="1"/>

        <!-- Bottom axis line (width matches drawing area, respects right margin) -->
        <Line x:Name="_axisLineBottom"
              Grid.Row="0" Grid.Column="1"
              Y1="0" Y2="0"
              Stroke="{DynamicResource TextFillColorDisabledBrush}"
              StrokeThickness="1"/>

        <!-- Canvas for curve line, fill, and draggable points -->
        <Canvas x:Name="_canvas" Grid.Row="0" Grid.Column="1"
                Focusable="True"
                KeyboardNavigation.TabNavigation="None"
                MouseMove="Canvas_MouseMove"
                MouseLeave="Canvas_MouseLeave"
                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                PreviewKeyDown="Canvas_PreviewKeyDown"/>

        <!-- X-axis labels (Voltage mV) — fills grid column like the canvas -->
        <Canvas x:Name="_xAxisLabels"
                Grid.Row="1" Grid.Column="1"
                Height="20"
                Margin="0,4,0,0"/>
    </Grid>
</UserControl>
