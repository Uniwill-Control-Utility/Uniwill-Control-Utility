<UserControl x:Class="Universal_x86_Tuning_Utility.Views.Controls.VfCurveEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight">

    <Grid Margin="0,8,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="300"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Y-axis labels (Frequency MHz) — Canvas for pixel-precise positioning -->
        <Canvas x:Name="_yAxisLabels"
                Grid.Row="0" Grid.Column="0"
                Width="40"
                Height="300"/>

        <!-- Graph area -->
        <Border x:Name="_graphBorder"
                Grid.Row="0" Grid.Column="1"
                BorderBrush="{DynamicResource TextFillColorDisabledBrush}"
                BorderThickness="1,0,0,1"/>

        <!-- Canvas for curve line, fill, and draggable points -->
        <Canvas x:Name="_canvas" Grid.Row="0" Grid.Column="1"
                MouseMove="Canvas_MouseMove"
                MouseLeave="Canvas_MouseLeave"
                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                MouseLeftButtonUp="Canvas_MouseLeftButtonUp"/>

        <!-- X-axis labels (Voltage mV) — Canvas width bound to graph border -->
        <Canvas x:Name="_xAxisLabels"
                Grid.Row="1" Grid.Column="1"
                Height="20"
                Margin="0,4,0,0">
            <Canvas.Width>
                <Binding ElementName="_graphBorder" Path="ActualWidth" Mode="OneWay"/>
            </Canvas.Width>
        </Canvas>
    </Grid>
</UserControl>
