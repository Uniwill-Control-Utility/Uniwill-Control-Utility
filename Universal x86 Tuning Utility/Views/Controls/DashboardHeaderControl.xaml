<UserControl x:Class="Universal_x86_Tuning_Utility.Views.Controls.DashboardHeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="root"
             Height="300"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!--
            HeaderFadeMask group: all fades use white-to-transparent as OpacityMask.
            The bottom fade is the primary mask; left/top/right edge fades are applied
            as overlay rectangles with the same white-to-transparent gradients so they
            compose with the bottom fade to reveal the background color beneath.
          -->
         <!-- Bottom: solid, then fades to transparent over bottom 66% with emphasis on upper half -->
        <LinearGradientBrush x:Key="HeaderFadeBottom"
                             StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Offset="0.0"  Color="#ACFFFFFF" />
            <GradientStop Offset="0.34" Color="#FFFFFFFF" />
            <GradientStop Offset="0.44" Color="#D0FFFFFF" />
            <GradientStop Offset="0.54" Color="#80FFFFFF" />
            <GradientStop Offset="0.69" Color="#30FFFFFF" />
            <GradientStop Offset="1.0"  Color="#00FFFFFF" />
        </LinearGradientBrush>

        <!-- Left edge: transparent at edge, soft dispersal over wider band -->
        <LinearGradientBrush x:Key="HeaderFadeLeft"
                             StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Offset="0.0"   Color="#00FFFFFF" />
            <GradientStop Offset="0.05"  Color="#80FFFFFF" />
            <GradientStop Offset="0.10"  Color="#C0FFFFFF" />
            <GradientStop Offset="0.18"  Color="#E0FFFFFF" />
            <GradientStop Offset="0.28"  Color="#F0FFFFFF" />
            <GradientStop Offset="0.40"  Color="#FFFFFFFF" />
        </LinearGradientBrush>

        <!-- Top edge: mirrors bottom — transparent at top, fades to solid over top 66% -->
        <LinearGradientBrush x:Key="HeaderFadeTop"
                             StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Offset="0.0"   Color="#00FFFFFF" />
            <GradientStop Offset="0.31"  Color="#30FFFFFF" />
            <GradientStop Offset="0.46"  Color="#80FFFFFF" />
            <GradientStop Offset="0.56"  Color="#D0FFFFFF" />
            <GradientStop Offset="0.66"  Color="#FFFFFFFF" />
            <GradientStop Offset="1.0"   Color="#FFFFFFFF" />
        </LinearGradientBrush>

        <!-- Right edge: mirrors left with soft dispersal over wider band -->
        <LinearGradientBrush x:Key="HeaderFadeRight"
                             StartPoint="1,0.5" EndPoint="0,0.5">
            <GradientStop Offset="0.0"   Color="#00FFFFFF" />
            <GradientStop Offset="0.05"  Color="#80FFFFFF" />
            <GradientStop Offset="0.10"  Color="#C0FFFFFF" />
            <GradientStop Offset="0.18"  Color="#E0FFFFFF" />
            <GradientStop Offset="0.28"  Color="#F0FFFFFF" />
            <GradientStop Offset="0.40"  Color="#FFFFFFFF" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <!-- Root grid: clipped in code-behind for top-left rounded corner -->
    <Grid x:Name="HeaderGrid">
        <!-- Background layer — provides the rounded corner shape -->
        <Border x:Name="BackgroundBorder"
                 />

        <!-- Header image with combined fade mask (bottom + left + top + right) — set in code-behind -->
        <Grid x:Name="ImageGrid">
            <Image x:Name="HeaderImage"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   />
        </Grid>

        <!-- Content overlay — inset to match page content margins (36px provided by parent) -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title text (top-left) -->
            <StackPanel Grid.Row="0" Margin="0,40,0,0">
                <TextBlock x:Name="TitleText"
               FontFamily="Segoe UI Variable Display, Segoe UI"
               FontSize="28"
               FontWeight="SemiBold"
               LineHeight="40"
               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
               Text="Uniwill Control Utility" />
                <TextBlock x:Name="SubtitleText"
               Margin="0,8,0,0"
               FontFamily="Segoe UI Variable Text, Segoe UI"
               FontSize="12"
               FontWeight="Regular"
               LineHeight="16"
               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
               Text="Unified laptop and ecosystem control."
               TextWrapping="Wrap" />
            </StackPanel>


            <!-- Laptop info (bottom-center) -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Margin="0,24,0,16">
                <Image x:Name="LaptopImage"
                       Width="220"
                       Height="137"
                       Stretch="Uniform"
                       StretchDirection="DownOnly"
                       VerticalAlignment="Bottom"
                       Margin="0,0,12,0" />
                <StackPanel x:Name="LaptopInfoPanel"
                            Orientation="Vertical"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="LaptopNameText"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="DESKTOP SYSTEM"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="LaptopCPUNameText"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="CPU name"
                               Margin="0,0,0,2" />
                    <TextBlock x:Name="LaptopGPUNameText"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="GPU name"
                               Margin="0,0,0,2" />
                    <TextBlock x:Name="LaptopDisplaySpecText"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="Display"
                               Margin="0,0,0,2" />
                    <TextBlock x:Name="LaptopRamText"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="RAM"
                               Margin="0,0,0,2" />
                    <TextBlock x:Name="LaptopStorageText"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="Storage" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
