<Page x:Class="Universal_x86_Tuning_Utility.Views.Pages.RGB"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Universal_x86_Tuning_Utility.Views.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Universal_x86_Tuning_Utility.Views.Controls"
      mc:Ignorable="d"
      d:DesignHeight="620" d:DesignWidth="800"
      Title="RGB"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True"
      ScrollViewer.CanContentScroll="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      IsDeferredScrollingEnabled="False"
                      Margin="0,0,-18,0">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}"
                       BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Padding" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, RelativeSource={RelativeSource Self}}"
                                     Value="Visible">
                            <Setter Property="Padding" Value="0,0,8,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel Margin="18,10,36,18">
                <TextBlock FontSize="26"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="RGB" />
                <TextBlock Margin="0,4,0,12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Customize your device lighting."
                           TextWrapping="Wrap" />

                <!-- Unavailable state -->
                <StackPanel x:Name="RgbUnavailable" Visibility="Collapsed">
                    <Border Margin="0,8,0,0"
                            Padding="14,12"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Grid.Column="0"
                                         FontFamily="Segoe Fluent Icons"
                                         Glyph="&#xE7A7;"
                                         FontSize="16"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="RGB control is not available on this device. This feature requires an ITE HID lighting controller (vid_048d)."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Available content -->
                <StackPanel x:Name="RgbAvailable" Visibility="Visible">

                    <!-- Device segment control: Keyboard / Lightbar -->
                    <ui:CardControl Margin="0,0,0,8">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock FontWeight="DemiBold" Text="Device" />
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="Select which device to configure." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <Border x:Name="DeviceSegment"
      Margin="0,0,0,8"
      Padding="3"
      Background="{DynamicResource ControlFillColorDefaultBrush}"
      CornerRadius="4" HorizontalAlignment="Center">
    <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="DeviceKeyboardRadio"
                     GroupName="DeviceSegment"
                     Content="Keyboard"
                     IsChecked="True"
                     Click="DeviceSegment_RadioButton_Click"
                     HorizontalContentAlignment="Stretch"
                     VerticalContentAlignment="Center"
                     Padding="24,8"
                     FontSize="13"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     Background="Transparent"
                     BorderThickness="0">
            <RadioButton.Style>
                <Style TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="ContentBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="ContentBorder" Property="Background"
                                                Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ContentBorder" Property="Background"
                                                Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </RadioButton.Style>
        </RadioButton>
        <RadioButton x:Name="DeviceLightbarRadio"
                     GroupName="DeviceSegment"
                     Content="Lightbar"
                     Click="DeviceSegment_RadioButton_Click"
                     HorizontalContentAlignment="Stretch"
                     VerticalContentAlignment="Center"
                     Padding="24,8"
                     FontSize="13"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     Background="Transparent"
                     BorderThickness="0">
            <RadioButton.Style>
                <Style TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="ContentBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="ContentBorder" Property="Background"
                                                Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ContentBorder" Property="Background"
                                                Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </RadioButton.Style>
        </RadioButton>
    </StackPanel>
</Border>
                    </ui:CardControl>

                    

                    <!-- Keyboard content -->
                    <StackPanel x:Name="KeyboardContent">

                        <!-- Mode toggle: Effects / Per-Key -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontWeight="DemiBold" Text="Per-key RGB control" />
                                        <TextBlock FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="Enable per-key color control instead of animation effects." />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="ModeToggle"
                                                     Grid.Column="1"
                                                     Margin="0,0,9,0"
                                                     Checked="ModeToggle_Checked"
                                                     Unchecked="ModeToggle_Checked" />
                                </Grid>
                            </ui:CardControl.Header>
                        </ui:CardControl>

                        <!-- ===== EFFECTS MODE CONTENT ===== -->
                        <StackPanel x:Name="EffectsContent">
                            <!-- Keyboard power toggle -->
                            <ui:CardControl Margin="0,8,0,0">
                                <ui:CardControl.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:FontIcon Grid.Column="0"
                                                     FontFamily="Segoe Fluent Icons"
                                                     Glyph="&#xE786;"
                                                     FontSize="20"
                                                     Margin="0,0,12,0"
                                                     VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="DemiBold" Text="Keyboard Backlight" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="Turn the keyboard backlight on or off." />
                                        </StackPanel>

                                        <ui:ToggleSwitch x:Name="tsKeyboardPower"
                                                         Grid.Column="2"
                                                         Margin="0,0,9,0"
                                                         IsChecked="True"
                                                         Checked="TsKeyboardPower_Toggled"
                                                         Unchecked="TsKeyboardPower_Toggled" />
                                    </Grid>
                                </ui:CardControl.Header>
                            </ui:CardControl>

                            <!-- Effect card with all controls -->
                            <ui:CardExpander Margin="0,8,0,0"
                                            Header="Effect"
                                            IsExpanded="True">
                                <ui:CardExpander.Icon>
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE775;" FontSize="20" />
                                </ui:CardExpander.Icon>
                                <StackPanel>
                                    <!-- Effect type -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontWeight="DemiBold" Text="Type" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="Choose an animation effect." />
                                        </StackPanel>
                                        <ComboBox x:Name="cmbEffect"
                                                  Grid.Column="1"
                                                  Width="180"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  SelectionChanged="CmbEffect_SelectionChanged" />
                                    </Grid>

                                    <Separator Margin="0,12,0,12"
                                               Background="{DynamicResource ControlFillColorDefaultBrush}" />

                                    <!-- Color (visible for single-color effects) -->
                                    <Grid x:Name="ColorRow"
                                          Visibility="Visible">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontWeight="DemiBold" Text="Color" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="Single color for Static mode." />
                                        </StackPanel>
                                        <controls:ColorPickerControl x:Name="ColorPicker"
                                                                     Grid.Column="1"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Center"
                                                                     SelectedColor="Aqua"
                                                                     ColorChangedDelayed="ColorPicker_ColorChangedDelayed" />
                                    </Grid>

                                    <!-- Multi-color picker -->
                                    <Grid x:Name="MultiColorRow"
                                          Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontWeight="DemiBold"
                                                       x:Name="MultiColorTitle"
                                                       Text="Effect Colors" />
                                            <TextBlock FontSize="12"
                                                       x:Name="MultiColorSubtitle"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="7 colors required for this effect. Click a swatch to edit." />
                                        </StackPanel>
                                        <controls:KeyboardMultiColorPickerControl x:Name="MultiColorPicker"
                                                                                  Grid.Column="1"
                                                                                  HorizontalAlignment="Right"
                                                                                  VerticalAlignment="Center"
                                                                                  ColorsChanged="MultiColorPicker_ColorsChanged" />
                                    </Grid>

                                    <!-- Rest color picker for GamingModeFull -->
                                    <Grid x:Name="GamingModeFullRestRow"
                                          Visibility="Collapsed"
                                          Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontWeight="DemiBold"
                                                       Text="Rest of Keyboard" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="Color for non-WASD/arrow keys." />
                                        </StackPanel>
                                        <controls:ColorPickerControl x:Name="GamingModeFullRestColor"
                                                                     Grid.Column="1"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Center"
                                                                     SelectedColor="White"
                                                                     ColorChangedDelayed="GamingModeFullRestColor_ColorChangedDelayed" />
                                    </Grid>

                                    <Separator Margin="0,12,0,12"
                                               Background="{DynamicResource ControlFillColorDefaultBrush}" />

                                    <!-- Brightness -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontWeight="DemiBold" Text="Brightness" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="Adjust the backlight brightness level." />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="BrightnessValueText"
                                                       Width="30"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,0,12,0"
                                                       Text="5" />
                                            <Slider x:Name="BrightnessSlider"
                                                    Width="140"
                                                    Minimum="1"
                                                    Maximum="7"
                                                    Value="5"
                                                    IsSnapToTickEnabled="True"
                                                    TickFrequency="1"
                                                    IsMoveToPointEnabled="False"
                                                    ValueChanged="BrightnessSlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <Separator Margin="0,12,0,12"
                                               Background="{DynamicResource ControlFillColorDefaultBrush}" />

                                    <!-- Speed (visible for animated effects) -->
                                    <Grid x:Name="SpeedRow"
                                          Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontWeight="DemiBold" Text="Speed" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="Control the animation speed." />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="SpeedValueText"
                                                       Width="30"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,0,12,0"
                                                       Text="5" />
                                            <Slider x:Name="SpeedSlider"
                                                    Width="140"
                                                    Minimum="1"
                                                    Maximum="10"
                                                    Value="5"
                                                    IsSnapToTickEnabled="True"
                                                    TickFrequency="1"
                                                    IsMoveToPointEnabled="False"
                                                    ValueChanged="SpeedSlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ui:CardExpander>
                        </StackPanel>

                        <!-- ===== PER-KEY MODE CONTENT ===== -->
                        <StackPanel x:Name="PerKeyContent" Visibility="Collapsed">
                            <!-- Keyboard visualizer -->
                            <controls:KeyboardVisualizerControl x:Name="_visualizer"
                                                                Margin="0,8,0,8" />

                            <!-- Action row -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <ui:Button x:Name="_selectAllBtn"
                                               Appearance="Transparent"
                                               Content="Select All"
                                               Click="SelectAll_Click"
                                               Margin="0,0,8,0" />
                                    <ui:Button x:Name="_clearSelectBtn"
                                               Appearance="Transparent"
                                               Content="Clear Selection"
                                               Click="ClearSelection_Click"
                                               Margin="0,0,8,0" />
                                    <ui:Button x:Name="_fillAllBtn"
                                               Appearance="Transparent"
                                               Content="Fill All"
                                               Click="FillAll_Click" />
                                </StackPanel>

                                <controls:ColorPickerControl x:Name="_colorPicker"
                                                             Grid.Column="1"
                                                             Margin="0,0,12,0"
                                                             SelectedColor="Black" />

                                <ui:Button x:Name="_applyBtn"
                                           Grid.Column="2"
                                           Appearance="Primary"
                                           Content="Apply"
                                           Click="Apply_Click" />
                            </Grid>

                            <!-- Status -->
                            <TextBlock x:Name="_statusText"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Select keys to edit their color."
                                       Margin="0,0,0,8" />
                        </StackPanel>

                        <!-- Idle Timer (common to both modes) -->
                        <ui:CardExpander Header="Idle Timer"
                                        IsExpanded="False"
                                        Margin="0,8,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontWeight="DemiBold" Text="Auto Turn Off" />
                                        <TextBlock FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="Automatically turn off the keyboard backlight after a period of inactivity." />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="tsIdleTimer"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    Checked="TsIdleTimer_Toggled"
                                                    Unchecked="TsIdleTimer_Toggled" />
                                </Grid>

                                <Grid x:Name="IdleTimerDurationRow"
                                      Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontWeight="DemiBold" Text="Timeout" />
                                        <TextBlock FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="Time of inactivity before the keyboard turns off." />
                                    </StackPanel>
                                    <ComboBox x:Name="cmbIdleTimer"
                                              Grid.Column="1"
                                              Width="130"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              SelectedIndex="9"
                                              SelectionChanged="CmbIdleTimer_SelectionChanged" />
                                </Grid>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>

                    <!-- Lightbar content (placeholder) -->
                    <StackPanel x:Name="LightbarContent" Visibility="Collapsed">
                        <Border Margin="0,8,0,0"
                                Padding="14,12"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlFillColorSecondaryBrush}"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Grid.Column="0"
                                             FontFamily="Segoe Fluent Icons"
                                             Glyph="&#xECAA;"
                                             FontSize="16"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="Lightbar RGB control is not yet implemented."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
