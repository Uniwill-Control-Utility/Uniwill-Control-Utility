<Page x:Class="Universal_x86_Tuning_Utility.Views.Pages.Watercooler"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Watercooler Control"
    Unloaded="Page_Unloaded"
    ScrollViewer.CanContentScroll="False">

    <Grid>
        <!-- Content -->
        <ScrollViewer x:Name="PageScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      IsDeferredScrollingEnabled="False">
            <StackPanel Margin="24">

            <!-- Header -->
            <TextBlock x:Name="tbPageTitle"
                Text="LCT Watercooler Control"
                FontSize="20" FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Margin="0,0,0,16"/>

            <!-- Device Status Card -->
            <ui:CardControl Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column 1: Device image with glow -->
                        <StackPanel Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="16">
                            <Grid Margin="0,0,0,12">
                                <!-- Colored glow layer behind -->
                                <Rectangle x:Name="rectGlowOverlay"
                                           Width="165"
                                           Height="140"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Fill="#007ACC"
                                           Opacity="0"
                                           RenderOptions.EdgeMode="Unspecified"
                                           Margin="0,12,0,12">
                                    <Rectangle.Effect>
                                        <BlurEffect Radius="60"/>
                                    </Rectangle.Effect>
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://application:,,,/Assets/HydroUI/mk2.png"
                                                    Stretch="Fill" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <!-- Sharp original image on top -->
                                <Image x:Name="imgDevice"
                                       Width="320"
                                       Height="140"
                                       Stretch="Uniform"
                                       Source="pack://application:,,,/Assets/HydroUI/mk2.png" />
                            </Grid>
                        </StackPanel>

                        <!-- Column 2: Status + action -->
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <!-- Connected state -->
                            <StackPanel x:Name="spConnectedState" Visibility="Collapsed">
                                <ui:SymbolIcon Symbol="CheckmarkCircle48"
                                               Foreground="Green"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>
                                <TextBlock Text="Connected"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,16"/>
                                <Button x:Name="btnDisconnect"
                                        Content="Disconnect"
                                        Width="140"
                                        Click="btnDisconnect_Click"/>
                            </StackPanel>

                            <!-- Disconnected state -->
                            <StackPanel x:Name="spDisconnectedState">
                                <ui:SymbolIcon Symbol="DismissCircle48"
                                               Foreground="Red"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>
                                <TextBlock Text="Disconnected"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,16"/>

                                <!-- Device discovery row -->
                                <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="cbxDevices" Grid.Column="0" Margin="0,0,8,0" MinWidth="200" SelectionChanged="cbxDevices_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text=" (" Margin="6,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding Address}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text=")" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="  RSSI: " Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <TextBlock Text="{Binding Rssi}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button x:Name="btnScan" Grid.Column="1" Content="Scan" Width="80" Click="btnScan_Click"/>
                                </Grid>

                                <Button x:Name="btnConnect"
                                        Content="Connect"
                                        Width="140"
                                        Click="btnConnect_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!-- Controls (hidden until connected) -->
            <StackPanel x:Name="spControls" Visibility="Collapsed">

            <!-- Pump Control -->
            <ui:CardControl Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" Margin="0,0,8,0"/>
                        <TextBlock Text="Pump Voltage"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel HorizontalAlignment="Right">
                    <ComboBox x:Name="cbxPumpVoltage" MinWidth="160" SelectionChanged="cbxPumpVoltage_SelectionChanged">
                        <ComboBoxItem Content="Off"/>
                        <ComboBoxItem Content="7V"/>
                        <ComboBoxItem Content="8V"/>
                        <ComboBoxItem Content="11V"/>
                    </ComboBox>
                    <TextBlock Text="Select pump voltage level. Higher voltage = more cooling."
                        FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </ui:CardControl>

            <!-- Fan Control -->
            <ui:CardControl Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="RotateLeft24" Margin="0,0,8,0"/>
                        <TextBlock Text="Fan Speed"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel HorizontalAlignment="Right">
                    <ComboBox x:Name="cbxFanSpeed" MinWidth="160" SelectionChanged="cbxFanSpeed_SelectionChanged">
                        <ComboBoxItem Content="Off"/>
                        <ComboBoxItem Content="25%"/>
                        <ComboBoxItem Content="50%"/>
                        <ComboBoxItem Content="75%"/>
                        <ComboBoxItem Content="90%"/>
                        <ComboBoxItem Content="95%"/>
                        <ComboBoxItem Content="100%"/>
                    </ComboBox>
                    <TextBlock Text="Select fan duty cycle. Higher = more airflow, more noise."
                        FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </ui:CardControl>

            <!-- RGB Control -->
            <ui:CardControl Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Color24" Margin="0,0,8,0"/>
                        <TextBlock Text="RGB Lighting"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="cbxRgbMode" MinWidth="160" SelectionChanged="cbxRgbMode_SelectionChanged">
                            <ComboBoxItem Content="Off"/>
                            <ComboBoxItem Content="Static"/>
                            <ComboBoxItem Content="Breathe"/>
                            <ComboBoxItem Content="Colorful"/>
                            <ComboBoxItem Content="Breathe Color"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Color:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="cbxRgbColor" MinWidth="160" SelectionChanged="cbxRgbColor_SelectionChanged">
                            <ComboBoxItem Content="Red"/>
                            <ComboBoxItem Content="Green"/>
                            <ComboBoxItem Content="Blue"/>
                            <ComboBoxItem Content="White"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </ui:CardControl>

            <!-- Settings -->
            <ui:CardControl Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" Margin="0,0,8,0"/>
                        <TextBlock Text="Settings"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:ToggleSwitch x:Name="tsAutoConnect" Margin="0,0,9,0" Checked="tsAutoConnect_Checked" Unchecked="tsAutoConnect_Unchecked"/>
                    <TextBlock Text="Auto-connect on startup" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:CardControl>

        </StackPanel>

    </StackPanel>
        </ScrollViewer>

        <!-- Dark overlay to block input when Adaptive Mode override is active -->
        <Grid x:Name="overlayAdaptiveWarning"
              Visibility="Collapsed"
              Background="Black"
              Opacity="0.4"
              IsHitTestVisible="True" />

        <!-- SnackbarPresenter for Adaptive Mode override warning -->
        <ui:SnackbarPresenter x:Name="SnackbarPresenter"
                              Margin="12"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom" />
    </Grid>
</Page>
