<Page x:Class="Universal_x86_Tuning_Utility.Views.Pages.CpuTempLimit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Universal_x86_Tuning_Utility.Views.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="650" d:DesignWidth="900"
      Title="CPU Temp Limit"
      Loaded="Page_Loaded"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True"
      ScrollViewer.CanContentScroll="False">

    <!-- Root Grid with two rows: scrollable content + bottom bar -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Full-width, full-height ScrollViewer -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      IsDeferredScrollingEnabled="False">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ScrollViewer.Style>

            <!-- Centered max-width layout container -->
            <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Page title block -->
                <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,24,0,0">
                    <TextBlock FontSize="26"
                               FontWeight="Medium"
                               Margin="36,0,36,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="CPU Temp Limit" />
                    <TextBlock Margin="36,8,36,12"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Set the CPU temperature threshold for thermal throttling."
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Row 1: Content cards -->
                <StackPanel Grid.Row="1" Margin="36,16,36,18">

                    <!-- Unavailable state -->
                    <ui:CardControl x:Name="CpuTempUnavailable" Visibility="Collapsed" Margin="0,0,0,8">
                        <ui:CardControl.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7BA;" FontSize="20" Margin="4,0,6,0" />
                        </ui:CardControl.Icon>
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="EC hardware not available" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="The Uniwill EC controller was not detected on this device. CPU temperature limit control is unavailable." />
                            </StackPanel>
                        </ui:CardControl.Header>
                    </ui:CardControl>

                    <!-- Available content -->
                    <StackPanel x:Name="CpuTempAvailable">

                        <!-- CPU Temp Limit Card -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9D4;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="CPU Temp Limit" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Lower values trigger thermal throttling earlier, protecting the CPU at the cost of performance." />
                                </StackPanel>
                            </ui:CardControl.Header>

                            <StackPanel Margin="16,8,16,0">
                                <!-- Temperature value display -->
                                <TextBlock x:Name="tbTempValue"
                                           FontSize="48"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,16"
                                           Text="95 °C" />

                                <!-- Slider -->
                                <Slider x:Name="sliderTempLimit"
                                        Minimum="80"
                                        Maximum="95"
                                        Value="95"
                                        TickFrequency="1"
                                        TickPlacement="BottomRight"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="sliderTempLimit_ValueChanged" />
                            </StackPanel>
                        </ui:CardControl>

                        <!-- EC Readback Card -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9D6;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="EC Readback" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Current value read from EC register 0x0463." />
                                </StackPanel>
                            </ui:CardControl.Header>

                            <StackPanel Margin="16,8,16,0">
                                <!-- Raw register value -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="Raw value" />
                                    <TextBlock x:Name="tbRawValue"
                                               Grid.Column="1"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="0x00" />
                                </Grid>

                                <!-- Decoded temperature -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="Decoded temperature" />
                                    <TextBlock x:Name="tbDecodedTemp"
                                               Grid.Column="1"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="-- °C" />
                                </Grid>
                            </StackPanel>
                        </ui:CardControl>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Row 1: Bottom action bar -->
        <Border Grid.Row="1"
                Padding="36,12"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                Opacity="0.6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="tbStatus"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Ready" />
                <ui:Button x:Name="btnApply"
                           Grid.Column="1"
                           Appearance="Primary"
                           Content="Apply"
                           Click="btnApply_Click" />
            </Grid>
        </Border>
    </Grid>
</Page>
