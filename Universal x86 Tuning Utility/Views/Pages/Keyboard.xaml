<Page x:Class="Universal_x86_Tuning_Utility.Views.Pages.Keyboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Universal_x86_Tuning_Utility.Views.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Universal_x86_Tuning_Utility.Views.Controls"
      d:DataContext="{d:DesignInstance local:Keyboard, IsDesignTimeCreatable=False}"
      d:Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d"
      d:DesignHeight="620"
      d:DesignWidth="800"
      Title="Keyboard"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True"
      ScrollViewer.CanContentScroll="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      IsDeferredScrollingEnabled="False"
                      Margin="0,0,-18,0">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}"
                       BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Padding" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, RelativeSource={RelativeSource Self}}"
                                     Value="Visible">
                            <Setter Property="Padding" Value="0,0,8,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel Margin="18,10,36,18">
                <TextBlock FontSize="26" FontWeight="Medium" Text="Keyboard" />
                <TextBlock Margin="0,4,0,12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Customize your keyboard backlight color and brightness."
                           TextWrapping="Wrap" />

                <!-- Content when HID keyboard controller is available -->
                <StackPanel x:Name="KeyboardAvailable">
                    <!-- Keyboard power toggle -->
                    <ui:CardControl Margin="0,8,0,0">
                        <ui:CardControl.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:FontIcon Grid.Column="0"
                                             FontFamily="Segoe Fluent Icons"
                                             Glyph="&#xE786;"
                                             FontSize="20"
                                             Margin="0,0,12,0"
                                             VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="DemiBold" Text="Keyboard Backlight" />
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="Turn the keyboard backlight on or off." />
                                </StackPanel>

                                <ui:ToggleSwitch x:Name="tsKeyboardPower"
                                                 Grid.Column="2"
                                                 Margin="0,0,9,0"
                                                 IsChecked="True"
                                                 Checked="TsKeyboardPower_Toggled"
                                                 Unchecked="TsKeyboardPower_Toggled" />
                            </Grid>
                        </ui:CardControl.Header>
                    </ui:CardControl>

                    <!-- Effect card with all controls -->
                    <ui:CardExpander Margin="0,8,0,0"
                                    Header="Effect"
                                    IsExpanded="True">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE775;" FontSize="20" />
                        </ui:CardExpander.Icon>
                        <StackPanel>
                            <!-- Effect type -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="DemiBold" Text="Type" />
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="Choose an animation effect." />
                                </StackPanel>
                                <ComboBox x:Name="cmbEffect"
                                          Grid.Column="1"
                                          Width="180"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          SelectionChanged="CmbEffect_SelectionChanged" />
                            </Grid>

                            <Separator Margin="0,12,0,12"
                                       Background="{DynamicResource ControlFillColorDefaultBrush}" />

                            <!-- Color (visible for single-color effects) -->
                            <Grid x:Name="ColorRow"
                                  Visibility="Visible">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="DemiBold" Text="Color" />
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="Single color for Static mode." />
                                </StackPanel>
                                <controls:ColorPickerControl x:Name="ColorPicker"
                                                             Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             VerticalAlignment="Center"
                                                             SelectedColor="Aqua"
                                                             ColorChangedDelayed="ColorPicker_ColorChangedDelayed" />
                            </Grid>

                            <!-- Multi-color picker (visible for multi-color effects) -->
                            <Grid x:Name="MultiColorRow"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="DemiBold"
                                               x:Name="MultiColorTitle"
                                               Text="Effect Colors" />
                                    <TextBlock FontSize="12"
                                               x:Name="MultiColorSubtitle"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="7 colors required for this effect. Click a swatch to edit." />
                                </StackPanel>
                                <controls:KeyboardMultiColorPickerControl x:Name="MultiColorPicker"
                                                                          Grid.Column="1"
                                                                          HorizontalAlignment="Right"
                                                                          VerticalAlignment="Center"
                                                                          ColorsChanged="MultiColorPicker_ColorsChanged" />
                            </Grid>

                            <!-- Rest color picker for GamingModeFull -->
                            <Grid x:Name="GamingModeFullRestRow"
                                  Visibility="Collapsed"
                                  Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="DemiBold"
                                               Text="Rest of Keyboard" />
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="Color for non-WASD/arrow keys." />
                                </StackPanel>
                                <controls:ColorPickerControl x:Name="GamingModeFullRestColor"
                                                             Grid.Column="1"
                                                             HorizontalAlignment="Right"
                                                             VerticalAlignment="Center"
                                                             SelectedColor="White"
                                                             ColorChangedDelayed="GamingModeFullRestColor_ColorChangedDelayed" />
                            </Grid>

                            <Separator Margin="0,12,0,12"
                                       Background="{DynamicResource ControlFillColorDefaultBrush}" />

                            <!-- Brightness -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="DemiBold" Text="Brightness" />
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="Adjust the backlight brightness level." />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="BrightnessValueText"
                                               Width="30"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,12,0"
                                               Text="5" />
                                    <Slider x:Name="BrightnessSlider"
                                            Width="140"
                                            Minimum="1"
                                            Maximum="7"
                                            Value="5"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="1"
                                            IsMoveToPointEnabled="False"
                                            ValueChanged="BrightnessSlider_ValueChanged" />
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,12,0,12"
                                       Background="{DynamicResource ControlFillColorDefaultBrush}" />

                            <!-- Speed (visible for animated effects) -->
                            <Grid x:Name="SpeedRow"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="DemiBold" Text="Speed" />
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="Control the animation speed." />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="SpeedValueText"
                                               Width="30"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,12,0"
                                               Text="5" />
                                    <Slider x:Name="SpeedSlider"
                                            Width="140"
                                            Minimum="1"
                                            Maximum="10"
                                            Value="5"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="1"
                                            IsMoveToPointEnabled="False"
                                            ValueChanged="SpeedSlider_ValueChanged" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Idle Timer -->
                    <ui:CardExpander Header="Idle Timer"
                                    IsExpanded="False"
                                    Margin="0,8,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="DemiBold" Text="Auto Turn Off" />
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="Automatically turn off the keyboard backlight after a period of inactivity." />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="tsIdleTimer"
                                              Grid.Column="1"
                                              HorizontalAlignment="Right"
                                              Checked="TsIdleTimer_Toggled"
                                              Unchecked="TsIdleTimer_Toggled" />
                            </Grid>

                            <Grid x:Name="IdleTimerDurationRow"
                                  Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="DemiBold" Text="Timeout" />
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="Time of inactivity before the keyboard turns off." />
                                </StackPanel>
                                <ComboBox x:Name="cmbIdleTimer"
                                          Grid.Column="1"
                                          Width="130"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          SelectedIndex="9"
                                          SelectionChanged="CmbIdleTimer_SelectionChanged" />
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Diagnostic (collapsed by default) -->
                    <ui:CardExpander x:Name="DiagnosticExpander"
                                     Margin="0,8,0,0"
                                     Header="Keyboard Diagnostics"
                                     IsExpanded="False">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9B3;" FontSize="16" />
                        </ui:CardExpander.Icon>
                        <StackPanel>
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="EC register dump and HID feature report reader. Use this to reverse-engineer effects by comparing values before and after changing settings in XMG Control Center."
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />

                            <!-- EC Register Dump -->
                            <TextBlock FontWeight="SemiBold"
                                       FontSize="12"
                                       Text="EC Registers"
                                       Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtEcDump"
                                         Grid.Column="0"
                                         Height="180"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         IsReadOnly="True"
                                         TextWrapping="NoWrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,0,8,0"
                                         Padding="6,4" />
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Top">
                                    <ui:Button Appearance="Transparent"
                                                Click="BtnRefreshEcDump_Click"
                                                Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" Margin="0,0,4,0" />
                                            <TextBlock Text="Refresh" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Appearance="Transparent"
                                                Click="BtnCopyEcDump_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" Margin="0,0,4,0" />
                                            <TextBlock Text="Copy" />
                                        </StackPanel>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>

                            <!-- HID Feature Report Reader -->
                            <TextBlock FontWeight="SemiBold"
                                       FontSize="12"
                                       Text="HID Feature Reports"
                                       Margin="0,12,0,4" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="Try reading feature reports by report ID to discover current HID controller state."
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtHidDump"
                                         Grid.Column="0"
                                         Height="140"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         IsReadOnly="True"
                                         TextWrapping="NoWrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,0,8,0"
                                         Padding="6,4" />
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Top">
                                    <ui:Button Appearance="Transparent"
                                                Click="BtnScanHidReports_Click"
                                                Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEDA2;" Margin="0,0,4,0" />
                                            <TextBlock Text="Scan IDs" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Appearance="Transparent"
                                                Click="BtnCopyHidDump_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" Margin="0,0,4,0" />
                                            <TextBlock Text="Copy" />
                                        </StackPanel>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>

                            <!-- Raw Report Sender -->
                            <TextBlock FontWeight="SemiBold"
                                       FontSize="12"
                                       Text="Raw Report Sender"
                                       Margin="0,12,0,4" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="Send a raw 9-byte HID feature report. Enter bytes as hex separated by spaces. Known commands: 0x08=MODE_BRIGHTNESS, 0x14=SET_COLOR, 0x1A=ZONE_ON_OFF, 0x09=KEYBOARD_OFF, 0x12=ZONE_RESET. byte[4] in 0x08 reports encodes effect mode (01=static, others unknown)."
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtRawReport"
                                         Grid.Column="0"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Padding="6,4"
                                         Margin="0,0,8,0"
                                         Text="00 08 02 01 01 64 08 00 00" />
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Top">
                                    <ui:Button Appearance="Primary"
                                                Click="BtnSendRawReport_Click"
                                                Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE724;" Margin="0,0,4,0" />
                                            <TextBlock Text="Send" />
                                        </StackPanel>
                                    </ui:Button>
                                    <TextBlock x:Name="txtRawResult"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Quick Effect Tester -->
                            <TextBlock FontWeight="SemiBold"
                                       FontSize="12"
                                       Text="Quick Effect Tester"
                                       Margin="0,12,0,4" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="Cycle through effect mode values (byte[4]) in CMD_MODE_BRIGHTNESS reports. 0x01=Static (known). Use slider or keyboard arrows to step. Auto-applies on change."
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="EffectModeLabel"
                                           Grid.Column="0"
                                           FontFamily="Consolas"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"
                                           Text="0x01" />
                                <Slider x:Name="EffectModeSlider"
                                        Grid.Column="1"
                                        Minimum="0"
                                        Maximum="255"
                                        Value="1"
                                        IsSnapToTickEnabled="True"
                                        TickFrequency="1"
                                        VerticalAlignment="Center"
                                        ValueChanged="EffectModeSlider_ValueChanged" />
                                <TextBlock x:Name="txtEffectResult"
                                           Grid.Column="2"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <!-- Speed Byte Tester -->
                            <TextBlock FontWeight="SemiBold"
                                       FontSize="12"
                                       Text="Speed Byte Tester"
                                       Margin="0,12,0,4" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="Try different byte positions for speed control. XMG CC uses save_speed 1-10 (inverted: UI 0=10, UI 4=1). Select a byte position, pick a speed value, and send. Use an animated effect (Wave=0x03) to see if speed changes. Auto-applies on change."
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4" />
                            <StackPanel>
                                <!-- Byte position selector -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Byte position:"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                    <ComboBox x:Name="cmbSpeedBytePos"
                                              HorizontalAlignment="Left"
                                              Width="200"
                                              SelectionChanged="SpeedBytePos_SelectionChanged"
                                              VerticalAlignment="Center" />
                                </Grid>
                                <!-- Speed value slider -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Speed value:"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                    <Slider x:Name="SpeedTestSlider"
                                            Grid.Column="1"
                                            Minimum="0"
                                            Maximum="15"
                                            Value="8"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="1"
                                            VerticalAlignment="Center"
                                            ValueChanged="SpeedTestSlider_ValueChanged" />
                                    <TextBlock x:Name="SpeedTestValueLabel"
                                               Grid.Column="2"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               Text="8" />
                                </Grid>
                                <!-- Report preview -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Report preview:"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"
                                               FontSize="11" />
                                    <TextBlock x:Name="SpeedTestReportPreview"
                                               Grid.Column="1"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- White keyboard notice -->
                    <Border x:Name="WhiteKeyboardNotice"
                            Margin="0,8,0,0"
                            Padding="14,12"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="4"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Grid.Column="0"
                                         FontFamily="Segoe Fluent Icons"
                                         Glyph="&#xE946;"
                                         FontSize="16"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Your keyboard has white backlight only. Color and effect options are not available, but you can still adjust the brightness."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Content when Uniwill EC is NOT available -->
                <StackPanel x:Name="KeyboardUnavailable" Visibility="Collapsed">
                    <Border Margin="0,8,0,0"
                            Padding="14,12"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Grid.Column="0"
                                         FontFamily="Segoe Fluent Icons"
                                         Glyph="&#xE7A7;"
                                         FontSize="16"
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Keyboard control is not available on this device. This feature requires an ITE HID lighting controller (vid_048d)."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
