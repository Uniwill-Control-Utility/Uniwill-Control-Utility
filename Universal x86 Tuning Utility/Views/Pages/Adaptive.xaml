                                        <ComboBoxItem>Full Speed</ComboBoxItem>
                                        <ComboBoxItem>Off</ComboBoxItem>
                                        <ComboBoxItem>Custom</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4">GPU Fan Curve</TextBlock>
                                    <ComboBox Name="cbxEcFanGpuPreset" MinWidth="160" Height="37" SelectedIndex="1">
                                        <ComboBoxItem>Silent</ComboBoxItem>
                                        <ComboBoxItem>Balanced</ComboBoxItem>
                                        <ComboBoxItem>Performance</ComboBoxItem>
                                        <ComboBoxItem>Full Speed</ComboBoxItem>
                                        <ComboBoxItem>Off</ComboBoxItem>
                                        <ComboBoxItem>Custom</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">Notes: Custom curves are saved per-game and applied automatically when this profile is active.</TextBlock>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Keyboard RGB - per-game keyboard backlight control -->
                    <ui:CardExpander Name="sdKeyboard"
                        IsEnabled="True"
                        IsExpanded="False"
                        Margin="0,8,15,0">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE92E;" FontSize="20" Margin="4,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Medium"
                                        Text="Keyboard RGB" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="Per-game keyboard backlight control for ITE HID keyboards."/>
                                </StackPanel>
                                <ui:ToggleSwitch Name="cbxKbEnabled" Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,0,9,0"
                                    LabelPosition="Left"
                                    OnContent="On"
                                    OffContent="Off"
                                    ToolTip="Enable keyboard RGB controls for this game"
                                    Checked="cbxKbEnabled_Toggled"
                                    Unchecked="cbxKbEnabled_Toggled" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <!-- Mode: Effects / Per-Key -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="DemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}">Mode</TextBlock>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Choose between animation effects or per-key color control." />
                                </StackPanel>
                                <ComboBox Name="cbxKbMode" Grid.Column="1" MinWidth="160" HorizontalAlignment="Right" VerticalAlignment="Center" Height="37" SelectedIndex="0" SelectionChanged="cbxKbMode_SelectionChanged">
                                    <ComboBoxItem>Effects</ComboBoxItem>
                                    <ComboBoxItem>Per-Key RGB</ComboBoxItem>
                                </ComboBox>
                            </Grid>

                            <!-- Effect controls (visible in Effects mode) -->
                            <StackPanel Name="spKbEffectControls" Visibility="Collapsed">
                                <!-- Divider before Effect -->
                                <Separator Name="sepKbEffect" Margin="0,12,0,12"
                                           Background="{DynamicResource ControlFillColorDefaultBrush}" />

                                <!-- Effect Type -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontWeight="DemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}">Effect</TextBlock>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Choose an animation effect." />
                                    </StackPanel>
                                    <ComboBox Name="cbxKbEffect" Grid.Column="1" MinWidth="180" HorizontalAlignment="Right" VerticalAlignment="Center" Height="37" SelectedIndex="0" SelectionChanged="cbxKbEffect_SelectionChanged">
                                        <ComboBoxItem>Static</ComboBoxItem>
                                        <ComboBoxItem>Breathing</ComboBoxItem>
                                        <ComboBoxItem>Wave</ComboBoxItem>
                                        <ComboBoxItem>Reactive</ComboBoxItem>
                                        <ComboBoxItem>Rainbow</ComboBoxItem>
                                        <ComboBoxItem>Ripple</ComboBoxItem>
                                        <ComboBoxItem>Touch Ripple</ComboBoxItem>
                                        <ComboBoxItem>Marquee</ComboBoxItem>
                                        <ComboBoxItem>Raindrop</ComboBoxItem>
                                        <ComboBoxItem>Aurora</ComboBoxItem>
                                        <ComboBoxItem>Touch Aurora</ComboBoxItem>
                                        <ComboBoxItem>Touch Spark</ComboBoxItem>
                                        <ComboBoxItem>Spark</ComboBoxItem>
                                        <ComboBoxItem>Gaming Mode</ComboBoxItem>
                                        <ComboBoxItem>Gaming Mode Full</ComboBoxItem>
                                        <ComboBoxItem>Music</ComboBoxItem>
                                    </ComboBox>
                                </Grid>

                                <!-- Divider before Color -->
                                <Separator Name="sepKbColor" Margin="0,12,0,12"
                                           Background="{DynamicResource ControlFillColorDefaultBrush}" />

                                <!-- Color (visible for single-color effects) -->
                                <Grid Name="spKbColor" Visibility="Visible">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontWeight="DemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}">Color</TextBlock>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Single color for static and single-color effects." />
                                    </StackPanel>
                                    <controls:ColorPickerControl x:Name="KbColorPicker" Grid.Column="1"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Center"
                                                                     SelectedColor="Aqua"
                                                                     ColorChangedDelayed="KbColorPicker_ColorChangedDelayed" />
                                </Grid>

                                <!-- Multi-color picker (visible for multi-color effects) — shares sepKbColor -->
                                <Grid Name="spKbMultiColor" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontWeight="DemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Name="tbKbMultiColorTitle">Effect Colors</TextBlock>
                                        <TextBlock x:Name="tbKbMultiColorSubtitle" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="7 colors required for this effect." />
                                    </StackPanel>
                                    <controls:KeyboardMultiColorPickerControl x:Name="KbMultiColorPicker" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" ColorsChanged="KbMultiColorPicker_ColorsChanged"/>
                                </Grid>

                                <!-- Rest color for GamingModeFull — shares sepKbColor -->
                                <Grid Name="spKbGamingRest" Visibility="Collapsed" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontWeight="DemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}">Rest of Keyboard</TextBlock>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Color for non-WASD/arrow keys." />
                                    </StackPanel>
                                    <controls:ColorPickerControl x:Name="KbRestColorPicker" Grid.Column="1"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Center"
                                                                     SelectedColor="White"
                                                                     ColorChangedDelayed="KbRestColorPicker_ColorChangedDelayed" />
                                </Grid>

                                <!-- Divider before Direction -->
                                <Separator Name="sepKbDirection" Margin="0,12,0,12"
                                           Background="{DynamicResource ControlFillColorDefaultBrush}"
                                           Visibility="Collapsed" />

                                <!-- Direction (Wave only) -->
                                <Grid Name="grKbDirection" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontWeight="DemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}">Direction</TextBlock>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Animation direction for Wave effect." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <ui:Button x:Name="btnKbDirLeftRight" Width="40" Height="36" Margin="0,0,4,0"
                                                           Appearance="Transparent" Click="KbDirectionButton_Click" Tag="LeftRight">
                                                    <TextBlock Text="→" FontSize="18" HorizontalAlignment="Center"/>
                                                </ui:Button>
                                                <ui:Button x:Name="btnKbDirRightLeft" Width="40" Height="36" Margin="0,0,4,0"
                                                           Appearance="Transparent" Click="KbDirectionButton_Click" Tag="RightLeft">
                                                    <TextBlock Text="←" FontSize="18" HorizontalAlignment="Center"/>
                                                </ui:Button>
                                                <ui:Button x:Name="btnKbDirDownUp" Width="40" Height="36" Margin="0,0,4,0"
                                                           Appearance="Transparent" Click="KbDirectionButton_Click" Tag="DownUp">
                                                    <TextBlock Text="↑" FontSize="18" HorizontalAlignment="Center"/>
                                                </ui:Button>
                                                <ui:Button x:Name="btnKbDirUpDown" Width="40" Height="36" Margin="0,0,4,0"
                                                           Appearance="Transparent" Click="KbDirectionButton_Click" Tag="UpDown">
                                                    <TextBlock Text="↓" FontSize="18" HorizontalAlignment="Center"/>
                                                </ui:Button>
                                                <ui:Button x:Name="btnKbDiagBRTL" Width="40" Height="36" Margin="0,0,4,0"
                                                           Appearance="Transparent" Click="KbDirectionButton_Click" Tag="DiagonalBottomRightToTopLeft">
                                                    <TextBlock Text="↖" FontSize="18" HorizontalAlignment="Center"/>
                                                </ui:Button>
                                                <ui:Button x:Name="btnKbDiagBLTR" Width="40" Height="36" Margin="0,0,0,0"
                                                           Appearance="Transparent" Click="KbDirectionButton_Click" Tag="DiagonalBottomLeftToTopRight">
                                                    <TextBlock Text="↗" FontSize="18" HorizontalAlignment="Center"/>
                                                </ui:Button>
                                            </StackPanel>
                                </Grid>

                                <!-- Divider before Brightness -->
                                <Separator Name="sepKbBrightness" Margin="0,12,0,12"
                                           Background="{DynamicResource ControlFillColorDefaultBrush}" />

                                <!-- Brightness -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontWeight="DemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}">Brightness</TextBlock>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Backlight brightness level 1-7." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Name="tbKbBrightnessValue" Width="30" HorizontalAlignment="Right" Margin="0,0,12,0" Text="5" />
                                        <Slider Name="sdKbBrightness" Width="140" Maximum="7" Minimum="1" TickFrequency="1" TickPlacement="Both" IsSnapToTickEnabled="True" Value="5" IsMoveToPointEnabled="False" ValueChanged="sdKbBrightness_ValueChanged"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Divider before Speed -->
                                <Separator Name="sepKbSpeed" Margin="0,12,0,12"
                                           Background="{DynamicResource ControlFillColorDefaultBrush}"
                                           Visibility="Collapsed" />

                                <!-- Speed (hidden for Static, Rainbow, GamingMode, GamingModeFull) -->
                                <Grid Name="spKbSpeed" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontWeight="DemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}">Speed</TextBlock>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Animation speed (1=fastest, 10=slowest)." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Name="tbKbSpeedValue" Width="30" HorizontalAlignment="Right" Margin="0,0,12,0" Text="5" />
                                        <Slider Name="sdKbSpeed" Width="140" Maximum="10" Minimum="1" TickFrequency="1" TickPlacement="Both" IsSnapToTickEnabled="True" Value="5" IsMoveToPointEnabled="False" ValueChanged="sdKbSpeed_ValueChanged"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Per-Key controls (visible in Per-Key mode) -->
                            <StackPanel Name="spKbPerKeyNote" Visibility="Collapsed" Margin="0,8,0,0">
                                <Border Padding="12" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="Per-Key RGB Mode" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                                        <TextBlock Text="Configure individual key colors for this profile." Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <ui:Button Name="btnKbEditPerKey"
                                                   Appearance="Primary"
                                                   Content="Edit Per-Key Colors"
                                                   HorizontalAlignment="Left"
                                                   Click="btnKbEditPerKey_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Light Bar - only visible on supported hardware -->
                    <ui:CardExpander x:Name="sdLightBar"
                                    Visibility="Collapsed"
                                    IsEnabled="True"
                                    IsExpanded="False"
                                    Margin="0,8,15,0">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xED39;" FontSize="20" Margin="4,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Light Bar" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Per-game front light bar control."
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ui:ToggleSwitch x:Name="cbxLbEnabled"
                                                     Margin="0,0,9,0"
                                                     LabelPosition="Left"
                                                     OnContent="On"
                                                     OffContent="Off"
                                                     ToolTip="Enable Light Bar controls for this game"
                                                     Checked="cbxLbEnabled_Toggled"
                                                     Unchecked="cbxLbEnabled_Toggled" />
                                </StackPanel>
                            </Grid>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <!-- Light Bar Power -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Power" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Turn the front light bar on or off." />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="AdpTsLightBarPower"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 IsChecked="True"
                                                 Checked="AdpTsLightBarPower_Toggled"
                                                 Unchecked="AdpTsLightBarPower_Toggled" />
                            </Grid>
                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                            <!-- Color -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Color" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Choose the light bar color." />
                                </StackPanel>
                                <controls:ColorPickerControl x:Name="AdpLbColorPicker"
                                                             HorizontalAlignment="Right"
                                                             VerticalAlignment="Center"
                                                             SelectedColor="Aqua"
                                                             ColorChangedDelayed="AdpLbColorPicker_ColorChangedDelayed" />
                            </Grid>
                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                            <!-- Brightness -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Brightness" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Adjust the light bar brightness level." />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="AdpLbBrightnessValueText"
                                               Width="35"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="100" />
                                    <Slider x:Name="AdpLbBrightnessSlider"
                                            Width="140"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="100"
                                            TickFrequency="10"
                                            IsSnapToTickEnabled="True"
                                            IsMoveToPointEnabled="False"
                                            TickPlacement="Both"
                                            ValueChanged="AdpLbBrightnessSlider_ValueChanged" />
                                </StackPanel>
                            </Grid>
                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                            <!-- Effect selector -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Effect" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Select a lighting effect for the light bar." />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <ComboBox x:Name="AdpLbEffect"
                                              Width="180"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              SelectedIndex="0"
                                              SelectionChanged="AdpLbEffect_SelectionChanged">
                                        <ComboBoxItem>Static</ComboBoxItem>
                                        <ComboBoxItem>Breathing</ComboBoxItem>
                                        <ComboBoxItem>Wave</ComboBoxItem>
                                        <ComboBoxItem>Loading</ComboBoxItem>
                                        <ComboBoxItem>Marquee</ComboBoxItem>
                                        <ComboBoxItem>Meteor</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <!-- Speed (hidden for Static) -->
                            <StackPanel x:Name="AdpSpLbSpeed" Visibility="Collapsed">
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Speed" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Control the animation speed." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="AdpLbSpeedValueText"
                                                   Width="30"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Text="5" />
                                        <Slider x:Name="AdpLbSpeedSlider"
                                                Width="140"
                                                Minimum="0"
                                                Maximum="11"
                                                Value="5"
                                                IsSnapToTickEnabled="True"
                                                IsMoveToPointEnabled="False"
                                                TickPlacement="Both"
                                                ValueChanged="AdpLbSpeedSlider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ui:CardExpander>

                    <TextBlock Name="tbLog" Margin="0,9,0,0"></TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
