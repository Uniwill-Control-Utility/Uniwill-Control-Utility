<ui:FluentWindow x:Class="Universal_x86_Tuning_Utility.Views.Windows.VfCurveEditorWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Universal_x86_Tuning_Utility.Views.Controls"
             Title="GPU Curve Editor"
             Width="780" Height="520"
             MinHeight="500" MinWidth="700"
             MaxHeight="1200" MaxWidth="800"
             ResizeMode="CanResizeWithGrip"
             WindowStartupLocation="CenterOwner"
             ExtendsContentIntoTitleBar="True"
             WindowBackdropType="Mica"
             WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <ui:TitleBar Grid.Row="0"
                     Title="GPU Curve Editor"
                     ShowMinimize="True"
                     ShowMaximize="False"
                     ShowClose="True"/>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="Drag points to adjust GPU frequency per voltage. Tab to navigate, Shift+Click for range selection."
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       FontSize="12"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap"/>

            <!-- Curve Editor -->
            <controls:VfCurveEditor x:Name="_editor" Grid.Row="1"/>

            <!-- Preset buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <ui:TextBlock Text="Preset: " VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <UniformGrid Columns="5" Rows="1" Margin="0,0,0,0">
                    <Button x:Name="btnPreset1" Content="1" Width="28" Height="24" FontSize="11" Margin="2" Click="btnPreset_Click" Tag="0" />
                    <Button x:Name="btnPreset2" Content="2" Width="28" Height="24" FontSize="11" Margin="2" Click="btnPreset_Click" Tag="1" />
                    <Button x:Name="btnPreset3" Content="3" Width="28" Height="24" FontSize="11" Margin="2" Click="btnPreset_Click" Tag="2" />
                    <Button x:Name="btnPreset4" Content="4" Width="28" Height="24" FontSize="11" Margin="2" Click="btnPreset_Click" Tag="3" />
                    <Button x:Name="btnPreset5" Content="5" Width="28" Height="24" FontSize="11" Margin="2" Click="btnPreset_Click" Tag="4" />
                </UniformGrid>
            </StackPanel>
        </Grid>

        <!-- Bottom bar -->
        <Grid Grid.Row="2" Margin="16,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Reset" Width="70" Click="btnReset_Click" Margin="0,0,8,0"
                        Style="{StaticResource DefaultButtonStyle}"/>
                <Button Content="Save" Width="70" Click="btnSave_Click" Margin="0,0,8,0"/>
                <Button Content="Cancel" Width="70" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
