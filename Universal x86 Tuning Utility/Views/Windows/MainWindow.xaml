<ui:FluentWindow x:Class="Universal_x86_Tuning_Utility.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Universal_x86_Tuning_Utility.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
      x:Name="mainWindow"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="1080"
    Height="860"
    MinWidth="1000"
    MinHeight="614"
    d:DataContext="{d:DesignInstance local:MainWindow, IsDesignTimeCreatable=True}"
    d:Background="{DynamicResource MicaBackgroundFillColorBaseBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    mc:Ignorable="d"
    Loaded="mainWindow_Loaded"
    StateChanged="UiWindow_StateChanged"
    Closing="UiWindow_Closing">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  The title bar contains window navigation elements and some Tray related extras.  -->
        <!--  You can put additional controls in the header, such as a search bar.  -->
        <ui:TitleBar
    x:Name="tbMain"
    Grid.Row="0"
    Title="Uniwill Control Utility">

            <ui:TitleBar.Resources>
                <Style TargetType="{x:Type ui:TitleBarButton}" BasedOn="{StaticResource {x:Type ui:TitleBarButton}}">
                    <!-- Force the buttons to match the height of the TitleBar -->
                    <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource AncestorType=ui:TitleBar}, Path=ActualHeight}" />
                    <!-- Ensure they stretch properly -->
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                </Style>
            </ui:TitleBar.Resources>

            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/applicationIcon-1024.png" 
                      Margin="11,0,0,0" 
                      RenderOptions.BitmapScalingMode="HighQuality"/>
            </ui:TitleBar.Icon>

            <ui:TitleBar.Header>
                <TextBlock x:Name="ModelNameText"
                   FontSize="11"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   VerticalAlignment="Center"
                   Margin="4,0,0,0"
                   Text="Uniwill Control Utility" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation"
                   Grid.Row="1"
                   FontSize="10"
                   Margin="0"
                   IsPaneOpen="False"
                   IsBackButtonVisible="Collapsed"
                   PaneDisplayMode="LeftFluent"
                   HeaderVisibility="Collapsed"
                   HorizontalContentAlignment="Center"
                   MenuItemsSource="{Binding ViewModel.NavigationItems}"
                   FooterMenuItemsSource="{Binding ViewModel.NavigationFooter}"
                   d:Background="{DynamicResource MicaBackgroundFillColorBaseBrush}">

            <ui:NavigationView.Resources>
                <DataTemplate x:Key="NavigationLabelTemplate">
                    <TextBlock Text="{Binding}"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    </TextBlock>
                </DataTemplate>

            </ui:NavigationView.Resources>
        </ui:NavigationView>

        <tray:NotifyIcon x:Name="niTray"
                         LeftClick="NotifyIcon_LeftClick"
                         FocusOnLeftClick="False"
                         Icon="pack://application:,,,/Assets/applicationIcon-256.png"
                         MenuOnRightClick="True"
                         TooltipText="Uniwill Control Utility"
                         Width="48"
                         Height="48">
            <tray:NotifyIcon.Menu>
                <ContextMenu Opened="TrayMenu_Opened">
                    <MenuItem x:Name="miPremadePresets"
                              Header="Premade Presets"
                              SubmenuOpened="TrayPremadePresets_SubmenuOpened">
                        <MenuItem x:Name="miTrayEcoPreset"
                                  Header="Eco Preset"
                                  Tag="eco"
                                  IsCheckable="True"
                                  Click="TrayPremadePreset_Click" />
                        <MenuItem x:Name="miTrayBalancedPreset"
                                  Header="Balanced Preset"
                                  Tag="balanced"
                                  IsCheckable="True"
                                  Click="TrayPremadePreset_Click" />
                        <MenuItem x:Name="miTrayPerformancePreset"
                                  Header="Performance Preset"
                                  Tag="performance"
                                  IsCheckable="True"
                                  Click="TrayPremadePreset_Click" />
                        <MenuItem x:Name="miTrayExtremePreset"
                                  Header="Extreme Preset"
                                  Tag="extreme"
                                  IsCheckable="True"
                                  Click="TrayPremadePreset_Click" />
                    </MenuItem>
                    <MenuItem x:Name="miCustomPresets"
                              Header="Custom Presets" />
                    <Separator />
                    <MenuItem x:Name="miClose"
                              Header="Close Application"
                              Tag="close"
                              Click="miClose_Click" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</ui:FluentWindow>
