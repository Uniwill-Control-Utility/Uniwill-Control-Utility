<ui:FluentWindow x:Class="Uniwill_Control_Utility.Views.Windows.TrayWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Uniwill_Control_Utility.Views.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 mc:Ignorable="d"
    Title="UCU Quick Control"
    Width="360"
    MaxHeight="540"
    MinWidth="0"
    MaxWidth="414"
    MinHeight="420"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="Manual"
    WindowCornerPreference="Round"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    d:Background="{DynamicResource MicaBackgroundFillColorBaseBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    Deactivated="Window_Deactivated"
    DpiChanged="Window_DpiChanged"
    Closed="Window_Closed"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <ui:FluentWindow.Resources>

        <!-- Metrics styles -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="HeroStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== METRICS SECTION (no card background) ===== -->
        <Border Grid.Row="0"
                Padding="12,20"
                Background="Transparent" VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU -->
                <Grid Grid.Column="0" Margin="2,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource LabelStyle}"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="CPU" 
                               FontSize="12"
                               Margin="0,0,0,8"/>

                    <!-- Hero row: Temp + Util -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="CpuTempText" Style="{StaticResource HeroStyle}"
                                       Foreground="{DynamicResource AccentTextFillColorTertiaryBrush}"
                                       Text="--°C"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <Border Grid.Column="1" Margin="0,8"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="CpuUsageText" Style="{StaticResource HeroStyle}" Text="--%" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Segmented bars -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource LabelStyle}"
                                   VerticalAlignment="Center" Text="Power" HorizontalAlignment="Center" />
                        <controls:SegmentedBar x:Name="CpuPowerBar"
                            Grid.Row="0" Grid.Column="1" Height="7" Margin="8,0"
                            Maximum="300" Segments="16"
                            Fill="{DynamicResource AccentTextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="CpuPowerText" Grid.Row="0" Grid.Column="2"
                                   Style="{StaticResource ValueStyle}" VerticalAlignment="Center"
                                   Text="-- W" HorizontalAlignment="Center" />

                        <TextBlock Grid.Row="2" Style="{StaticResource LabelStyle}"
                                   VerticalAlignment="Center" Text="Clock" HorizontalAlignment="Center" />
                        <controls:SegmentedBar x:Name="CpuClockBar"
                            Grid.Row="2" Grid.Column="1" Height="7" Margin="8,0"
                            Maximum="6000" Segments="16"
                            Fill="{DynamicResource AccentTextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="CpuClockText" Grid.Row="2" Grid.Column="2"
                                   Style="{StaticResource ValueStyle}" VerticalAlignment="Center"
                                   Text="-- GHz" HorizontalAlignment="Center" />

                        <TextBlock Grid.Row="4" Style="{StaticResource LabelStyle}"
                                   VerticalAlignment="Center" Text="Fan" HorizontalAlignment="Center" />
                        <controls:SegmentedBar x:Name="CpuFanBar"
                            Grid.Row="4" Grid.Column="1" Height="7" Margin="8,0"
                            Maximum="100" Segments="16"
                            Fill="{DynamicResource AccentTextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="CpuFanText" Grid.Row="4" Grid.Column="2"
                                   Style="{StaticResource ValueStyle}" VerticalAlignment="Center"
                                   Text="--%" HorizontalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- Vertical Divider -->
                <Border Grid.Column="1"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Margin="0,4,0,0" 
                        Opacity="0.95"
                        />

                <!-- GPU -->
                <Grid Grid.Column="2" Margin="6,0,6,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource LabelStyle}"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="GPU" 
                               FontSize="12"
                               Margin="0,0,0,8"/>

                    <!-- Hero row: Temp + Util -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="GpuTempText" Style="{StaticResource HeroStyle}"
                                       Foreground="{DynamicResource AccentTextFillColorTertiaryBrush}"
                                       Text="--°C" HorizontalAlignment="Center" />
                        </StackPanel>

                        <Border Grid.Column="1" Margin="0,8"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="GpuUsageText" Style="{StaticResource HeroStyle}" Text="--%" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Segmented bars -->
                    <Grid Grid.Row="2" Margin="2,12,2,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource LabelStyle}"
                                   VerticalAlignment="Center" Text="Power" HorizontalAlignment="Center" />
                        <controls:SegmentedBar x:Name="GpuPowerBar"
                            Grid.Row="0" Grid.Column="1" Height="7" Margin="8,0"
                            Maximum="300" Segments="16"
                            Fill="{DynamicResource AccentTextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="GpuPowerText" Grid.Row="0" Grid.Column="2"
                                   Style="{StaticResource ValueStyle}" VerticalAlignment="Center"
                                   Text="-- W" HorizontalAlignment="Center" />

                        <TextBlock Grid.Row="2" Style="{StaticResource LabelStyle}"
                                   VerticalAlignment="Center" Text="Clock" HorizontalAlignment="Center" />
                        <controls:SegmentedBar x:Name="GpuClockBar"
                            Grid.Row="2" Grid.Column="1" Height="7" Margin="8,0"
                            Maximum="3000" Segments="16"
                            Fill="{DynamicResource AccentTextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="GpuClockText" Grid.Row="2" Grid.Column="2"
                                   Style="{StaticResource ValueStyle}" VerticalAlignment="Center"
                                   Text="-- GHz" HorizontalAlignment="Center" />

                        <TextBlock Grid.Row="4" Style="{StaticResource LabelStyle}"
                                   VerticalAlignment="Center" Text="Fan" HorizontalAlignment="Center" />
                        <controls:SegmentedBar x:Name="GpuFanBar"
                            Grid.Row="4" Grid.Column="1" Height="7" Margin="8,0"
                            Maximum="100" Segments="16"
                            Fill="{DynamicResource AccentTextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="GpuFanText" Grid.Row="4" Grid.Column="2"
                                   Style="{StaticResource ValueStyle}" VerticalAlignment="Center"
                                   Text="--%" HorizontalAlignment="Center" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Divider -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceStrokeColorFlyoutBrush}" />

        <!-- ===== QUICK SETTINGS GRID (with card background) ===== -->
        <Border Grid.Row="2" Margin="-10,0,0,0"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderThickness="0"
                Padding="0,0,0,22"
                Height="330">
        <ui:NavigationView x:Name="TrayNavigation"
                           Margin="0,0,0,-20"
                           FontSize="10"
                           IsPaneVisible="False"
                           IsPaneOpen="False"
                           IsBackButtonVisible="Collapsed"
                           HeaderVisibility="Collapsed"
                           PaneDisplayMode="LeftFluent"
                           HorizontalContentAlignment="Center">
            <ui:NavigationView.Resources>
                <!-- Forces the main frame content background to be transparent -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBackground" Color="Transparent" />
                <!-- Secondary safety overrides for specific WPF UI version templates -->
                <SolidColorBrush x:Key="FrameBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ContentPresenterBackground" Color="Transparent" />
                <!-- Explicitly target alternative grid and control layout border keys -->
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewBorderBrush" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
                <!-- Clears any hardcoded padding pushing the inner content away from the navigation menu -->
                <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
                <Thickness x:Key="NavigationViewContentPadding">0</Thickness>
            </ui:NavigationView.Resources>
        </ui:NavigationView>
        </Border>

        <!-- Divider -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="0" />

        <!-- ===== FOOTER ===== -->
        <Grid Grid.Row="4" Margin="12,3,12,0" >
            <Button HorizontalAlignment="Right"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    Click="OpenUcuButton_Click"
                    ToolTip="Open UCU" 
                    Width="36"
                    Height="36">
                <ui:FontIcon FontFamily="Segoe Fluent Icons"
                              FontSize="14"
                              Glyph="&#xE740;"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Button>
        </Grid>
    </Grid>
</ui:FluentWindow>
