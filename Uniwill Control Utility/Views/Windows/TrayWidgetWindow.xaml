<ui:FluentWindow x:Class="Uniwill_Control_Utility.Views.Windows.TrayWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Uniwill_Control_Utility.Views.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 mc:Ignorable="d"
    Title="UCU Quick Control"
    Width="360"
    MinWidth="0"
    MaxWidth="414"
    MinHeight="100"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowCornerPreference="Round"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    d:Background="{DynamicResource MicaBackgroundFillColorBaseBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    Deactivated="Window_Deactivated"
    DpiChanged="Window_DpiChanged"
    Closed="Window_Closed"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <ui:FluentWindow.Resources>
        <Style x:Key="QuickToggleStyle"
               TargetType="ToggleButton"
               BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Background"
                    Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid IsHitTestVisible="{TemplateBinding IsEnabled}">
                            <!-- Base background -->
                            <Border x:Name="BaseBackground"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black"
                                                      Opacity="0.12"
                                                      BlurRadius="8"
                                                      ShadowDepth="2"
                                                      Direction="270" />
                                </Border.Effect>
                            </Border>
                            <!-- Hover overlay for off-state (15% white) -->
                            <Border x:Name="HoverOffOverlay"
                                    Background="White"
                                    Opacity="0.025"
                                    CornerRadius="6"
                                    Visibility="Collapsed" />
                            <!-- Hover overlay for on-state (30% white) -->
                            <Border x:Name="HoverOnOverlay"
                                    Background="White"
                                    Opacity="0.3"
                                    CornerRadius="6"
                                    Visibility="Collapsed" />
                            <!-- Content -->
                            <ContentPresenter x:Name="ContentPresenter"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource AccentTextFillColorTertiaryBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="HoverOffOverlay" Property="Visibility" Value="Visible" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="HoverOnOverlay" Property="Visibility" Value="Visible" />
                            </MultiTrigger>
                            <!-- Disabled state: dim background, off-state foreground -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background"
                                        Value="{DynamicResource ControlAltFillColorSecondaryBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Metrics styles -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="HeroStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <ContextMenu x:Key="NavigateContextMenu"
                     Opened="NavigateContextMenu_Opened"
                     >
            <MenuItem Header="Go to UCU" Click="GoToUcuMenuItem_Click" />
        </ContextMenu>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== METRICS SECTION (no card background) ===== -->
        <Border Grid.Row="0"
                Padding="12,20"
                Background="Transparent" VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU -->
                <Grid Grid.Column="0" Margin="2,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource LabelStyle}"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="CPU" 
                               FontSize="12"
                               Margin="0,0,0,8"/>

                    <!-- Hero row: Temp + Util -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="CpuTempText" Style="{StaticResource HeroStyle}"
                                       Foreground="{DynamicResource AccentTextFillColorTertiaryBrush}"
                                       Text="--°"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <Border Grid.Column="1" Margin="0,8"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="CpuUsageText" Style="{StaticResource HeroStyle}" Text="--%" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Segmented bars -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource LabelStyle}"
                                   VerticalAlignment="Center" Text="Power" HorizontalAlignment="Center" />
                        <controls:DashboardSegmentedBar x:Name="CpuPowerBar"
                            Grid.Row="0" Grid.Column="1" Height="7" Margin="8,0"
                            Maximum="300" Segments="16"
                            Fill="{DynamicResource AccentTextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="CpuPowerText" Grid.Row="0" Grid.Column="2"
                                   Style="{StaticResource ValueStyle}" VerticalAlignment="Center"
                                   Text="-- W" HorizontalAlignment="Center" />

                        <TextBlock Grid.Row="2" Style="{StaticResource LabelStyle}"
                                   VerticalAlignment="Center" Text="Clock" HorizontalAlignment="Center" />
                        <controls:DashboardSegmentedBar x:Name="CpuClockBar"
                            Grid.Row="2" Grid.Column="1" Height="7" Margin="8,0"
                            Maximum="6000" Segments="16"
                            Fill="{DynamicResource AccentTextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="CpuClockText" Grid.Row="2" Grid.Column="2"
                                   Style="{StaticResource ValueStyle}" VerticalAlignment="Center"
                                   Text="-- GHz" HorizontalAlignment="Center" />

                        <TextBlock Grid.Row="4" Style="{StaticResource LabelStyle}"
                                   VerticalAlignment="Center" Text="Fan" HorizontalAlignment="Center" />
                        <controls:DashboardSegmentedBar x:Name="CpuFanBar"
                            Grid.Row="4" Grid.Column="1" Height="7" Margin="8,0"
                            Maximum="100" Segments="16"
                            Fill="{DynamicResource AccentTextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="CpuFanText" Grid.Row="4" Grid.Column="2"
                                   Style="{StaticResource ValueStyle}" VerticalAlignment="Center"
                                   Text="--%" HorizontalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- Vertical Divider -->
                <Border Grid.Column="1"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Margin="0,4,0,0" 
                        Opacity="0.95"
                        />

                <!-- GPU -->
                <Grid Grid.Column="2" Margin="6,0,6,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource LabelStyle}"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="GPU" 
                               FontSize="12"
                               Margin="0,0,0,8"/>

                    <!-- Hero row: Temp + Util -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="GpuTempText" Style="{StaticResource HeroStyle}"
                                       Foreground="{DynamicResource AccentTextFillColorTertiaryBrush}"
                                       Text="--°" HorizontalAlignment="Center" />
                        </StackPanel>

                        <Border Grid.Column="1" Margin="0,8"
                                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="GpuUsageText" Style="{StaticResource HeroStyle}" Text="--%" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Segmented bars -->
                    <Grid Grid.Row="2" Margin="2,12,2,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource LabelStyle}"
                                   VerticalAlignment="Center" Text="Power" HorizontalAlignment="Center" />
                        <controls:DashboardSegmentedBar x:Name="GpuPowerBar"
                            Grid.Row="0" Grid.Column="1" Height="7" Margin="8,0"
                            Maximum="300" Segments="16"
                            Fill="{DynamicResource AccentTextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="GpuPowerText" Grid.Row="0" Grid.Column="2"
                                   Style="{StaticResource ValueStyle}" VerticalAlignment="Center"
                                   Text="-- W" HorizontalAlignment="Center" />

                        <TextBlock Grid.Row="2" Style="{StaticResource LabelStyle}"
                                   VerticalAlignment="Center" Text="Clock" HorizontalAlignment="Center" />
                        <controls:DashboardSegmentedBar x:Name="GpuClockBar"
                            Grid.Row="2" Grid.Column="1" Height="7" Margin="8,0"
                            Maximum="3000" Segments="16"
                            Fill="{DynamicResource AccentTextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="GpuClockText" Grid.Row="2" Grid.Column="2"
                                   Style="{StaticResource ValueStyle}" VerticalAlignment="Center"
                                   Text="-- GHz" HorizontalAlignment="Center" />

                        <TextBlock Grid.Row="4" Style="{StaticResource LabelStyle}"
                                   VerticalAlignment="Center" Text="Fan" HorizontalAlignment="Center" />
                        <controls:DashboardSegmentedBar x:Name="GpuFanBar"
                            Grid.Row="4" Grid.Column="1" Height="7" Margin="8,0"
                            Maximum="100" Segments="16"
                            Fill="{DynamicResource AccentTextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="GpuFanText" Grid.Row="4" Grid.Column="2"
                                   Style="{StaticResource ValueStyle}" VerticalAlignment="Center"
                                   Text="--%" HorizontalAlignment="Center" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Divider -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceStrokeColorFlyoutBrush}" />

        <!-- ===== QUICK SETTINGS GRID (with card background) ===== -->
        <Border Grid.Row="2" Margin="0,0,0,0"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderThickness="0"
                Padding="20,22,20,22">
            <Grid x:Name="ButtonsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Adaptive Mode -->
                <StackPanel x:Name="SlotAdaptiveMode"
                            Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="BtnAdaptiveMode"
                                   Width="92"
                                   Height="46"
                                   Style="{StaticResource QuickToggleStyle}"
                                   Tag="Adaptive"
                                   ContextMenu="{StaticResource NavigateContextMenu}"
                                   Click="BtnAdaptiveMode_Click">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xEB44;"
                                      FontSize="16">
                            <ui:FontIcon.Foreground>
                                <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                         Path="Foreground" />
                            </ui:FontIcon.Foreground>
                        </ui:FontIcon>
                    </ToggleButton>
                    <ui:TextBlock FontSize="11"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Adaptive Mode" />
                </StackPanel>

                <!-- Keyboard RGB -->
                <StackPanel x:Name="SlotKeyboardBacklight"
                            Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="BtnKeyboardBacklight"
                                   Width="92"
                                   Height="46"
                                   Style="{StaticResource QuickToggleStyle}"
                                   Tag="Keyboard"
                                   ContextMenu="{StaticResource NavigateContextMenu}"
                                   Click="BtnKeyboardBacklight_Click">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE92E;"
                                      FontSize="16">
                            <ui:FontIcon.Foreground>
                                <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                         Path="Foreground" />
                            </ui:FontIcon.Foreground>
                        </ui:FontIcon>
                    </ToggleButton>
                    <ui:TextBlock FontSize="11"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Keyboard RGB" />
                </StackPanel>

                <!-- Light Bar -->
                <StackPanel x:Name="SlotLightBar"
                            Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="BtnLightBar"
                                   Width="92"
                                   Height="46"
                                   Style="{StaticResource QuickToggleStyle}"
                                   Tag="LightBar"
                                   ContextMenu="{StaticResource NavigateContextMenu}"
                                   Click="BtnLightBar_Click">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xED39;"
                                      FontSize="18">
                            <ui:FontIcon.Foreground>
                                <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                         Path="Foreground" />
                            </ui:FontIcon.Foreground>
                        </ui:FontIcon>
                    </ToggleButton>
                    <ui:TextBlock FontSize="11"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Light Bar" />
                </StackPanel>

                <!-- Smart Fan Mode -->
                <StackPanel x:Name="SlotFanSmartMode"
                            Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="BtnFanSmartMode"
                                   Width="92"
                                   Height="46"
                                   Style="{StaticResource QuickToggleStyle}"
                                   Tag="FanControl"
                                   ContextMenu="{StaticResource NavigateContextMenu}"
                                   Click="BtnFanSmartMode_Click">
                        <iconPacks:PackIconLucide
                            Kind="Fan"
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center" >
                            <iconPacks:PackIconLucide.Foreground>
                                <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                        Path="Foreground" />
                            </iconPacks:PackIconLucide.Foreground>
                        </iconPacks:PackIconLucide>
                    </ToggleButton>
                    <ui:TextBlock FontSize="11"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Smart Fan Mode" />
                </StackPanel>

                <!-- Overlay -->
                <StackPanel x:Name="SlotOverlay"
                            Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="BtnOverlay"
                                   Width="92"
                                   Height="46"
                                   Style="{StaticResource QuickToggleStyle}"
                                   Tag="OverlaySettingsPage"
                                   ContextMenu="{StaticResource NavigateContextMenu}"
                                   Click="BtnOverlay_Click">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE81E;"
                                      FontSize="16">
                            <ui:FontIcon.Foreground>
                                <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                         Path="Foreground" />
                            </ui:FontIcon.Foreground>
                        </ui:FontIcon>
                    </ToggleButton>
                    <ui:TextBlock FontSize="11"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Overlay" />
                </StackPanel>

                <!-- Local Dimming (dynamic circumstance) -->
                <StackPanel x:Name="SlotLocalDimming"
                            Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="BtnLocalDimming"
                                   Width="92"
                                   Height="46"
                                   Style="{StaticResource QuickToggleStyle}"
                                   Tag="SettingsPage"
                                   ContextMenu="{StaticResource NavigateContextMenu}"
                                   Click="BtnLocalDimming_Click">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE7F4;"
                                      FontSize="16">
                            <ui:FontIcon.Foreground>
                                <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                         Path="Foreground" />
                            </ui:FontIcon.Foreground>
                        </ui:FontIcon>
                    </ToggleButton>
                    <ui:TextBlock FontSize="11"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Local Dimming" />
                </StackPanel>

                <!-- Smart Hydro (dynamic circumstance) -->
                <StackPanel x:Name="SlotHydroSmartMode"
                            Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="BtnHydroSmartMode"
                                   Width="92"
                                   Height="46"
                                   Style="{StaticResource QuickToggleStyle}"
                                   Tag="Watercooler"
                                   ContextMenu="{StaticResource NavigateContextMenu}"
                                   Click="BtnHydroSmartMode_Click">
                        <iconPacks:PackIconLucide
                               Kind="BrainCircuit"
                               Width="16"
                               Height="16"
                               VerticalAlignment="Center" >
                            <iconPacks:PackIconLucide.Foreground>
                                <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                        Path="Foreground" />
                            </iconPacks:PackIconLucide.Foreground>
                        </iconPacks:PackIconLucide>
                    </ToggleButton>
                    <ui:TextBlock FontSize="11"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Smart Hydro" />
                </StackPanel>

                <!-- Hydro RGB (dynamic circumstance) -->
                <StackPanel x:Name="SlotHydroRgb"
                            Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="BtnHydroRgb"
                                   Width="92"
                                   Height="46"
                                   Style="{StaticResource QuickToggleStyle}"
                                   Tag="Watercooler"
                                   ContextMenu="{StaticResource NavigateContextMenu}"
                                   Click="BtnHydroRgb_Click">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE790;"
                                      FontSize="16">
                            <ui:FontIcon.Foreground>
                                <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                         Path="Foreground" />
                            </ui:FontIcon.Foreground>
                        </ui:FontIcon>
                    </ToggleButton>
                    <ui:TextBlock FontSize="11"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Hydro RGB" />
                </StackPanel>

                <!-- Flydigi RGB (dynamic circumstance) -->
                <StackPanel x:Name="SlotFlydigiRgb"
                            Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="BtnFlydigiRgb"
                                   Width="92"
                                   Height="46"
                                   Style="{StaticResource QuickToggleStyle}"
                                   Tag="FlydigiCooler"
                                   ContextMenu="{StaticResource NavigateContextMenu}"
                                   Click="BtnFlydigiRgb_Click">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE790;"
                                      FontSize="16">
                            <ui:FontIcon.Foreground>
                                <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                         Path="Foreground" />
                            </ui:FontIcon.Foreground>
                        </ui:FontIcon>
                    </ToggleButton>
                    <ui:TextBlock FontSize="11"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Flydigi RGB" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Divider -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceStrokeColorFlyoutBrush}" />

        <!-- ===== FOOTER ===== -->
        <Grid Grid.Row="4" Margin="12,12,12,12">
            <Button HorizontalAlignment="Right"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    Click="OpenUcuButton_Click"
                    ToolTip="Open UCU" >
                <ui:FontIcon FontFamily="Segoe Fluent Icons"
                              FontSize="14"
                              Glyph="&#xE740;"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Button>
        </Grid>
    </Grid>
</ui:FluentWindow>
