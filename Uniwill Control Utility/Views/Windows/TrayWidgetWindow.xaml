<ui:FluentWindow x:Class="Uniwill_Control_Utility.Views.Windows.TrayWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 mc:Ignorable="d"
    Title="UCU Quick Control"
    Width="360"
    MinWidth="0"
    MaxWidth="414"
    MinHeight="100"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowCornerPreference="Round"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    d:Background="{DynamicResource MicaBackgroundFillColorBaseBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    Deactivated="Window_Deactivated"
    DpiChanged="Window_DpiChanged"
    Closed="Window_Closed"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <ui:FluentWindow.Resources>
        <Style x:Key="QuickToggleStyle"
               TargetType="ToggleButton"
               BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Background"
                    Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="NavigateContextMenu"
                     Opened="NavigateContextMenu_Opened">
            <MenuItem Header="Go to UCU" Click="GoToUcuMenuItem_Click" />
        </ContextMenu>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== HEADER (no drag) ===== -->
        <Grid Grid.Row="0">
            <Grid Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="24" Height="24" CornerRadius="12" Background="#183F46">
                    <Image Width="19" Height="19" Source="pack://application:,,,/Assets/applicationIcon-32.png" />
                </Border>

                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="Caption" Text="UCU Quick Control" />
                    <ui:TextBlock x:Name="HeaderContextText"
                                   Margin="0,-1,0,0"
                                   FontTypography="Caption"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="Live controls · cached telemetry" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== QUICK SETTINGS GRID ===== -->
        <!-- Top border edge-to-edge separates header from button section -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderThickness="0,1,0,0"
                Padding="12">
            <Grid x:Name="ButtonsGrid" Margin="0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Row 1 -->
                    <StackPanel Grid.Row="0" Grid.Column="0"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                x:Name="SlotAdaptiveMode">
                        <ToggleButton x:Name="BtnAdaptiveMode"
                                       Width="96"
                                       Height="46"
                                       Style="{StaticResource QuickToggleStyle}"
                                       Tag="Adaptive"
                                       ContextMenu="{StaticResource NavigateContextMenu}"
                                       Click="BtnAdaptiveMode_Click">
                            <ui:FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xEB44;"
                                          FontSize="16">
                                <ui:FontIcon.Foreground>
                                    <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                             Path="Foreground" />
                                </ui:FontIcon.Foreground>
                            </ui:FontIcon>
                        </ToggleButton>
                        <ui:TextBlock FontSize="11"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Adaptive Mode" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                x:Name="SlotHydroSmartMode">
                        <ToggleButton x:Name="BtnHydroSmartMode"
                                       Width="96"
                                       Height="46"
                                       Style="{StaticResource QuickToggleStyle}"
                                       Tag="Watercooler"
                                       ContextMenu="{StaticResource NavigateContextMenu}"
                                       Click="BtnHydroSmartMode_Click">
                        <iconPacks:PackIconLucide
                               Kind="BrainCircuit"
                               Width="16"
                               Height="16"
                               VerticalAlignment="Center" >
                            <iconPacks:PackIconLucide.Foreground>
                                <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                        Path="Foreground" />
                            </iconPacks:PackIconLucide.Foreground>
                        </iconPacks:PackIconLucide>
                    </ToggleButton>
                        <ui:TextBlock FontSize="11"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Hydro Smart" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                x:Name="SlotHydroRgb">
                        <ToggleButton x:Name="BtnHydroRgb"
                                       Width="96"
                                       Height="46"
                                       Style="{StaticResource QuickToggleStyle}"
                                       Tag="Watercooler"
                                       ContextMenu="{StaticResource NavigateContextMenu}"
                                       Click="BtnHydroRgb_Click">
                            <ui:FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE790;"
                                          FontSize="16">
                                <ui:FontIcon.Foreground>
                                    <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                             Path="Foreground" />
                                </ui:FontIcon.Foreground>
                            </ui:FontIcon>
                        </ToggleButton>
                        <ui:TextBlock FontSize="11"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Hydro RGB" />
                    </StackPanel>

                    <!-- Row 2 -->
                    <StackPanel Grid.Row="2" Grid.Column="0"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                x:Name="SlotKeyboardBacklight">
                        <ToggleButton x:Name="BtnKeyboardBacklight"
                                       Width="96"
                                       Height="46"
                                       Style="{StaticResource QuickToggleStyle}"
                                       Tag="Keyboard"
                                       ContextMenu="{StaticResource NavigateContextMenu}"
                                       Click="BtnKeyboardBacklight_Click">
                            <ui:FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE92E;"
                                          FontSize="16">
                                <ui:FontIcon.Foreground>
                                    <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                             Path="Foreground" />
                                </ui:FontIcon.Foreground>
                            </ui:FontIcon>
                        </ToggleButton>
                        <ui:TextBlock FontSize="11"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Keyboard RGB" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                x:Name="SlotLightBar">
                        <ToggleButton x:Name="BtnLightBar"
                                       Width="96"
                                       Height="46"
                                       Style="{StaticResource QuickToggleStyle}"
                                       Tag="LightBar"
                                       ContextMenu="{StaticResource NavigateContextMenu}"
                                       Click="BtnLightBar_Click">
                            <ui:FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xED39;"
                                          FontSize="18">
                                <ui:FontIcon.Foreground>
                                    <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                             Path="Foreground" />
                                </ui:FontIcon.Foreground>
                            </ui:FontIcon>
                        </ToggleButton>
                        <ui:TextBlock FontSize="11"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Light Bar" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                x:Name="SlotFanSmartMode">
                        <ToggleButton x:Name="BtnFanSmartMode"
                                       Width="96"
                                       Height="46"
                                       Style="{StaticResource QuickToggleStyle}"
                                       Tag="FanControl"
                                       ContextMenu="{StaticResource NavigateContextMenu}"
                                       Click="BtnFanSmartMode_Click">
                        <iconPacks:PackIconLucide
                            Kind="Fan"
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center" >
                            <iconPacks:PackIconLucide.Foreground>
                                <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                    Path="Foreground" />
                            </iconPacks:PackIconLucide.Foreground>
                        </iconPacks:PackIconLucide>
                    </ToggleButton>
                        <ui:TextBlock FontSize="11"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Smart Fan Mode" />
                    </StackPanel>

                    <!-- Row 3 -->
                    <StackPanel Grid.Row="4" Grid.Column="0"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                x:Name="SlotLocalDimming">
                        <ToggleButton x:Name="BtnLocalDimming"
                                       Width="96"
                                       Height="46"
                                       Style="{StaticResource QuickToggleStyle}"
                                       Tag="SettingsPage"
                                       ContextMenu="{StaticResource NavigateContextMenu}"
                                       Click="BtnLocalDimming_Click">
                            <ui:FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE7F4;"
                                          FontSize="16">
                                <ui:FontIcon.Foreground>
                                    <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                             Path="Foreground" />
                                </ui:FontIcon.Foreground>
                            </ui:FontIcon>
                        </ToggleButton>
                        <ui:TextBlock FontSize="11"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Local Dimming" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="1"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                x:Name="SlotOverlay">
                        <ToggleButton x:Name="BtnOverlay"
                                       Width="96"
                                       Height="46"
                                       Style="{StaticResource QuickToggleStyle}"
                                       Tag="OverlaySettingsPage"
                                       ContextMenu="{StaticResource NavigateContextMenu}"
                                       Click="BtnOverlay_Click">
                            <ui:FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE81E;"
                                          FontSize="16">
                                <ui:FontIcon.Foreground>
                                    <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                             Path="Foreground" />
                                </ui:FontIcon.Foreground>
                            </ui:FontIcon>
                        </ToggleButton>
                        <ui:TextBlock FontSize="11"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Overlay" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="2"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                x:Name="SlotFlydigiRgb">
                        <ToggleButton x:Name="BtnFlydigiRgb"
                                       Width="96"
                                       Height="46"
                                       Style="{StaticResource QuickToggleStyle}"
                                       Tag="FlydigiCooler"
                                       ContextMenu="{StaticResource NavigateContextMenu}"
                                       Click="BtnFlydigiRgb_Click">
                            <ui:FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE790;"
                                          FontSize="16">
                                <ui:FontIcon.Foreground>
                                    <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                             Path="Foreground" />
                                </ui:FontIcon.Foreground>
                            </ui:FontIcon>
                        </ToggleButton>
                        <ui:TextBlock FontSize="11"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Flydigi RGB" />
                    </StackPanel>
                </Grid>
        </Border>

        <!-- ===== FOOTER ===== -->
        <Grid Grid.Row="2" Margin="12,12,12,12">
            <Button HorizontalAlignment="Right"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    Click="OpenUcuButton_Click"
                    ToolTip="Open UCU" >
                <ui:FontIcon FontFamily="Segoe Fluent Icons"
                              FontSize="14"
                              Glyph="&#xE740;"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Button>
        </Grid>
    </Grid>
</ui:FluentWindow>
