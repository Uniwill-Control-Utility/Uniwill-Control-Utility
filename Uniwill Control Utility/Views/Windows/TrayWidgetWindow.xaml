<ui:FluentWindow x:Class="Uniwill_Control_Utility.Views.Windows.TrayWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d"
    Title="UCU Quick Control"
    Width="414"
    MinWidth="0"
    MaxWidth="414"
    MinHeight="0"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowCornerPreference="Round"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    d:Background="{DynamicResource MicaBackgroundFillColorBaseBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    Deactivated="Window_Deactivated"
    DpiChanged="Window_DpiChanged"
    Closed="Window_Closed"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <ui:FluentWindow.Resources>
        <Style x:Key="PresetButtonStyle"
               TargetType="{x:Type ToggleButton}"
               BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                CornerRadius="8,8,0,0"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="24" Height="24" CornerRadius="12" Background="#183F46">
                    <Image Width="19" Height="19" Source="pack://application:,,,/Assets/applicationIcon-32.png" />
                </Border>

                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="Caption" Text="UCU Quick Control" />
                    <ui:TextBlock x:Name="HeaderContextText"
                                   Margin="0,-1,0,0"
                                   FontTypography="Caption"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="Live controls · cached telemetry" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== CONTENT ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled">
            <StackPanel Margin="12">

                <!-- ===== PRESETS ===== -->
                <ui:TextBlock FontTypography="Caption"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="PRESETS"
                               Margin="0,0,0,8" />

                <!-- Row 1: Stock presets (Office, Gaming, Turbo) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <ToggleButton x:Name="PresetOfficeButton"
                                   Style="{StaticResource PresetButtonStyle}"
                                   Height="36"
                                   Width="100"
                                   Margin="12"
                                   HorizontalContentAlignment="Center"
                                   Click="PresetButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE8BE;"
                                          FontSize="14"
                                          Margin="0,0,6,0">
                                <ui:FontIcon.Foreground>
                                    <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                             Path="Foreground" />
                                </ui:FontIcon.Foreground>
                            </ui:FontIcon>
                            <ui:TextBlock VerticalAlignment="Center"
                                           FontSize="13"
                                           Text="Office" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="PresetGamingButton"
                                   Style="{StaticResource PresetButtonStyle}"
                                   Height="36"
                                   Width="100"
                                   Margin="12"
                                   HorizontalContentAlignment="Center"
                                   Click="PresetButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE967;"
                                          FontSize="14"
                                          Margin="0,0,6,0">
                                <ui:FontIcon.Foreground>
                                    <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                             Path="Foreground" />
                                </ui:FontIcon.Foreground>
                            </ui:FontIcon>
                            <ui:TextBlock VerticalAlignment="Center"
                                           FontSize="13"
                                           Text="Gaming" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="PresetTurboButton"
                                   Style="{StaticResource PresetButtonStyle}"
                                   Height="36"
                                   Width="100"
                                   Margin="12"
                                   HorizontalContentAlignment="Center"
                                   Click="PresetButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE945;"
                                          FontSize="14"
                                          Margin="0,0,6,0">
                                <ui:FontIcon.Foreground>
                                    <Binding RelativeSource="{RelativeSource AncestorType=ToggleButton}"
                                             Path="Foreground" />
                                </ui:FontIcon.Foreground>
                            </ui:FontIcon>
                            <ui:TextBlock VerticalAlignment="Center"
                                           FontSize="13"
                                           Text="Turbo" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <!-- Row 2: Custom presets (dynamically populated, multi-row) -->
                <StackPanel x:Name="CustomPresetsPanel" Visibility="Collapsed"/>

                <Separator Margin="0,12"
                           Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <!-- ===== FAN CONTROL ===== -->
                <ui:TextBlock x:Name="FanControlHeader"
                               FontTypography="Caption"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="FAN CONTROL"
                               Margin="0,0,0,8" />

                <TextBlock x:Name="FanControlPlaceholder"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="(fan control toggles)" />

                <Separator Margin="0,12"
                           Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <!-- ===== HYDRO UI ===== -->
                <ui:TextBlock x:Name="HydroHeader"
                               FontTypography="Caption"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="HYDRO UI"
                               Margin="0,0,0,8" />

                <TextBlock x:Name="HydroPlaceholder"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="(hydro ui toggles)" />

                <Separator Margin="0,12"
                           Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <!-- ===== FLYDIGI ===== -->
                <ui:TextBlock x:Name="FlydigiHeader"
                               FontTypography="Caption"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="FLYDIGI"
                               Margin="0,0,0,8" />

                <TextBlock x:Name="FlydigiPlaceholder"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="(flydigi toggles)" />

                <!-- ===== FOOTER ===== -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock x:Name="StatusText"
                                   VerticalAlignment="Center"
                                   FontTypography="Caption"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="All controls ready" />
                    <ui:Button Grid.Column="1"
                                Height="31"
                                Padding="13,0"
                                Appearance="Primary"
                                Click="OpenUcuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBlock Margin="0,0,8,0"
                                           FontSize="11"
                                           Text="Open UCU" />
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE740;" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
