<ui:FluentWindow x:Class="Uniwill_Control_Utility.Views.Windows.VfCurveEditorWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Uniwill_Control_Utility.Views.Controls"
             Title="GPU Curve Editor"
             Width="780" Height="520"
             MinHeight="500" MinWidth="700"
             ResizeMode="CanResizeWithGrip"
             WindowStartupLocation="CenterOwner"
             ExtendsContentIntoTitleBar="True"
             WindowBackdropType="Mica"
             WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <ui:TitleBar Grid.Row="0"
                     Title="GPU Curve Editor"
                     ShowMinimize="True"
                     ShowMaximize="False"
                     ShowClose="True"/>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Drag points to adjust GPU frequency per voltage. Tab to navigate, Shift+Click for range selection."
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,8,0"/>
                <Button Style="{StaticResource DefaultButtonStyle}"
                        Background="Transparent" BorderBrush="Transparent"
                        Padding="4" Cursor="Hand" HorizontalAlignment="Right">
                    <Button.ToolTip>
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="Shift + Click point — range select" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Shift + Double-press Enter — flatten selection" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Ctrl + Click point — select all, move all" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Ctrl + A — select all" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Ctrl + D — clear selection" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Tab / Shift + Tab — navigate points" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Up / Down — adjust frequency" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Ctrl + Z / Y — undo / redo" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Button.ToolTip>
                    <ui:SymbolIcon Symbol="Info20" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Button>
            </StackPanel>

            <!-- Curve Editor -->
            <controls:VfCurveEditor x:Name="_editor" Grid.Row="1"/>
        </Grid>

        <!-- Bottom bar -->
        <Grid Grid.Row="2" Margin="16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Export / Import buttons (left) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Export" Width="70" Click="btnExport_Click" Margin="0,0,8,0"
                        Style="{StaticResource DefaultButtonStyle}"/>
                <Button Content="Import" Width="70" Click="btnImport_Click"
                        Style="{StaticResource DefaultButtonStyle}"/>
            </StackPanel>

            <!-- Reset button (right) -->
            <Button Grid.Column="2" Content="Reset" Width="70" Click="btnReset_Click"
                    Style="{StaticResource DefaultButtonStyle}"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
