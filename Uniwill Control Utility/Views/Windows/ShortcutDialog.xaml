<ui:FluentWindow x:Class="Uniwill_Control_Utility.Views.Windows.ShortcutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Keyboard Shortcut"
    Width="460"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    ExtendsContentIntoTitleBar="True"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     x:Name="TitleBar"
                     Icon="pack://application:,,,/Assets/applicationIcon-256.png"
                     CanMaximize="False"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     ShowClose="False" />

        <StackPanel Grid.Row="1" Margin="18,8,18,8">
            <!-- Chord -->
            <ui:TextBlock x:Name="lblChord" FontTypography="BodyStrong" Margin="0,0,0,4" />
            <TextBox x:Name="txtChord"
                     Height="32"
                     IsReadOnly="True"
                     Cursor="Hand"
                     PreviewKeyDown="ChordTextBox_PreviewKeyDown"
                     ToolTip="Click the box and press the shortcut you want" />
            <ui:TextBlock x:Name="lblChordHint"
                           FontTypography="Caption"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextWrapping="Wrap" />

            <!-- Action -->
            <ui:TextBlock x:Name="lblAction" FontTypography="BodyStrong" Margin="0,14,0,4" />
            <ComboBox x:Name="cbxAction" Height="32" SelectionChanged="Action_SelectionChanged" />

            <!-- Preset payload -->
            <StackPanel x:Name="panelPreset" Margin="0,10,0,0" Visibility="Collapsed">
                <ui:TextBlock x:Name="lblPreset" FontTypography="Body" Margin="0,0,0,4" />
                <ComboBox x:Name="cbxPreset" Height="32" />
            </StackPanel>

            <!-- Performance-mode payload -->
            <StackPanel x:Name="panelMode" Margin="0,10,0,0" Visibility="Collapsed">
                <ui:TextBlock x:Name="lblMode" FontTypography="Body" Margin="0,0,0,4" />
                <ui:NumberBox x:Name="nbMode"
                              Minimum="0" Maximum="4"
                              MaxDecimalPlaces="0" SmallChange="1"
                              Value="0" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="18,0,18,16">
            <Button x:Name="btnCancel" Content="Cancel" Width="90" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button x:Name="btnSave" Content="Save" Width="90" Click="Save_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
