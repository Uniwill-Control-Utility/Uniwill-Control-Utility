<ui:FluentWindow x:Class="Uniwill_Control_Utility.Views.Windows.TrayMetricsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Uniwill_Control_Utility.Views.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="UCU Metrics"
    Width="360"
    MinWidth="0"
    MaxWidth="414"
    MinHeight="100"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowCornerPreference="Round"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <ui:FluentWindow.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="HeroStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </ui:FluentWindow.Resources>

    <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
            Padding="12,16">
        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== CPU ===== -->
            <Grid Grid.Column="0" Margin="0,0,6,0" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- CPU label -->
                <TextBlock Grid.Row="0"
                           Style="{StaticResource LabelStyle}"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="CPU" />

                <!-- Hero row: Temp + Util -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="CpuTempText" Style="{StaticResource HeroStyle}"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   Text="--°" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="1" Margin="0,8"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="CpuUsageText" Style="{StaticResource HeroStyle}" Text="--%" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Segmented bars -->
                <Grid Grid.Row="2" Margin="0,12,0,0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Power -->
                    <TextBlock Grid.Row="0" Style="{StaticResource LabelStyle}"
                               VerticalAlignment="Center" Text="Power" HorizontalAlignment="Center"/>
                    <controls:DashboardSegmentedBar x:Name="CpuPowerBar"
                        Grid.Row="0" Grid.Column="1" Height="7" Margin="8,0"
                        Maximum="300" Segments="16"
                        Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock x:Name="CpuPowerText" Grid.Row="0" Grid.Column="2"
                               Style="{StaticResource ValueStyle}" VerticalAlignment="Center"
                               Text="-- W" HorizontalAlignment="Center"/>

                    <!-- Clock -->
                    <TextBlock Grid.Row="2" Style="{StaticResource LabelStyle}"
                               VerticalAlignment="Center" Text="Clock" HorizontalAlignment="Center"/>
                    <controls:DashboardSegmentedBar x:Name="CpuClockBar"
                        Grid.Row="2" Grid.Column="1" Height="7" Margin="8,0"
                        Maximum="6000" Segments="16"
                        Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock x:Name="CpuClockText" Grid.Row="2" Grid.Column="2"
                               Style="{StaticResource ValueStyle}" VerticalAlignment="Center"
                               Text="-- GHz" HorizontalAlignment="Center"/>

                    <!-- Fan -->
                    <TextBlock Grid.Row="4" Style="{StaticResource LabelStyle}"
                               VerticalAlignment="Center" Text="Fan" HorizontalAlignment="Center"/>
                    <controls:DashboardSegmentedBar x:Name="CpuFanBar"
                        Grid.Row="4" Grid.Column="1" Height="7" Margin="8,0"
                        Maximum="100" Segments="16"
                        Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock x:Name="CpuFanText" Grid.Row="4" Grid.Column="2"
                               Style="{StaticResource ValueStyle}" VerticalAlignment="Center"
                               Text="--%" HorizontalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- Vertical Divider -->
            <Border Grid.Column="1"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                    Margin="0,4" />

            <!-- ===== GPU ===== -->
            <Grid Grid.Column="2" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- GPU label -->
                <TextBlock Grid.Row="0"
                           Style="{StaticResource LabelStyle}"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="GPU" />

                <!-- Hero row: Temp + Util -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="GpuTempText" Style="{StaticResource HeroStyle}"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   Text="--°" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="1" Margin="0,8"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="GpuUsageText" Style="{StaticResource HeroStyle}" Text="--%" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Segmented bars -->
                <Grid Grid.Row="2" Margin="2,12,2,0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Power -->
                    <TextBlock Grid.Row="0" Style="{StaticResource LabelStyle}"
                               VerticalAlignment="Center" Text="Power" HorizontalAlignment="Center"/>
                    <controls:DashboardSegmentedBar x:Name="GpuPowerBar"
                        Grid.Row="0" Grid.Column="1" Height="7" Margin="8,0"
                        Maximum="300" Segments="16"
                        Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock x:Name="GpuPowerText" Grid.Row="0" Grid.Column="2"
                               Style="{StaticResource ValueStyle}" VerticalAlignment="Center"
                               Text="-- W" HorizontalAlignment="Center"/>

                    <!-- Clock -->
                    <TextBlock Grid.Row="2" Style="{StaticResource LabelStyle}"
                               VerticalAlignment="Center" Text="Clock" HorizontalAlignment="Center"/>
                    <controls:DashboardSegmentedBar x:Name="GpuClockBar"
                        Grid.Row="2" Grid.Column="1" Height="7" Margin="8,0"
                        Maximum="3000" Segments="16"
                        Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock x:Name="GpuClockText" Grid.Row="2" Grid.Column="2"
                               Style="{StaticResource ValueStyle}" VerticalAlignment="Center"
                               Text="-- GHz" HorizontalAlignment="Center"/>

                    <!-- Fan -->
                    <TextBlock Grid.Row="4" Style="{StaticResource LabelStyle}"
                               VerticalAlignment="Center" Text="Fan" HorizontalAlignment="Center"/>
                    <controls:DashboardSegmentedBar x:Name="GpuFanBar"
                        Grid.Row="4" Grid.Column="1" Height="7" Margin="8,0"
                        Maximum="100" Segments="16"
                        Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock x:Name="GpuFanText" Grid.Row="4" Grid.Column="2"
                               Style="{StaticResource ValueStyle}" VerticalAlignment="Center"
                               Text="--%" HorizontalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
