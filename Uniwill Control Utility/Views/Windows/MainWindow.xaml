<ui:FluentWindow x:Class="Uniwill_Control_Utility.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Uniwill_Control_Utility.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
      x:Name="mainWindow"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="1080"
    Height="817"
    MinWidth="1000"
    MinHeight="614"
    d:DataContext="{d:DesignInstance local:MainWindow, IsDesignTimeCreatable=True}"
    d:Background="{DynamicResource MicaBackgroundFillColorBaseBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    mc:Ignorable="d"
    Loaded="mainWindow_Loaded"
    StateChanged="UiWindow_StateChanged"
    Closing="UiWindow_Closing">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  The title bar contains window navigation elements and some Tray related extras.  -->
        <!--  You can put additional controls in the header, such as a search bar.  -->
        <ui:TitleBar
    x:Name="tbMain"
    Grid.Row="0"
    Title="Uniwill Control Utility">

            <ui:TitleBar.Resources>
                <Style TargetType="{x:Type ui:TitleBarButton}" BasedOn="{StaticResource {x:Type ui:TitleBarButton}}">
                    <!-- Force the buttons to match the height of the TitleBar -->
                    <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource AncestorType=ui:TitleBar}, Path=ActualHeight}" />
                    <!-- Ensure they stretch properly -->
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                </Style>
            </ui:TitleBar.Resources>

            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/applicationIcon-256.png" 
                      Margin="11,0,0,0" 
                      RenderOptions.BitmapScalingMode="HighQuality"/>
            </ui:TitleBar.Icon>

            <ui:TitleBar.Header>
                <TextBlock x:Name="ModelNameText"
                   FontSize="11"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   VerticalAlignment="Center"
                   Margin="4,0,0,0"
                   Text="Uniwill Control Utility" />
            </ui:TitleBar.Header>

            <ui:TitleBar.TrailingContent>
                <ui:Card x:Name="LaptopNameCard"
                 Margin="4,4,4,4"
                 Padding="4,4,8,4"
                 Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:FontIcon Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="16"
                           Glyph="&#xE7F8;"
                           Margin="4,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="LaptopNameText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Card>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation"
                   Grid.Row="1"
                   FontSize="10"
                   Margin="0"
                   IsPaneOpen="False"
                   IsBackButtonVisible="Collapsed"
                   PaneDisplayMode="LeftFluent"
                   HeaderVisibility="Collapsed"
                   HorizontalContentAlignment="Center"
                   MenuItemsSource="{Binding ViewModel.NavigationItems}"
                   FooterMenuItemsSource="{Binding ViewModel.NavigationFooter}"
                   d:Background="{DynamicResource MicaBackgroundFillColorBaseBrush}">

            <ui:NavigationView.Resources>
                <!-- Forces the main frame content background to be transparent -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBackground" Color="Transparent" />

                <!-- Secondary safety overrides for specific WPF UI version templates -->
                <SolidColorBrush x:Key="FrameBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ContentPresenterBackground" Color="Transparent" />

                <!-- Explicitly target alternative grid and control layout border keys -->
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewBorderBrush" Color="Transparent" />

                <!-- Hide the separator between main items and footer -->
                <SolidColorBrush x:Key="LeftNavigationViewSeparatorBrush" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>

                <!-- Clears any hardcoded padding pushing the inner content away from the navigation menu -->
                <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
                <Thickness x:Key="NavigationViewContentPadding">0</Thickness>
                
                <DataTemplate x:Key="NavigationLabelTemplate">
                    <TextBlock Text="{Binding}"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    </TextBlock>
                </DataTemplate>

            </ui:NavigationView.Resources>
        </ui:NavigationView>

        <tray:NotifyIcon x:Name="niTray"
                         LeftClick="NotifyIcon_LeftClick"
                         FocusOnLeftClick="False"
                         Icon="pack://application:,,,/Assets/applicationIcon-32.png"
                         MenuOnRightClick="True"
                         TooltipText="Uniwill Control Utility"
                         Width="48"
                         Height="48">
            <tray:NotifyIcon.Menu>
                <ContextMenu x:Name="cmTrayMenu" Opened="TrayMenu_Opened">
                    <!-- ═══════════════════════════════════════════
                         SECTION 1: PRESETS
                         ═══════════════════════════════════════════ -->
                    <MenuItem x:Name="miSectionPresets" Header="Presets">
                        <!-- Stock profiles - shown directly -->
                        <MenuItem x:Name="miTrayOfficePreset"
                                  Header="Office"
                                  Tag="Office"
                                  IsCheckable="True"
                                  Click="TrayStockPreset_Click" />
                        <MenuItem x:Name="miTrayGamingPreset"
                                  Header="Gaming"
                                  Tag="Gaming"
                                  IsCheckable="True"
                                  Click="TrayStockPreset_Click" />
                        <MenuItem x:Name="miTrayTurboPreset"
                                  Header="Turbo"
                                  Tag="Turbo"
                                  IsCheckable="True"
                                  Click="TrayStockPreset_Click" />
                        <!-- Separator between stock and custom -->
                        <Separator />
                        <!-- Custom profiles (1-5, only saved ones shown) - inserted dynamically -->
                    </MenuItem>

                    <!-- ═══════════════════════════════════════════
                         SECTION 2: HYDRO UI
                         ═══════════════════════════════════════════ -->
                    <MenuItem x:Name="miSectionHydro" Header="Hydro UI">
                        <!-- Pump Voltage -->
                        <MenuItem x:Name="miHydroPump" Header="Pump">
                            <MenuItem Header="Off" Tag="Off" IsCheckable="True" Click="TrayHydroPump_Click" />
                            <MenuItem Header="7 V" Tag="V7" IsCheckable="True" Click="TrayHydroPump_Click" />
                            <MenuItem Header="8 V" Tag="V8" IsCheckable="True" Click="TrayHydroPump_Click" />
                            <MenuItem Header="11 V" Tag="V11" IsCheckable="True" Click="TrayHydroPump_Click" />
                        </MenuItem>
                        <!-- Fan Speed -->
                        <MenuItem x:Name="miHydroFan" Header="Fan">
                            <MenuItem Header="Off" Tag="Off" IsCheckable="True" Click="TrayHydroFan_Click" />
                            <MenuItem Header="25%" Tag="Percent25" IsCheckable="True" Click="TrayHydroFan_Click" />
                            <MenuItem Header="50%" Tag="Percent50" IsCheckable="True" Click="TrayHydroFan_Click" />
                            <MenuItem Header="75%" Tag="Percent75" IsCheckable="True" Click="TrayHydroFan_Click" />
                            <MenuItem Header="90%" Tag="Percent90" IsCheckable="True" Click="TrayHydroFan_Click" />
                            <MenuItem Header="95%" Tag="Percent95" IsCheckable="True" Click="TrayHydroFan_Click" />
                            <MenuItem Header="100%" Tag="Percent100" IsCheckable="True" Click="TrayHydroFan_Click" />
                        </MenuItem>
                        <!-- RGB -->
                        <MenuItem x:Name="miHydroRgb" Header="RGB">
                            <MenuItem Header="Off" Tag="Off" IsCheckable="True" Click="TrayHydroRgb_Click" />
                            <MenuItem Header="Static" Tag="Static" IsCheckable="True" Click="TrayHydroRgb_Click" />
                            <MenuItem Header="Breathe" Tag="Breathe" IsCheckable="True" Click="TrayHydroRgb_Click" />
                            <MenuItem Header="Colorful" Tag="Colorful" IsCheckable="True" Click="TrayHydroRgb_Click" />
                            <MenuItem Header="Breathe Color" Tag="BreatheColor" IsCheckable="True" Click="TrayHydroRgb_Click" />
                        </MenuItem>
                    </MenuItem>

                    <!-- ═══════════════════════════════════════════
                         SECTION 3: FAN CONTROL
                         ═══════════════════════════════════════════ -->
                    <MenuItem x:Name="miSectionFanControl" Header="Fan Control">
                        <!-- Unified Curve toggle -->
                        <MenuItem x:Name="miFanUnified"
                                  Header="Unified Curve"
                                  IsCheckable="True"
                                  Click="TrayFanUnified_Click" />
                        <!-- Profile (shown when Unified is ON) -->
                        <MenuItem x:Name="miFanCurveProfile" Header="Profile">
                            <MenuItem Header="Silent" Tag="Silent" IsCheckable="True" Click="TrayFanProfile_Click" />
                            <MenuItem Header="Balanced" Tag="Balanced" IsCheckable="True" Click="TrayFanProfile_Click" />
                            <MenuItem Header="Performance" Tag="Performance" IsCheckable="True" Click="TrayFanProfile_Click" />
                            <MenuItem Header="Full Speed" Tag="FullSpeed" IsCheckable="True" Click="TrayFanProfile_Click" />
                            <MenuItem Header="Off" Tag="Off" IsCheckable="True" Click="TrayFanProfile_Click" />
                        </MenuItem>
                        <!-- CPU Profile (shown when Unified is OFF) -->
                        <MenuItem x:Name="miFanCpuProfile" Header="CPU Profile" Visibility="Collapsed">
                            <MenuItem Header="Silent" Tag="Silent" IsCheckable="True" Click="TrayFanCpuProfile_Click" />
                            <MenuItem Header="Balanced" Tag="Balanced" IsCheckable="True" Click="TrayFanCpuProfile_Click" />
                            <MenuItem Header="Performance" Tag="Performance" IsCheckable="True" Click="TrayFanCpuProfile_Click" />
                            <MenuItem Header="Full Speed" Tag="FullSpeed" IsCheckable="True" Click="TrayFanCpuProfile_Click" />
                            <MenuItem Header="Off" Tag="Off" IsCheckable="True" Click="TrayFanCpuProfile_Click" />
                        </MenuItem>
                        <!-- GPU Profile (shown when Unified is OFF) -->
                        <MenuItem x:Name="miFanGpuProfile" Header="GPU Profile" Visibility="Collapsed">
                            <MenuItem Header="Silent" Tag="Silent" IsCheckable="True" Click="TrayFanGpuProfile_Click" />
                            <MenuItem Header="Balanced" Tag="Balanced" IsCheckable="True" Click="TrayFanGpuProfile_Click" />
                            <MenuItem Header="Performance" Tag="Performance" IsCheckable="True" Click="TrayFanGpuProfile_Click" />
                            <MenuItem Header="Full Speed" Tag="FullSpeed" IsCheckable="True" Click="TrayFanGpuProfile_Click" />
                            <MenuItem Header="Off" Tag="Off" IsCheckable="True" Click="TrayFanGpuProfile_Click" />
                        </MenuItem>
                    </MenuItem>

                    <!-- ═══════════════════════════════════════════
                         SECTION 4: FLYDIGI
                         ═══════════════════════════════════════════ -->
                    <MenuItem x:Name="miSectionFlydigi" Header="Flydigi">
                        <!-- Fan Mode -->
                        <MenuItem x:Name="miFlydigiFan" Header="Fan Mode">
                            <MenuItem Header="Off" Tag="Off" IsCheckable="True" Click="TrayFlydigiFan_Click" />
                            <!-- Gears submenu -->
                            <MenuItem x:Name="miFlydigiGears" Header="Gears">
                                <MenuItem Header="Quiet" Tag="Gear1" IsCheckable="True" Click="TrayFlydigiFan_Click" />
                                <MenuItem Header="Standard" Tag="Gear2" IsCheckable="True" Click="TrayFlydigiFan_Click" />
                                <MenuItem Header="Strong" Tag="Gear3" IsCheckable="True" Click="TrayFlydigiFan_Click" />
                                <MenuItem Header="Overclock" Tag="Gear4" IsCheckable="True" Click="TrayFlydigiFan_Click" />
                            </MenuItem>
                            <!-- Auto(Curve) parent with curve profiles as children -->
                            <MenuItem x:Name="miFlydigiAutoCurve" Header="Auto (Curve)">
                                <MenuItem Header="Silent" Tag="Silent" IsCheckable="True" Click="TrayFlydigiCurve_Click" />
                                <MenuItem Header="Balanced" Tag="Balanced" IsCheckable="True" Click="TrayFlydigiCurve_Click" />
                                <MenuItem Header="Performance" Tag="Performance" IsCheckable="True" Click="TrayFlydigiCurve_Click" />
                                <MenuItem x:Name="miFlydigiCurveCustom" Header="Custom" Tag="Custom" IsCheckable="True" Click="TrayFlydigiCurve_Click" />
                            </MenuItem>
                        </MenuItem>
                        <!-- RGB -->
                        <MenuItem x:Name="miFlydigiRgb" Header="RGB">
                            <MenuItem Header="Off" Tag="Off" IsCheckable="True" Click="TrayFlydigiRgb_Click" />
                            <MenuItem Header="Smart Temp" Tag="SmartTemp" IsCheckable="True" Click="TrayFlydigiRgb_Click" />
                            <MenuItem Header="Static" Tag="Static" IsCheckable="True" Click="TrayFlydigiRgb_Click" />
                            <MenuItem Header="Flowing" Tag="Flowing" IsCheckable="True" Click="TrayFlydigiRgb_Click" />
                            <MenuItem Header="Breathing" Tag="Breathing" IsCheckable="True" Click="TrayFlydigiRgb_Click" />
                        </MenuItem>
                    </MenuItem>

                    <Separator />
                    <MenuItem x:Name="miClose"
                              Header="Close Application"
                              Tag="close"
                              Click="miClose_Click" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</ui:FluentWindow>
