<Page x:Class="Uniwill_Control_Utility.Views.Pages.FanControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Uniwill_Control_Utility.Views.Pages"
      xmlns:controls="clr-namespace:Uniwill_Control_Utility.Views.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      d:DataContext="{d:DesignInstance local:FanControl, IsDesignTimeCreatable=False}"
      d:Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d"
      d:DesignHeight="620"
      d:DesignWidth="800"
      Title="Fan Control"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True"
      ScrollViewer.CanContentScroll="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Scrollable content -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      IsDeferredScrollingEnabled="False">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}"
                       BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ScrollViewer.Style>
            <!-- Centered max-width layout container -->
            <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Page title (16px side margin for non-Home page) -->
                <StackPanel Grid.Row="0" Margin="0,16,0,0">
                    <TextBlock FontSize="26"
                               FontWeight="Medium"
                               Margin="12,0,16,0"
                               Text="Fan Control" />
                    <TextBlock Margin="12,8,16,12"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Manage fan speeds and temperature curves for your device."
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Row 1: Content -->
                <StackPanel Grid.Row="1" Margin="12,16,16,18">

                <!-- CPU & GPU status cards side by side -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:CpuControl x:Name="CpuControl" Grid.Column="0" />
                    <controls:GpuControl x:Name="GpuControl" Grid.Column="2" />
                </Grid>

               <!-- Uniwill-specific controls -->
                <StackPanel x:Name="UniwillAvailable">
                    <!-- Info banner -->
                        <ui:InfoBar x:Name="InfoBanner"
                                    Margin="0,8,0,8"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Informational"
                                    Message="Default fan curve profiles cannot be edited, switch to Custom in order to make a personalized curve.">
                            <ui:InfoBar.Resources>
                                <!-- For WPF UI, target ui:SymbolIcon. For ModernWPF, target ui:FontIcon -->
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Margin" Value="4,0,6,0" />
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </ui:InfoBar.Resources>
                        </ui:InfoBar>

                    <!-- Unified curve toggle with expander -->
                    <ui:CardExpander x:Name="UnifiedCard"
                                     Margin="0,0,0,8"
                                     IsExpanded="False"
                                     Expanded="UnifiedCard_Expanded"
                                     Collapsed="UnifiedCard_Collapsed"
                                     Loaded="UnifiedCard_Loaded">
                        <ui:CardExpander.Icon>
                                <ui:FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xEA3C;" FontSize="20" Margin="4,0,6,0"/>
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="Unified Fan Curve" />
                                    <ui:TextBlock FontTypography="Caption"
                                               Text="When enabled, a single curve controls both CPU and GPU fans"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="tsUnifiedCurve"
                                                 Grid.Column="1"
                                                 Margin="0,0,9,0"
                                                 IsChecked="False"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="tsUnifiedCurve_Checked"
                                                 Unchecked="tsUnifiedCurve_Unchecked" />
                            </Grid>
                        </ui:CardExpander.Header>

                        <!-- Unified curve editor (expander content) -->
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Fan Curve Profile" />
                                        <ui:TextBlock Margin="0,2,0,2"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Choose between one of the default curves or create your own one" />
                                    </StackPanel>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <ComboBox x:Name="cbPreset"
                                                  Width="140"
                                                  FontSize="12"
                                                  SelectionChanged="cbPreset_SelectionChanged">
                                            <ComboBoxItem Content="Silent" />
                                            <ComboBoxItem Content="Balanced" />
                                            <ComboBoxItem Content="Performance" />
                                            <ComboBoxItem Content="Full Speed" />
                                            <ComboBoxItem Content="Off" />
                                            <ComboBoxItem Content="Custom" />
                                        </ComboBox>
                                    </Grid>
                                </Grid>
                                <Border Height="1" Margin="-58,12,-46,12"
        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <controls:EcFanCurveEditor x:Name="FanCurveEditor" Margin="0,8,4,0" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Unified temperature thresholds editor (standalone) -->
                    <ui:CardExpander x:Name="UnifiedTempsCard"
                                     Margin="0,0,0,8"
                                     Visibility="Collapsed"
                                     IsExpanded="False">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE7C3;" FontSize="20" Margin="6,0,6,0" />
                        </ui:CardExpander.Icon>
                            <ui:CardExpander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <ui:TextBlock FontTypography="Body" Text="Thermal thresholds" />
                                        <ui:TextBlock FontTypography="Caption"
                       Text="Set the temperature (°C) at which each fan speed zone activates"
                       TextWrapping="Wrap" />
                                    </StackPanel>
                                    
                                </Grid>
                            </ui:CardExpander.Header>
                            <StackPanel>

                            <UniformGrid x:Name="ugUnifiedTemps"
                                         Columns="11" Rows="1"
                                         Margin="0,12,0,12">
                                <!-- Row of zone labels -->
                            </UniformGrid>
                            <UniformGrid x:Name="ugUnifiedTempInputs"
                                         Columns="11" Rows="1" />
                            <ui:Button Margin="0,16,0,0"
                                       HorizontalAlignment="Right"
                                       Appearance="Transparent"
                                       Click="btnResetUnifiedTemps_Click"
                                       Padding="8">
                                <StackPanel Orientation="Horizontal">
                                        <ui:FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE7A7;" Margin="4,0,12,0" />
                                    <TextBlock Text="Reset to Default" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Smart Fan Mode toggle with expander (below Unified Fan Curve) -->
                        <ui:CardExpander x:Name="SmartFanCard"
                                     Margin="0,0,0,8"
                                     Visibility="Collapsed"
                                     IsExpanded="False"
                                     Expanded="SmartFanCard_Expanded"
                                     Collapsed="SmartFanCard_Collapsed"
                                     Loaded="SmartFanCard_Loaded">
                            <ui:CardExpander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconLucide Grid.Column="0"
                                       Kind="BrainCircuit"
                                       Width="20"
                                      Height="20"
                                       Margin="4,0,20,0"
                                       VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <ui:TextBlock FontTypography="Body" Text="Smart Fan Mode" />
                                        <ui:TextBlock FontTypography="Caption"
                                           Text="Both fans react to a single temperature source"
                                           TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ui:ToggleSwitch
                                        x:Name="tsSmartFanMode"
                                        Grid.Column="2"
                                        Margin="0,0,9,0"
                                        IsChecked="False"
                                        LabelPosition="Left"
                                        OnContent="On"
                                        OffContent="Off"
                                        Checked="tsSmartFanMode_Checked"
                                        Unchecked="tsSmartFanMode_Unchecked" />
                                </Grid>
                            </ui:CardExpander.Header>
                            <!-- Smart Fan Mode content (expander body) -->
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Temperature Source" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Select which sensor drives both fans" />
                                </StackPanel>
                                <ComboBox x:Name="cbxSmartFanTempSource"
                                          Grid.Column="1"
                                          Width="120"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          FontSize="12"
                                          SelectionChanged="cbxSmartFanTempSource_SelectionChanged">
                                    <ComboBoxItem Content="Max" />
                                    <ComboBoxItem Content="CPU" />
                                    <ComboBoxItem Content="GPU" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- CPU & GPU Fan curve editors side by side (visible when unified is OFF) -->
                    <StackPanel x:Name="SplitCurvePanel" Margin="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- CPU card -->
                        <ui:CardControl Grid.Row="0" Grid.Column="0">
                            <ui:CardControl.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:FontIcon Grid.Column="0"
                                                     FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                                     Glyph="&#xEEA1;"
                                                     FontSize="20"
                                                     Margin="4,0,22,0"
                                                     VerticalAlignment="Center" />
                                                <ui:TextBlock FontTypography="Body" 
                                                              Text="CPU"
                                                              Grid.Column="1"
                                                              VerticalAlignment="Center"/>
                                                <ComboBox x:Name="cbCpuPreset"
                                                  Grid.Column="2"
                                                  Width="120"
                                                  FontSize="12"
                                                  SelectionChanged="cbCpuPreset_SelectionChanged"
                                                  HorizontalAlignment="Right">
                                            <ComboBoxItem Content="Silent" />
                                            <ComboBoxItem Content="Balanced" />
                                            <ComboBoxItem Content="Performance" />
                                            <ComboBoxItem Content="Full Speed" />
                                            <ComboBoxItem Content="Off" />
                                            <ComboBoxItem Content="Custom" />
                                        </ComboBox>
                                    </Grid>
                                            <Border Height="1" 
                                                    Grid.Row="1"
                                                    Margin="-14,12,-14,12"
                                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                            <controls:EcFanCurveEditor x:Name="CpuFanCurveEditor"
                                                               Grid.Row="2" />
                                </Grid>
                            </ui:CardControl.Header>
                        </ui:CardControl>

                        <!-- GPU card -->
                        <ui:CardControl Grid.Row="0" Grid.Column="2">
                            <ui:CardControl.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:FontIcon Grid.Column="0"
                                                     FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                                     Glyph="&#xF211;"
                                                     FontSize="20"
                                                     Margin="4,0,22,0"
                                                     VerticalAlignment="Center" />
                                                <ui:TextBlock FontTypography="Body" 
                                                      Text="GPU"  
                                                      Grid.Column="1"
                                                      VerticalAlignment="Center"/>
                                                <ComboBox x:Name="cbGpuPreset"
                                                  Grid.Column="2"
                                                  Width="120"
                                                  FontSize="12"
                                                  SelectionChanged="cbGpuPreset_SelectionChanged"
                                                  HorizontalAlignment="Right">
                                                    <ComboBoxItem Content="Silent" />
                                                    <ComboBoxItem Content="Balanced" />
                                                    <ComboBoxItem Content="Performance" />
                                                    <ComboBoxItem Content="Full Speed" />
                                                    <ComboBoxItem Content="Off" />
                                                    <ComboBoxItem Content="Custom" />
                                                </ComboBox>
                                            </Grid>
                                            <Border Height="1" 
                                                    Grid.Row="1"
                                                    Margin="-14,12,-14,12"
                                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                            <controls:EcFanCurveEditor x:Name="GpuFanCurveEditor"
                                                               Grid.Row="2" />
                                </Grid>
                            </ui:CardControl.Header>
                        </ui:CardControl>

                            <!-- Merged temperature thresholds editor for both CPU and GPU -->
                            <ui:CardExpander Grid.Row="1"
                                         Grid.ColumnSpan="3"
                                         Margin="0,8,0,8"
                                         Header="Thermal Thresholds"
                                         IsExpanded="False">
                            <ui:CardExpander.Icon>
                                <ui:FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE7C3;" FontSize="20" Margin="6,0,6,0"/>
                            </ui:CardExpander.Icon>
                            <StackPanel>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Set the temperature (°C) at which each fan speed zone activates."
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />

                                <!-- Side by side: CPU left, GPU right -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- CPU -->
                                    <Border Grid.Column="0"
                                            BorderBrush="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12,8">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Text="CPU"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,8" />
                                            <UniformGrid x:Name="ugCpuTemps"
                                                         Columns="11" Rows="1"
                                                         Margin="0,12,0,2" />
                                            <UniformGrid x:Name="ugCpuTempInputs"
                                                         Columns="11" Rows="1"
                                                         Margin="0,12,0,12" />
                                            <ui:Button HorizontalAlignment="Right"
                                                       Appearance="Transparent"
                                                       Click="btnResetCpuTemps_Click"
                                                       Padding="8">
                                                <StackPanel Orientation="Horizontal">
                                                            <ui:FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE7A7;" Margin="0,0,12,0" />
                                                    <TextBlock Text="Reset to Default" />
                                                </StackPanel>
                                            </ui:Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- GPU -->
                                    <Border Grid.Column="2"
                                            BorderBrush="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12,8">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Text="GPU"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,8" />
                                            <UniformGrid x:Name="ugGpuTemps"
                                                         Columns="11" Rows="1"
                                                         Margin="0,12,0,2" />
                                            <UniformGrid x:Name="ugGpuTempInputs"
                                                         Columns="11" Rows="1"
                                                         Margin="0,12,0,12" />
                                            <ui:Button HorizontalAlignment="Right"
                                                       Appearance="Transparent"
                                                       Click="btnResetGpuTemps_Click"
                                                       Padding="8">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE7A7;" Margin="4,0,12,0" />
                                                            <TextBlock Text="Reset to Default" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </ui:Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ui:CardExpander>
                    </Grid>
                    </StackPanel>

                    <!-- Fan Turbo toggle -->
                    <ui:CardControl Margin="0,0,0,0"
                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                        <ui:CardControl.Icon>
                            <ui:FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xECAD;" FontSize="20" Margin="4,0,6,0" />
                        </ui:CardControl.Icon>
                        <ui:CardControl.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="Fan Turbo" />
                                    <ui:TextBlock FontTypography="Caption"
                                               Text="Force fans to maximum speed (avoid prolonged use)"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="tsTurbo"
                                                 Grid.Column="1"
                                                 Margin="0,0,9,0"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="tsTurbo_Checked"
                                                 Unchecked="tsTurbo_Unchecked" />
                            </Grid>
                        </ui:CardControl.Header>
                    </ui:CardControl>
                </StackPanel>

                <!-- Fallback when Uniwill EC is not available -->
                <ui:CardControl x:Name="UniwillUnavailable"
                                Margin="0,0,0,0"
                                Visibility="Collapsed">
                    <ui:CardControl.Icon>
                        <ui:FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE7BA;" FontSize="20" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Uniwill EC hardware not detected on this device. Fan controls are unavailable."
                                   TextWrapping="Wrap" />
                    </ui:CardControl.Header>
                </ui:CardControl>
            </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Row 1: Bottom bar — status (left) + buttons (right) -->
        <ui:Card x:Name="bottomBar" Grid.Row="1" MaxWidth="1052" HorizontalAlignment="Stretch" Margin="12,8,16,12" Padding="12,8" >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Status indicator (left) -->
                <Border Grid.Column="0"
                        Padding="12,8"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlFillColorSecondaryBrush}"
                        CornerRadius="4"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE946;"
                                     Margin="0,0,12,0"
                                     VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="Ready" />
                    </StackPanel>
                </Border>

                <!-- Action buttons (right) -->
                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <ui:Button x:Name="btnResetFanState"
                           MinWidth="150"
                           Margin="0,0,8,0"
                           Appearance="Danger"
                           Click="btnResetFanState_Click"
                           ToolTip="Force fans to 100% and reset the EC fan controller. Use if fans are stuck or behaving erratically.">
                    <StackPanel Orientation="Horizontal">
                            <ui:FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE7A7;" Margin="0,0,12,0" />
                        <TextBlock Text="Reset Fan State" />
                    </StackPanel>
                </ui:Button>
                <ui:Button x:Name="btnRestore"
                           MinWidth="138"
                           Margin="0,0,0,0"
                           Click="btnRestore_Click"
                           ToolTip="Undo all custom fan curves and let the system manage fan speeds automatically.">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE777;" Margin="0,0,12,0" />
                        <TextBlock Text="Restore Auto" />
                    </StackPanel>
                </ui:Button>
                </WrapPanel>
            </Grid>
        </ui:Card>

        <!-- Dark overlay for Adaptive Mode override (full-page, covers all rows) -->
        <Border x:Name="overlayAdaptiveWarning"
                Panel.ZIndex="10" 
                Grid.Row="0" 
                Grid.RowSpan="2" 
                Visibility="Collapsed" 
                Background="{DynamicResource SmokeFillColorDefaultBrush}"
                CornerRadius="4,0,0,0"/>

        <!-- Page-scoped snackbar presenter (above overlay) -->
        <ui:SnackbarPresenter x:Name="SnackbarPresenter"
                              Grid.Row="0" Grid.RowSpan="2"
                              Panel.ZIndex="11" MaxWidth="1080"/>
    </Grid>
</Page>
