<Page x:Class="Uniwill_Control_Utility.Views.Pages.OverlaySettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Uniwill_Control_Utility.Views.Pages"
      xmlns:helpers="clr-namespace:Uniwill_Control_Utility.Helpers"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance local:OverlaySettingsPage, IsDesignTimeCreatable=False}"
      d:Background="{DynamicResource ApplicationBackgroundBrush}"
      d:DesignHeight="1000"
      d:DesignWidth="800"
      Title="Overlay"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True"
      helpers:MouseWheelScrollBehavior.IsEnabled="True">

  
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Scrollable content -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      IsDeferredScrollingEnabled="False">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ScrollViewer.Style>

            <!-- Centered max-width layout container -->
            <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Page title block -->
                <StackPanel Grid.Row="0" Margin="0,24,0,0">
                    <TextBlock FontSize="26"
                               FontWeight="Medium"
                               Margin="16,0,36,0"
                               Text="Game Overlay" />
                    <TextBlock Margin="16,8,36,12"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Configure the click-through performance overlay and its global shortcuts."
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Row 1: Content cards -->
                <StackPanel x:Name="mainCon" Grid.Row="1" Margin="16,16,16,18">
                    <!-- Overlay behaviour -->
                    <ui:CardExpander Margin="0,0,0,8"
                                     IsExpanded="True">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF156;" FontSize="20" Margin="4,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Overlay behaviour" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Control when the overlay appears and configure global shortcuts." />
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <!-- Enable overlay -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Enable overlay" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Enable the game overlay and global shortcuts." />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="EnabledCheckBox"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Show on startup -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Show on startup" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Show the overlay when UCU starts." />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="StartupCheckBox"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Show or hide overlay hotkey -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Show or hide overlay" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Click the box and press the shortcut you want."
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox x:Name="ToggleOverlayHotkeyTextBox"
                                         Grid.Column="1"
                                         Width="180"
                                         HorizontalAlignment="Right"
                                         PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                         IsReadOnly="True"
                                         VerticalContentAlignment="Center" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Show or hide contents hotkey -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Show or hide contents" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Keeps the overlay window ready without polling sensors."
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox x:Name="ToggleContentsHotkeyTextBox"
                                         Grid.Column="1"
                                         Width="180"
                                         HorizontalAlignment="Right"
                                         PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                         IsReadOnly="True"
                                         VerticalContentAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Visible information -->
                    <ui:CardExpander Margin="0,0,0,8"
                                     IsExpanded="True">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF167;" FontSize="20" Margin="4,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Visible information" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Choose which sensor tiles appear in the overlay." />
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <!-- FPS -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="FPS and low FPS values" />
                                <ui:ToggleSwitch x:Name="ShowFpsCheckBox"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Frame times -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="Frame-time values" />
                                <ui:ToggleSwitch x:Name="ShowFrameTimesCheckBox"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- GPU sensors -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Grid.Column="0"
                                               FontTypography="Body"
                                               Text="GPU sensors"
                                               ToolTip="GPU polling is completely disabled when this is off." />
                                <ui:ToggleSwitch x:Name="ShowGpuCheckBox"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- CPU sensors -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="CPU sensors" />
                                <ui:ToggleSwitch x:Name="ShowCpuCheckBox"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Memory usage -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="Memory usage" />
                                <ui:ToggleSwitch x:Name="ShowMemoryCheckBox"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Battery tile -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="Battery tile" />
                                <ui:ToggleSwitch x:Name="ShowBatteryCheckBox"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Rolling graphs -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="Rolling graphs" />
                                <ui:ToggleSwitch x:Name="ShowGraphsCheckBox"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off" />
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Size and refresh rate -->
                    <ui:CardExpander Margin="0,0,0,8"
                                     IsExpanded="True">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF404;" FontSize="20" Margin="4,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Size and refresh rate" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Adjust the overlay scale, opacity, and polling interval." />
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <!-- Overlay scale -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Overlay scale" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Scale the overlay from 50% to 200%." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="ScaleValueText"
                                               FontSize="13"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <Slider x:Name="ScaleSlider"
                                            Width="140"
                                            Minimum="0.5"
                                            Maximum="2"
                                            TickFrequency="0.1"
                                            IsSnapToTickEnabled="True" />
                                </StackPanel>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Background opacity -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Background opacity" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Adjust the card panel background transparency." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="BackgroundOpacityValueText"
                                               FontSize="13"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <Slider x:Name="BackgroundOpacitySlider"
                                            Width="140"
                                            Minimum="0.25"
                                            Maximum="1"
                                            TickFrequency="0.05"
                                            IsSnapToTickEnabled="True" />
                                </StackPanel>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                            <!-- Content opacity -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Content opacity" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Adjust the text and graph transparency." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="ContentOpacityValueText"
                                               FontSize="13"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <Slider x:Name="ContentOpacitySlider"
                                            Width="140"
                                            Minimum="0.25"
                                            Maximum="1"
                                            TickFrequency="0.05"
                                            IsSnapToTickEnabled="True" />
                                </StackPanel>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Refresh interval -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Refresh interval" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Longer intervals reduce monitoring overhead."
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:NumberBox x:Name="RefreshIntervalNumberBox"
                                              Grid.Column="1"
                                              Width="180"
                                              HorizontalAlignment="Right"
                                              Minimum="100"
                                              Maximum="5000"
                                              SmallChange="100"
                                              MaxDecimalPlaces="0" />
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Hide when no game -->
                    <ui:CardExpander Margin="0,0,0,8"
                                     IsExpanded="True">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7C5;" FontSize="20" Margin="4,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Visibility" />
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Hide when no game" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Automatically hide the overlay when no game is detected."
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="HideWhenNoGameCheckBox"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off" />
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Row 1: Bottom bar -->
        <ui:Card Grid.Row="1" MaxWidth="1080" HorizontalAlignment="Stretch" Margin="16,8,16,12" Padding="12,8" SnapsToDevicePixels="True">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <ui:FontIcon x:Name="RtssStatusIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="16" VerticalAlignment="Center" Margin="4,0,12,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <TextBlock x:Name="RtssStatusText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Margin="0,0,8,0" Click="PreviewButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Eye20" FontSize="24" Margin="0,0,8,0" />
                            <TextBlock Text="Show" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Margin="0,0,8,0" Click="HideButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="EyeOff20" FontSize="24" Margin="0,0,8,0" />
                            <TextBlock Text="Hide" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Click="ApplyButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save20" FontSize="24" Margin="0,0,8,0" />
                            <TextBlock Text="Save" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</Page>
