<Page x:Class="Uniwill_Control_Utility.Views.Pages.OverlaySettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Uniwill_Control_Utility.Views.Pages"
      xmlns:helpers="clr-namespace:Uniwill_Control_Utility.Helpers"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance local:OverlaySettingsPage, IsDesignTimeCreatable=False}"
      d:Background="{DynamicResource ApplicationBackgroundBrush}"
      d:DesignHeight="1000"
      d:DesignWidth="800"
      Title="Overlay"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True"
      helpers:MouseWheelScrollBehavior.IsEnabled="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Scrollable content -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      IsDeferredScrollingEnabled="False">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ScrollViewer.Style>

            <!-- Centered max-width layout container -->
            <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Page title block -->
                <StackPanel Grid.Row="0" Margin="0,16,0,0">
                    <TextBlock FontSize="26"
                               FontWeight="Medium"
                               Margin="12,0,36,0"
                               Text="Game Overlay" />
                    <TextBlock Margin="12,8,36,12"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Configure the in-game performance overlay (via RTSS) and its global shortcuts."
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Row 1: Content cards -->
                <StackPanel x:Name="mainCon" Grid.Row="1" Margin="12,16,16,18">

                    <!-- Overlay behaviour -->
                    <ui:CardExpander Margin="0,0,0,8"
                                     IsExpanded="True">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF156;" FontSize="20" Margin="4,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Overlay behaviour" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Control when the overlay appears and configure global shortcuts" />
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <!-- Enable overlay -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Enable overlay" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Enable the in-game overlay and global shortcuts" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="EnabledCheckBox"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Show on startup -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Show on startup" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Show the overlay when UCU starts" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="StartupCheckBox"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Show or hide overlay hotkey -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Show or hide overlay" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Click the box and press the shortcut you want"
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox x:Name="ToggleOverlayHotkeyTextBox"
                                         Grid.Column="1"
                                         Width="180"
                                         HorizontalAlignment="Right"
                                         PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                         IsReadOnly="True"
                                         VerticalContentAlignment="Center" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Toggle hotkey (alias) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Toggle hotkey (alias)" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Second shortcut that also toggles the overlay"
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox x:Name="ToggleContentsHotkeyTextBox"
                                         Grid.Column="1"
                                         Width="180"
                                         HorizontalAlignment="Right"
                                         PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                         IsReadOnly="True"
                                         VerticalContentAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- OSD Metrics - single card with scrollable CheckBox list -->
                    <ui:Card Margin="0,0,0,8" Padding="0" SnapsToDevicePixels="True">
                        <StackPanel>
                            <!-- Header row -->
                            <Grid Margin="24,16,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Grid.Column="0"
						             FontFamily="Segoe Fluent Icons"
						             Glyph="&#xF404;"
						             FontSize="20"
						             Margin="-4,0,18,0"
						             VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <ui:TextBlock FontTypography="Body" Text="OSD Metrics"/>
                                    <ui:TextBlock Margin="0,2,0,0"
							              FontTypography="Caption"
							              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
							              Text="Select which metrics appear in the in-game overlay"/>
                                </StackPanel>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="0,12,0,0" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!--  CheckBox list -->
                            <StackPanel x:Name="MetricsCheckPanel" Margin="48,12,0,12">
                                <!-- populated from code-behind -->
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Refresh rate -->
                    <ui:CardControl x:Name="CardGpuPowerSavingPluggedIn"
                Margin="0,0,0,8">
                        <ui:CardControl.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE916;" FontSize="20" Margin="4,0,6,0" />
                        </ui:CardControl.Icon>
                        <ui:CardControl.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Refresh interval" />
                                    <ui:TextBlock Margin="0,2,0,0"
                   FontTypography="Caption"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="Longer intervals reduce monitoring overhead"
                   TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:NumberBox x:Name="RefreshIntervalNumberBox"
                                    Grid.Column="1"
                                    Width="180"
                                    HorizontalAlignment="Right"
                                    Minimum="100"
                                    Maximum="5000"
                                    SmallChange="100"
                                    MaxDecimalPlaces="0" />   
                            </Grid>
                        </ui:CardControl.Header>
                    </ui:CardControl>
                    


                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Row 1: Bottom bar -->
        <ui:Card Grid.Row="1" MaxWidth="1080" HorizontalAlignment="Stretch" Margin="12,8,16,12" Padding="12,8" SnapsToDevicePixels="True">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <ui:FontIcon x:Name="RtssStatusIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="16" VerticalAlignment="Center" Margin="4,0,12,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <TextBlock x:Name="RtssStatusText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Margin="0,0,8,0" Click="PreviewButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE890;"  Margin="0,0,12,0"/>
                            <TextBlock Text="Show" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Click="HideButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xED1A;"  Margin="0,0,12,0"/>
                            <TextBlock Text="Hide" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</Page>
