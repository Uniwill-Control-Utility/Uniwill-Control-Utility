<Page x:Class="Uniwill_Control_Utility.Views.Pages.OverlaySettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Uniwill_Control_Utility.Views.Pages"
      xmlns:helpers="clr-namespace:Uniwill_Control_Utility.Helpers"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance local:OverlaySettingsPage, IsDesignTimeCreatable=False}"
      d:Background="{DynamicResource ApplicationBackgroundBrush}"
      d:DesignHeight="1000"
      d:DesignWidth="800"
      Title="Overlay"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True"
      helpers:MouseWheelScrollBehavior.IsEnabled="True">

    <Page.Resources>
        <Style TargetType="{x:Type CheckBox}"
               BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter Property="Width" Value="20" />
                    <Setter Property="Height" Value="20" />
                    <Setter Property="MinWidth" Value="20" />
                    <Setter Property="MinHeight" Value="20" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Scrollable content -->
        <ScrollViewer Grid.Row="0"
                      x:Name="mainScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      IsDeferredScrollingEnabled="False">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Padding" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, RelativeSource={RelativeSource Self}}"
                                     Value="Visible">
                            <Setter Property="Padding" Value="0,0,8,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <!-- Centered max-width layout container -->
            <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Page title block -->
                <StackPanel Grid.Row="0" Margin="0,24,0,0">
                    <TextBlock FontSize="26"
                               FontWeight="Medium"
                               Margin="16,0,36,0"
                               Text="Game Overlay" />
                    <TextBlock Margin="16,8,36,12"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Configure the click-through performance overlay and its global shortcuts."
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Row 1: Content cards -->
                <StackPanel x:Name="mainCon" Grid.Row="1" Margin="16,16,16,18">
                    <!-- Overlay behaviour -->
                    <ui:Card Margin="0,0,0,8"
                             RenderOptions.EdgeMode="Aliased"
                             SnapsToDevicePixels="True">
                        <StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Body" 
                                              Text="Overlay behaviour"/>
                                <ui:TextBlock Margin="0,2,0,0"
                                              FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                              Text="Control when the overlay appears and configure global shortcuts."/>
                            </StackPanel>
                            <Border Height="1" Margin="-14,12,-14,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                            <CheckBox x:Name="EnabledCheckBox"
                                      Content="Enable the game overlay and global shortcuts" />

                            <CheckBox x:Name="StartupCheckBox"
                                      Margin="0,8,0,0"
                                      Content="Show the overlay when UXTU starts" />

                            <!-- Divider -->
                            <Border Height="1" Margin="-14,12,-14,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Show or hide overlay -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Show or hide overlay" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Click the box and press the shortcut you want."
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox x:Name="ToggleOverlayHotkeyTextBox"
                                         Grid.Column="1"
                                         Width="180"
                                         HorizontalAlignment="Right"
                                         PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                         IsReadOnly="True"
                                         VerticalContentAlignment="Center" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-14,12,-14,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Show or hide contents -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Show or hide contents" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Keeps the overlay window ready without polling sensors."
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox x:Name="ToggleContentsHotkeyTextBox"
                                         Grid.Column="1"
                                         Width="180"
                                         HorizontalAlignment="Right"
                                         PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                         IsReadOnly="True"
                                         VerticalContentAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- Visible information -->
                    <ui:Card Margin="0,0,0,8"
                             RenderOptions.EdgeMode="Aliased"
                             SnapsToDevicePixels="True">
                        <StackPanel>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Visible information" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Choose which sensor tiles appear in the overlay." />
                            </StackPanel>
                            <Border Height="1" Margin="-14,12,-14,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                            <UniformGrid Margin="0,4,0,0" Columns="2">
                                <CheckBox x:Name="ShowFpsCheckBox"
                                          Margin="0,4"
                                          Content="FPS and low FPS values" />
                                <CheckBox x:Name="ShowFrameTimesCheckBox"
                                          Margin="0,4"
                                          Content="Frame-time values" />
                                <CheckBox x:Name="ShowGpuCheckBox"
                                          Margin="0,4"
                                          Content="GPU sensors"
                                          ToolTip="GPU polling is completely disabled when this is off." />
                                <CheckBox x:Name="ShowCpuCheckBox"
                                          Margin="0,4"
                                          Content="CPU sensors" />
                                <CheckBox x:Name="ShowMemoryCheckBox"
                                          Margin="0,4"
                                          Content="Memory usage" />
                                <CheckBox x:Name="ShowBatteryCheckBox"
                                          Margin="0,4"
                                          Content="Battery tile" />
                                <CheckBox x:Name="ShowGraphsCheckBox"
                                          Margin="0,4"
                                          Content="Rolling graphs" />
                            </UniformGrid>
                        </StackPanel>
                    </ui:Card>

                    <!-- Size and refresh rate -->
                    <ui:Card Margin="0,0,0,8"
                             RenderOptions.EdgeMode="Aliased"
                             SnapsToDevicePixels="True">
                        <StackPanel>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Size and refresh rate" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Adjust the overlay scale, opacity, and polling interval." />
                            </StackPanel>
                            <Border Height="1" Margin="-14,12,-14,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                            <!-- Overlay scale -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Overlay scale" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Scale the overlay from 50% to 200%." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="ScaleValueText"
                                               FontSize="13"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <Slider x:Name="ScaleSlider"
                                            Width="140"
                                            Minimum="0.5"
                                            Maximum="2"
                                            TickFrequency="0.1"
                                            IsSnapToTickEnabled="True" />
                                </StackPanel>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-14,12,-14,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Panel opacity -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Panel opacity" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Adjust the overlay panel transparency." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="OpacityValueText"
                                               FontSize="13"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <Slider x:Name="OpacitySlider"
                                            Width="140"
                                            Minimum="0.25"
                                            Maximum="1"
                                            TickFrequency="0.05"
                                            IsSnapToTickEnabled="True" />
                                </StackPanel>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-14,12,-14,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Refresh interval -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Refresh interval" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Longer intervals reduce monitoring overhead."
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:NumberBox x:Name="RefreshIntervalNumberBox"
                                              Grid.Column="1"
                                              Width="180"
                                              HorizontalAlignment="Right"
                                              Minimum="100"
                                              Maximum="5000"
                                              SmallChange="100"
                                              MaxDecimalPlaces="0" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Row 1: Bottom bar -->
        <Grid Grid.Row="1" MaxWidth="1080" HorizontalAlignment="Stretch" Margin="16,12,36,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Width="50" Margin="0,0,8,0" ToolTip="Show overlay" Click="PreviewButton_Click">
                    <ui:SymbolIcon Symbol="Eye20" FontSize="24" />
                </ui:Button>
                <ui:Button Width="50" Margin="0,0,8,0" ToolTip="Hide overlay" Click="HideButton_Click">
                    <ui:SymbolIcon Symbol="EyeOff20" FontSize="24" />
                </ui:Button>
                <ui:Button Width="50" ToolTip="Save overlay settings" Click="ApplyButton_Click">
                    <ui:SymbolIcon Symbol="Save20" FontSize="24" />
                </ui:Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
