                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Fan Speed" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Select the fan duty cycle for this game. Higher = more airflow, more noise" />
                                    </StackPanel>
                                    <ComboBox Name="cbxWcFanSpeed"
                                              Grid.Column="1"
                                              MinWidth="160"
                                              Margin="4,0,0,0"
