                                    </StackPanel>
                                </Grid>

                                <!-- Right side: Toggle Switch -->
                                <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                                    <ui:ToggleSwitch x:Name="cbxEcFanEnabled"
                             Margin="0,0,9,0"
                             LabelPosition="Left"
                             OnContent="On"
                             OffContent="Off"
                             ToolTip="Enable EC fan controls for this game"
                             Checked="cbxEcFanEnabled_Toggled"
                             Unchecked="cbxEcFanEnabled_Toggled" />
                                </StackPanel>
                            </Grid>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <!-- Fan Curve Mode selector -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock FontTypography="Body" Text="Fan Curve Mode" />
                                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="16" Margin="6,0,0,-2" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ToolTip="Select Unified (single curve) or Split (separate CPU/GPU curves)." VerticalAlignment="Bottom" />
                                    </StackPanel>
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Unified uses a single curve, while Split allows separate CPU and GPU curves" />
                                </StackPanel>
                                <ComboBox Name="cbxEcFanMode" Grid.Column="1" Width="180" HorizontalAlignment="Right" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="cbxEcFanMode_SelectionChanged">
                                    <ComboBoxItem>Unified</ComboBoxItem>
                                    <ComboBoxItem>Split (CPU + GPU)</ComboBoxItem>
                                </ComboBox>
                            </Grid>

                            <!-- Unified preset selector -->
                            <StackPanel Name="spEcFanUnified" Visibility="Visible">
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Profile -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="Fan Curve Profile" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="16" Margin="6,0,0,-2" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ToolTip="Select a fan curve profile for this game." VerticalAlignment="Bottom" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Preset or custom fan curve applied to both CPU and GPU" />
                                    </StackPanel>
                                    <ComboBox Name="cbxEcFanPreset" Grid.Column="1" Width="180" HorizontalAlignment="Right" VerticalAlignment="Center" SelectedIndex="1">
                                        <ComboBoxItem>Silent</ComboBoxItem>
                                        <ComboBoxItem>Balanced</ComboBoxItem>
                                        <ComboBoxItem>Performance</ComboBoxItem>
                                        <ComboBoxItem>Full Speed</ComboBoxItem>
                                        <ComboBoxItem>Off</ComboBoxItem>
                                        <ComboBoxItem>Custom</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>

                            <!-- Split CPU/GPU preset selectors -->
                            <StackPanel Name="spEcFanSplit" Visibility="Collapsed">
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- CPU Fan Curve -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="CPU Fan Curve" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Fan curve driven by CPU temperature" />
                                    </StackPanel>
                                    <ComboBox Name="cbxEcFanCpuPreset" Grid.Column="1" Width="180" HorizontalAlignment="Right" VerticalAlignment="Center" SelectedIndex="1">
                                        <ComboBoxItem>Silent</ComboBoxItem>
                                        <ComboBoxItem>Balanced</ComboBoxItem>
                                        <ComboBoxItem>Performance</ComboBoxItem>
                                        <ComboBoxItem>Full Speed</ComboBoxItem>
                                        <ComboBoxItem>Off</ComboBoxItem>
                                        <ComboBoxItem>Custom</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- GPU Fan Curve -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="GPU Fan Curve" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Fan curve driven by GPU temperature" />
                                    </StackPanel>
                                    <ComboBox Name="cbxEcFanGpuPreset" Grid.Column="1" Width="180" HorizontalAlignment="Right" VerticalAlignment="Center" SelectedIndex="1">
                                        <ComboBoxItem>Silent</ComboBoxItem>
                                        <ComboBoxItem>Balanced</ComboBoxItem>
                                        <ComboBoxItem>Performance</ComboBoxItem>
                                        <ComboBoxItem>Full Speed</ComboBoxItem>
                                        <ComboBoxItem>Off</ComboBoxItem>
                                        <ComboBoxItem>Custom</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Keyboard RGB - per-game keyboard backlight control -->
                    <ui:CardExpander Name="sdKeyboard"
                        IsEnabled="True"
                        IsExpanded="False"
                        Margin="0,0,0,8"
                        Expanded="sdKeyboard_Expanded">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE92E;" FontSize="20" Margin="6,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="14"
                                        Text="Keyboard RGB" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="Per-game keyboard backlight control for ITE HID keyboards."/>
                                </StackPanel>
                                <ui:ToggleSwitch Name="cbxKbEnabled" Grid.Column="1" VerticalAlignment="Center"
                                    Margin="0,0,9,0"
                                    LabelPosition="Left"
                                    OnContent="On"
                                    OffContent="Off"
                                    ToolTip="Enable keyboard RGB controls for this game"
                                    Checked="cbxKbEnabled_Toggled"
                                    Unchecked="cbxKbEnabled_Toggled" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <!-- Mode: Effects / Per-Key -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Mode" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Choose between animation effects or per-key color control" />
                                </StackPanel>
                                <ComboBox Name="cbxKbMode" Grid.Column="1" Width="180" HorizontalAlignment="Right" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="cbxKbMode_SelectionChanged">
                                    <ComboBoxItem>Effects</ComboBoxItem>
                                    <ComboBoxItem>Per-Key RGB</ComboBoxItem>
                                </ComboBox>
                            </Grid>

                            <!-- Effect controls (visible in Effects mode) -->
                            <StackPanel Name="spKbEffectControls" Visibility="Collapsed">
                                <!-- Divider before Effect -->
                                <Border Name="sepKbEffect" Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                                <!-- Effect Type -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Effect" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Choose an animation effect" />
                                    </StackPanel>
                                    <ComboBox Name="cbxKbEffect" Grid.Column="1" Width="180" HorizontalAlignment="Right" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="cbxKbEffect_SelectionChanged">
                                        <ComboBoxItem>Static</ComboBoxItem>
                                        <ComboBoxItem>Breathing</ComboBoxItem>
                                        <ComboBoxItem>Wave</ComboBoxItem>
                                        <ComboBoxItem>Reactive</ComboBoxItem>
                                        <ComboBoxItem>Rainbow</ComboBoxItem>
                                        <ComboBoxItem>Ripple</ComboBoxItem>
                                        <ComboBoxItem>Touch Ripple</ComboBoxItem>
                                        <ComboBoxItem>Marquee</ComboBoxItem>
                                        <ComboBoxItem>Raindrop</ComboBoxItem>
                                        <ComboBoxItem>Aurora</ComboBoxItem>
                                        <ComboBoxItem>Touch Aurora</ComboBoxItem>
                                        <ComboBoxItem>Touch Spark</ComboBoxItem>
                                        <ComboBoxItem>Spark</ComboBoxItem>
                                        <ComboBoxItem>Gaming Mode</ComboBoxItem>
                                    </ComboBox>
                                </Grid>

                                <!-- Divider before Color -->
                                <Border Name="sepKbColor" Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" Visibility="Collapsed" />

                                <!-- Color (visible for single-color effects) -->
                                <Grid Name="spKbColor" Visibility="Visible">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Color" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Single color for static and single-color effects" />
                                    </StackPanel>
                                    <controls:ColorPickerControl x:Name="KbColorPicker" Grid.Column="1"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Center"
                                                                     SelectedColor="Aqua"
                                                                     ColorChangedDelayed="KbColorPicker_ColorChangedDelayed" />
                                </Grid>

                                <!-- Multi-color picker (visible for multi-color effects) — shares sepKbColor -->
                                <Grid Name="spKbMultiColor" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Name="tbKbMultiColorTitle" Text="Effect Colors" />
                                        <ui:TextBlock x:Name="tbKbMultiColorSubtitle" Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="7 colors required for this effect" />
                                    </StackPanel>
                                    <controls:KeyboardMultiColorPickerControl x:Name="KbMultiColorPicker" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" ColorsChanged="KbMultiColorPicker_ColorsChanged"/>
                                </Grid>

                                <!-- Divider before Direction -->
                                <Border Name="sepKbDirection" Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" Visibility="Collapsed" />

                                <!-- Direction (Wave only) -->
                                <Grid Name="grKbDirection" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Direction" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Animation direction for Wave effect" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ui:Button x:Name="btnKbDirLeftRight" Width="40" Height="36" Margin="0,0,4,0"
                                                   Appearance="Transparent" Click="KbDirectionButton_Click" Tag="LeftRight">
                                            <TextBlock Text="→" FontSize="18" HorizontalAlignment="Center"/>
                                        </ui:Button>
                                        <ui:Button x:Name="btnKbDirRightLeft" Width="40" Height="36" Margin="0,0,4,0"
                                                   Appearance="Transparent" Click="KbDirectionButton_Click" Tag="RightLeft">
                                            <TextBlock Text="←" FontSize="18" HorizontalAlignment="Center"/>
                                        </ui:Button>
                                        <ui:Button x:Name="btnKbDirDownUp" Width="40" Height="36" Margin="0,0,4,0"
                                                   Appearance="Transparent" Click="KbDirectionButton_Click" Tag="DownUp">
                                            <TextBlock Text="↑" FontSize="18" HorizontalAlignment="Center"/>
                                        </ui:Button>
                                        <ui:Button x:Name="btnKbDirUpDown" Width="40" Height="36" Margin="0,0,4,0"
                                                   Appearance="Transparent" Click="KbDirectionButton_Click" Tag="UpDown">
                                            <TextBlock Text="↓" FontSize="18" HorizontalAlignment="Center"/>
                                        </ui:Button>
                                        <ui:Button x:Name="btnKbDiagBRTL" Width="40" Height="36" Margin="0,0,4,0"
                                                   Appearance="Transparent" Click="KbDirectionButton_Click" Tag="DiagonalBottomRightToTopLeft">
                                            <TextBlock Text="↖" FontSize="18" HorizontalAlignment="Center"/>
                                        </ui:Button>
                                        <ui:Button x:Name="btnKbDiagBLTR" Width="40" Height="36" Margin="0,0,0,0"
                                                   Appearance="Transparent" Click="KbDirectionButton_Click" Tag="DiagonalBottomLeftToTopRight">
                                            <TextBlock Text="↗" FontSize="18" HorizontalAlignment="Center"/>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Divider before Speed -->
                                <Border Name="sepKbSpeed" Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" Visibility="Collapsed" />

                                <!-- Speed (hidden for Static, Rainbow, GamingMode) -->
                                <Grid Name="spKbSpeed" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Speed" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Animation speed (1=fastest, 10=slowest)" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Name="tbKbSpeedValue" Width="30" HorizontalAlignment="Center" Margin="0,0,8,0" Text="5" />
                                        <Slider Name="sdKbSpeed" Width="140" Maximum="10" Minimum="1" TickFrequency="1" TickPlacement="Both" IsSnapToTickEnabled="True" Value="5" IsMoveToPointEnabled="False" ValueChanged="sdKbSpeed_ValueChanged"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Divider before Per-Key controls -->
                            <Border Name="sepKbPerKey" Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Per-Key controls (visible in Per-Key mode) -->
                            <StackPanel Name="spKbPerKeyNote" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Per-Key RGB Mode" />
                                        <ui:TextBlock Margin="0,2,0,4"
                                            FontTypography="Caption"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="Configure individual key colors for this profile"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ui:Button Name="btnKbEditPerKey"
                                                Grid.Column="1"
                                            Appearance="Primary"
                                            Content="Edit Per-Key Colors"
                                            HorizontalAlignment="Left"
                                            Click="btnKbEditPerKey_Click" />
                                </Grid>
                            </StackPanel>

                            <!-- Divider before Brightness (shared by both modes) -->
                            <Border Name="sepKbBrightness" Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Brightness (shared by both Effects and Per-Key modes) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Brightness" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Backlight brightness level 1-7" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Name="tbKbBrightnessValue" Width="30" HorizontalAlignment="Center" Margin="0,0,8,0" Text="5" />
                                    <Slider Name="sdKbBrightness" Width="140" Maximum="7" Minimum="1" TickFrequency="1" TickPlacement="Both" IsSnapToTickEnabled="True" Value="5" IsMoveToPointEnabled="False" ValueChanged="sdKbBrightness_ValueChanged"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Light Bar - only visible on supported hardware -->
                    <ui:CardExpander x:Name="sdLightBar"
                                    Visibility="Collapsed"
                                    IsEnabled="True"
                                    IsExpanded="False"
                                    Margin="0,0,0,8">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xED39;" FontSize="20" Margin="6,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Light Bar" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Per-game front light bar control"
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ui:ToggleSwitch x:Name="cbxLbEnabled"
                                                     Margin="0,0,9,0"
                                                     LabelPosition="Left"
                                                     OnContent="On"
                                                     OffContent="Off"
                                                     ToolTip="Enable Light Bar controls for this game"
                                                     Checked="cbxLbEnabled_Toggled"
                                                     Unchecked="cbxLbEnabled_Toggled" />
                                </StackPanel>
                            </Grid>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <!-- Light Bar Power -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Power" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Turn the front light bar on or off" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="AdpTsLightBarPower"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 IsChecked="True"
                                                 Checked="AdpTsLightBarPower_Toggled"
                                                 Unchecked="AdpTsLightBarPower_Toggled" />
                            </Grid>
                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                            <!-- Color -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Color" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Choose the light bar color" />
                                </StackPanel>
                                <controls:ColorPickerControl x:Name="AdpLbColorPicker"
                                                             HorizontalAlignment="Right"
                                                             VerticalAlignment="Center"
                                                             SelectedColor="Aqua"
                                                             ColorChangedDelayed="AdpLbColorPicker_ColorChangedDelayed" />
                            </Grid>
                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                            <!-- Brightness -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Brightness" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Adjust the light bar brightness level" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="AdpLbBrightnessValueText"
                                               Width="35"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="100" />
                                    <Slider x:Name="AdpLbBrightnessSlider"
                                            Width="140"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="100"
                                            TickFrequency="10"
                                            IsSnapToTickEnabled="True"
                                            IsMoveToPointEnabled="False"
                                            TickPlacement="Both"
                                            ValueChanged="AdpLbBrightnessSlider_ValueChanged" />
                                </StackPanel>
                            </Grid>
                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                            <!-- Effect selector -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Effect" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Select a lighting effect for the light bar" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <ComboBox x:Name="AdpLbEffect"
                                              Width="180"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              SelectedIndex="0"
                                              SelectionChanged="AdpLbEffect_SelectionChanged">
                                        <ComboBoxItem>Static</ComboBoxItem>
                                        <ComboBoxItem>Breathing</ComboBoxItem>
                                        <ComboBoxItem>Wave</ComboBoxItem>
                                        <ComboBoxItem>Loading</ComboBoxItem>
                                        <ComboBoxItem>Marquee</ComboBoxItem>
                                        <ComboBoxItem>Meteor</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <!-- Speed (hidden for Static) -->
                            <StackPanel x:Name="AdpSpLbSpeed" Visibility="Collapsed">
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Speed" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Control the animation speed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="AdpLbSpeedValueText"
                                                   Width="30"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Text="5" />
                                        <Slider x:Name="AdpLbSpeedSlider"
                                                Width="140"
                                                Minimum="0"
                                                Maximum="11"
                                                Value="5"
                                                IsSnapToTickEnabled="True"
                                                IsMoveToPointEnabled="False"
                                                TickPlacement="Both"
                                                ValueChanged="AdpLbSpeedSlider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ui:CardExpander>

                    <TextBlock Name="tbLog" Margin="0,9,0,0"></TextBlock>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

        <!-- Row 1: Bottom bar -->
        <ui:Card x:Name="AdpBottomBar"
                 Grid.Row="1"
                 MaxWidth="1080"
                 HorizontalAlignment="Stretch"
                 Margin="12,8,16,12"
                 Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Games/Apps selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="Games/Apps:" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Margin="2,0,12,0"/>
                    <ComboBox Width="225" Name="cbxPowerPreset" SelectionChanged="cbxPowerPreset_SelectionChanged" Height="37" Margin="0,0,9,0"/>
                    <ui:Button Name="btnReloadApps" ToolTip="Updates dropdown list with games/apps" Click="btnReloadApps_Click">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE777;" FontSize="16"/>
                    </ui:Button>
                </StackPanel>

                <!-- Center: Boost mode label (hidden by default) -->
                <ui:TextBlock x:Name="lblAdpPresetMode"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                               Visibility="Collapsed" />

                <!-- Right: Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Polling Rate" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Visibility="Collapsed"/>
                    <ui:NumberBox x:Name="nudPolling" Minimum="1" Maximum="8" Value="2" SmallChange="0.05" MaxDecimalPlaces="2" Margin="0,0,12,0" Visibility="Collapsed"/>
                    <CheckBox Name="cbAutoSwitch" Content="Auto switch app profile" VerticalAlignment="Center" Click="cbAutoSwitch_Click" Margin="0,0,12,0" Visibility="Collapsed"/>
                    <CheckBox Name="cbExcludeFromSwitching" Content="Exclude from switching" VerticalAlignment="Center" FontSize="13" Margin="0,0,12,0"/>
                    <ui:Button Width="50" 
                               Name="btnSave" 
                               ToolTip="Save current settings" 
                               Click="btnSave_Click" 
                               IsEnabled="False" 
                               Margin="0,0,8,0"
                               Icon="{ui:FontIcon FontFamily='Segoe Fluent Icons', Glyph='&#xE74E;', FontSize=16}"/>
                    <ui:Button Name="btnStart" Click="btnStart_Click" IsEnabled="False"
                        ToolTip="Start Adaptive Mode"
                        Icon="{ui:FontIcon FontFamily='Segoe Fluent Icons', Glyph='&#xE768;', FontSize=16}"/>
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</Page>
