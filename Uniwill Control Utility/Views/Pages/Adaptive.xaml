                                    Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                    Visibility="Collapsed" />
                            <!-- Row: RGB Color (hidden for Off/Colorful/Breathe Color) -->
                            <Grid x:Name="spWcRgbColor">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="RGB Color" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Select the RGB color for this game" />
                                </StackPanel>
                                <ComboBox Name="cbxWcRgbColor"
