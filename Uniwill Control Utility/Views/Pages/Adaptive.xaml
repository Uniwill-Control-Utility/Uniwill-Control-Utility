<Page x:Class="Uniwill_Control_Utility.Views.Pages.Adaptive"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Uniwill_Control_Utility.Views.Pages"
      xmlns:controls="clr-namespace:Uniwill_Control_Utility.Views.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      d:DataContext="{d:DesignInstance local:Adaptive, IsDesignTimeCreatable=False}"
      d:Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d"
      d:DesignHeight="1000" d:DesignWidth="800"
      Title="Adaptive Mode"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      ScrollViewer.CanContentScroll="False"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Page.Resources>
        <Style TargetType="{x:Type CheckBox}"
               BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter Property="Width" Value="20" />
                    <Setter Property="Height" Value="20" />
                    <Setter Property="MinWidth" Value="20" />
                    <Setter Property="MinHeight" Value="20" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Scrollable content -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      IsDeferredScrollingEnabled="False">
                <ScrollViewer.Style>
                    <Style TargetType="{x:Type ScrollViewer}"
                        BasedOn="{StaticResource {x:Type ScrollViewer}}">
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ScrollViewer.Style>

                    <!-- Centered max-width layout container -->
                    <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Page title block -->
                <StackPanel Grid.Row="0" Margin="14,16,16,12">
                            <TextBlock FontSize="26"
                                       FontWeight="Medium"
                                       Text="Adaptive Mode" />
                            <TextBlock Margin="0,8,0,8"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Per-game profile presets with automatic switching."
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Row 1: Content cards -->
                        <StackPanel x:Name="mainCon" Grid.Row="1" Margin="12,16,16,18">


                    <!-- CPU Settings -->
                    <ui:CardExpander x:Name="sdCpuSettings"
                                    IsEnabled="True"
                                    IsExpanded="False"
                                    Margin="0,0,0,8">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE950;" FontSize="20" Margin="6,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="CPU Settings" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Per-game CPU power, thermal, and voltage tuning"
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ui:ToggleSwitch x:Name="cbxCpuEnabled"
                                                     Margin="0,0,9,0"
                                                     LabelPosition="Left"
                                                     OnContent="On"
                                                     OffContent="Off"
                                                     ToolTip="Enable CPU controls for this game"
                                                     Checked="cbxCpuEnabled_Toggled"
                                                     Unchecked="cbxCpuEnabled_Toggled" />
                                </StackPanel>
                            </Grid>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <!-- Sustained Power Limit (SPL) - AMD only -->
                            <Grid x:Name="AdpGridSustained">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Sustained (SPL)" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Sustained power limit (SMU slow-limit)" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="AdpLblSustained"
                                               Width="48"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Text="75 W" />
                                    <Slider x:Name="AdpSdSustained" Width="140" Maximum="255" Minimum="35" Value="75" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" ValueChanged="AdpSlider_ValueChanged" />
                                </StackPanel>
                            </Grid>
                            <!-- Divider -->
                            <Border x:Name="AdpDividerAfterSustained" Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                            <!-- Boost Power Limit (FPL) - AMD only -->
                            <Grid x:Name="AdpGridBoost">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Boost (FPL)" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Boost power limit (SMU fast-limit)" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="AdpLblBoost"
                                               Width="48"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Text="85 W" />
                                    <Slider x:Name="AdpSdBoost" Width="140" Maximum="255" Minimum="35" Value="85" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" ValueChanged="AdpSlider_ValueChanged" />
                                </StackPanel>
                            </Grid>
                            <!-- Divider -->
                            <Border x:Name="AdpDividerAfterBoost" Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                            <!-- TjMax (AMD only) -->
                            <Grid x:Name="AdpGridTjMax">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="TjMax" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Thermal throttle temperature" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="AdpLblTjMax"
                                               Width="48"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Text="95 Â°C" />
                                    <Slider x:Name="AdpSdTjMax" Width="140" Maximum="105" Minimum="70" Value="95" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" ValueChanged="AdpSlider_ValueChanged" />
                                </StackPanel>
                            </Grid>
                            <!-- CO controls panel (hidden when EnableCpuVoltageControl is OFF) -->
                            <StackPanel x:Name="AdpCoControlsPanel" Visibility="Collapsed">
                            <!-- Divider -->
                            <Border x:Name="AdpDividerBeforeCoControls" Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                            <!-- Curve Optimizer mode selection (AMD only) -->
                            <Grid x:Name="AdpGridCoMode">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="CO Mode" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Unified or per-CCD offset" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="2,0">
                                    <RadioButton x:Name="AdpRbCoUnified"
                                                 GroupName="AdpCoMode"
                                                 Content="Unified"
                                                 IsChecked="True"
                                                 Margin="0,0,12,0"
                                                 HorizontalContentAlignment="Center"
                                                 FontSize="13"
                                                 Click="AdpRbCoMode_Click"
                                                 Width="90"
                                                 MinWidth="20"/>
                                    <RadioButton x:Name="AdpRbCoPerCcd"
                                                 GroupName="AdpCoMode"
                                                 Content="Per-CCD"
                                                 HorizontalContentAlignment="Center"
                                                 FontSize="13"
                                                 Click="AdpRbCoMode_Click"
                                                 Width="90"
                                                 MinWidth="20"/>
                                </StackPanel>
                            </Grid>
                            <!-- Divider (visible only in Unified mode) -->
                            <Border x:Name="AdpDividerCoMode" Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                            <!-- Unified voltage offset slider (AMD only) -->
                            <Grid x:Name="AdpGridCoUnified">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="CO Offset" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="All-core offset (-50 to 0)" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="AdpLblCoUnified"
                                               Width="24"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Text="0" />
                                    <Slider x:Name="AdpSdCoUnified" Width="140" Maximum="0" Minimum="-50" Value="0" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" ValueChanged="AdpSlider_ValueChanged" />
                                </StackPanel>
                            </Grid>
                            <!-- CCD 0 Voltage Offset (AMD only) -->
                            <Grid x:Name="AdpGridCoCcd0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="CCD 0 Offset" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="CCD 0 voltage offset (-50 to 0)" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="AdpLblCoCcd0"
                                               Width="24"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Text="0" />
                                    <Slider x:Name="AdpSdCoCcd0" Width="140" Maximum="0" Minimum="-50" Value="0" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" ValueChanged="AdpSlider_ValueChanged" />
                                </StackPanel>
                            </Grid>
                            <!-- Divider (visible only in Per-CCD mode) -->
                            <Border x:Name="AdpDividerCoPerCcd" Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                            <!-- CCD 1 Voltage Offset (AMD only) -->
                            <Grid x:Name="AdpGridCoCcd1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="CCD 1 Offset" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="CCD 1 voltage offset (-50 to 0)" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="AdpLblCoCcd1"
                                               Width="24"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Text="0" />
                                    <Slider x:Name="AdpSdCoCcd1" Width="140" Maximum="0" Minimum="-50" Value="0" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" ValueChanged="AdpSlider_ValueChanged" />
                                </StackPanel>
                            </Grid>
                            <!-- Divider (visible only in Per-CCD mode, after CCD1) -->
                            <Border x:Name="AdpDividerCoAfterCcd1" Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                            </StackPanel>
                            <!-- Intel PL1 -->
                            <Grid x:Name="AdpGridIntelPl1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="PL1" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Sustained power limit" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="AdpLblIntelPl1"
                                               Width="48"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Text="45 W" />
                                    <Slider x:Name="AdpSdIntelPl1" Width="140" Maximum="200" Minimum="5" Value="45" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" ValueChanged="AdpSlider_ValueChanged" />
                                </StackPanel>
                            </Grid>
                            <!-- Divider -->
                            <Border x:Name="AdpDividerAfterIntelPl1" Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                            <!-- Intel PL2 -->
                            <Grid x:Name="AdpGridIntelPl2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="PL2" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Boost power limit" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="AdpLblIntelPl2"
                                               Width="48"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Text="60 W" />
                                    <Slider x:Name="AdpSdIntelPl2" Width="140" Maximum="200" Minimum="5" Value="60" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" ValueChanged="AdpSlider_ValueChanged" />
                                </StackPanel>
                            </Grid>
                            <!-- Divider -->
                            <Border x:Name="AdpDividerAfterIntelPl2" Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                            <!-- Intel CPU Undervolt -->
                            <Grid x:Name="AdpGridIntelUndervolt">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="CPU Undervolt" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="CPU voltage offset" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="AdpLblIntelUndervolt"
                                               Width="48"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Text="0 mV" />
                                    <Slider x:Name="AdpSdIntelUndervolt" Width="140" Maximum="0" Minimum="-100" Value="0" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" ValueChanged="AdpSlider_ValueChanged" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- GPU Settings -->
                    <ui:CardExpander x:Name="sdGpuSettings"
                                    Visibility="Collapsed"
                                    IsEnabled="True"
                                    IsExpanded="False"
                                    Margin="0,0,0,8">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF211;" FontSize="20" Margin="6,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="GPU Settings" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Per-game GPU power, clock offsets, and curve editing"
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ui:ToggleSwitch x:Name="cbxGpuEnabled"
                                                     Margin="0,0,9,0"
                                                     LabelPosition="Left"
                                                     OnContent="On"
                                                     OffContent="Off"
                                                     ToolTip="Enable GPU controls for this game"
                                                     Checked="cbxGpuEnabled_Toggled"
                                                     Unchecked="cbxGpuEnabled_Toggled" 
                                                     RenderOptions.EdgeMode="Unspecified"
                                                     RenderOptions.BitmapScalingMode="HighQuality"
                                                     SnapsToDevicePixels="False"/>
                                </StackPanel>
                            </Grid>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <!-- GPU TGP -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="GPU TGP" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Base power limit" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="AdpLblNvPower"
                                               Width="48"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Text="150 W" />
                                    <Slider x:Name="AdpSdNvPower" Width="140" Maximum="225" Minimum="0" Value="150" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" ValueChanged="AdpSlider_ValueChanged" />
                                </StackPanel>
                            </Grid>
                            <!-- Dynamic Boost Controls (hidden when GPU Power Boost is ON) -->
                            <StackPanel x:Name="AdpDynamicBoostPanel">
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Dynamic Boost Toggle -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Dynamic Boost" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Enable NVIDIA Dynamic Boost" />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="AdpTogDynamicBoost"
                                                     Grid.Column="1"
                                                     Margin="4,0,0,0"
                                                     LabelPosition="Left"
                                                     OnContent="On"
                                                     OffContent="Off"
                                                     Checked="AdpTogDynamicBoost_Checked"
                                                     Unchecked="AdpTogDynamicBoost_Unchecked" />
                                </Grid>
                                <!-- Dynamic Boost Offset (hidden when toggle is off) -->
                                <StackPanel x:Name="AdpSpNvDbOffset" Visibility="Collapsed">
                                    <!-- Divider -->
                                    <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body" Text="Dynamic Boost Offset" />
                                            <ui:TextBlock Margin="0,2,0,0"
                                                           FontTypography="Caption"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="Extra GPU power borrowed from CPU" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="AdpLblNvDbOffset"
                                                       Width="48"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Text="5 W" />
                                            <Slider x:Name="AdpSdNvDbOffset" Width="140" Maximum="25" Minimum="0" Value="5" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" ValueChanged="AdpSlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            <!-- GPU Clock Controls (hidden when EnableGpuClockControl is OFF) -->
                            <StackPanel x:Name="AdpGpuClockControlsPanel">
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Curve Editor Button -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Curve Editor" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Edit voltage-frequency curve per point" />
                                    </StackPanel>
                                    <Button x:Name="AdpBtnVfCurve"
                                            Grid.Column="1"
                                            Content="Edit Curve"
                                            Click="AdpBtnVfCurve_Click"
                                            Margin="4,0,0,0"
                                            Padding="12,4" />
                                </Grid>
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Core Clock Offset -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Core Clock Offset" />
                                        <ui:TextBlock Margin="0,2,0,0"
