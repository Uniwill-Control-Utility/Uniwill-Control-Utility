                                    <ComboBoxItem>Green</ComboBoxItem>
                                    <ComboBoxItem>Blue</ComboBoxItem>
                                    <ComboBoxItem>White</ComboBoxItem>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Flydigi Cooler - only visible on supported hardware -->
                    <ui:CardExpander x:Name="sdBs2Pro"
