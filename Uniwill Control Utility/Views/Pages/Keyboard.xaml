                                            <TextBlock x:Name="MtSpeedValueText" Width="30" HorizontalAlignment="Center" VerticalAlignment="Center" Text="5" />
                                            <Slider x:Name="MtSpeedSlider" Width="140" Minimum="1" Maximum="5" Value="5"
                                                IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="Both" IsMoveToPointEnabled="False"
                                                ValueChanged="MtSpeedSlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>
                                    <Border x:Name="MtDensitySeparator" Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                        Visibility="Collapsed" />
                                    <Grid x:Name="MtDensityRow" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="Density" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="MtDensityValueText" Width="30" HorizontalAlignment="Center" VerticalAlignment="Center" Text="2" />
                                            <Slider x:Name="MtDensitySlider" Width="140" Minimum="1" Maximum="5" Value="2"
                                                IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="Both" IsMoveToPointEnabled="False"
                                                ValueChanged="MtDensitySlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>
                                    <Border x:Name="MtColorsSeparator" Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                        Visibility="Collapsed" />
                                    <Grid x:Name="MtColorsRow" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body" Text="Effect colors" />
                                            <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Tap '+' to add a color, '-' to remove one (up to 3)" />
                                        </StackPanel>
                                        <controls:MultiColorPickerControl x:Name="MtPicker"
                                            Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            MaxColors="3" ColorsChanged="MtPicker_ColorsChanged" />
                                    </Grid>

                                    <!-- Static: layout buttons, zone count, zone swatches -->
                                    <Grid x:Name="StLayoutRow" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="Layout" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <ui:Button x:Name="btnStHorizontal" Width="82" Height="30" Margin="0,0,4,0" Appearance="Transparent"
                                                Click="StLayoutButton_Click" Tag="Horizontal"><TextBlock Text="Horizontal" FontSize="12" HorizontalAlignment="Center"/></ui:Button>
                                            <ui:Button x:Name="btnStVertical" Width="66" Height="30" Margin="0,0,0,0" Appearance="Transparent"
                                                Click="StLayoutButton_Click" Tag="Vertical"><TextBlock Text="Vertical" FontSize="12" HorizontalAlignment="Center"/></ui:Button>
                                        </StackPanel>
                                    </Grid>
                                    <Border x:Name="StZonesSeparator" Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                        Visibility="Collapsed" />
                                    <Grid x:Name="StZonesRow" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="Zones" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="StZonesValueText" Width="30" HorizontalAlignment="Center" VerticalAlignment="Center" Text="1" />
                                            <Slider x:Name="StZonesSlider" Width="140" Minimum="1" Maximum="7" Value="1"
                                                IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="Both" IsMoveToPointEnabled="False"
                                                ValueChanged="StZonesSlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>
                                    <Border x:Name="StColorsSeparator" Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                        Visibility="Collapsed" />
                                    <Grid x:Name="StColorsRow" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="Zone colors" VerticalAlignment="Center" />
                                        <controls:KeyboardMultiColorPickerControl x:Name="StPicker"
                                            Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            ColorsChanged="StPicker_ColorsChanged" />
                                    </Grid>

                                    <!-- Ripple: color + random, spread speed, wave width -->
                                    <Grid x:Name="RpColorRow" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="Color" VerticalAlignment="Center" />
                                        <controls:ColorPickerControl x:Name="RpColorPicker"
                                            Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            SelectedColor="#FF00B4FF" ColorChangedDelayed="RpColorPicker_ColorChangedDelayed" />
                                    </Grid>
                                    <Border x:Name="RpRandomSeparator" Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                        Visibility="Collapsed" />
                                    <Grid x:Name="RpRandomRow" Visibility="Collapsed" Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="Random color" VerticalAlignment="Center" />
                                        <ui:ToggleSwitch x:Name="tsRpRandom" Grid.Column="1" LabelPosition="Left"
                                            OnContent="On" OffContent="Off" IsChecked="True"
                                            Checked="TsRpRandom_Toggled" Unchecked="TsRpRandom_Toggled" />
                                    </Grid>
                                    <Border x:Name="RpSpeedSeparator" Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                        Visibility="Collapsed" />
                                    <Grid x:Name="RpSpeedRow" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="Spread speed" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="RpSpeedValueText" Width="30" HorizontalAlignment="Center" VerticalAlignment="Center" Text="5" />
                                            <Slider x:Name="RpSpeedSlider" Width="140" Minimum="1" Maximum="5" Value="5"
                                                IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="Both" IsMoveToPointEnabled="False"
                                                ValueChanged="RpSpeedSlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>
                                    <Border x:Name="RpWidthSeparator" Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                        Visibility="Collapsed" />
                                    <Grid x:Name="RpWidthRow" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="Wave width" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="RpWidthValueText" Width="30" HorizontalAlignment="Center" VerticalAlignment="Center" Text="2" />
                                            <Slider x:Name="RpWidthSlider" Width="140" Minimum="1" Maximum="4" Value="2"
                                                IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="Both" IsMoveToPointEnabled="False"
                                                ValueChanged="RpWidthSlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Rainbow: color-change speed 1-5 -->
                                    <Grid x:Name="RbSpeedRow" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="Color-change speed" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="RbSpeedValueText" Width="30" HorizontalAlignment="Center" VerticalAlignment="Center" Text="5" />
                                            <Slider x:Name="RbSpeedSlider" Width="140" Minimum="1" Maximum="5" Value="5"
                                                IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="Both" IsMoveToPointEnabled="False"
                                                ValueChanged="RbSpeedSlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Quicksand: palette + swatches, falling speed, band width -->
                                    <Grid x:Name="QsColorsRow" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="Effect colors" VerticalAlignment="Center" />
                                        <controls:MultiColorPickerControl x:Name="QsPicker"
                                            Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            MaxColors="3" ColorsChanged="QsPicker_ColorsChanged" />
                                    </Grid>
                                    <Border x:Name="QsSpeedSeparator" Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                        Visibility="Collapsed" />
                                    <Grid x:Name="QsSpeedRow" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="Falling speed" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="QsSpeedValueText" Width="30" HorizontalAlignment="Center" VerticalAlignment="Center" Text="5" />
                                            <Slider x:Name="QsSpeedSlider" Width="140" Minimum="1" Maximum="5" Value="5"
                                                IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="Both" IsMoveToPointEnabled="False"
                                                ValueChanged="QsSpeedSlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>
                                    <Border x:Name="QsScaleSeparator" Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                        Visibility="Collapsed" />
                                    <Grid x:Name="QsScaleRow" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="Sand band width" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="QsScaleValueText" Width="30" HorizontalAlignment="Center" VerticalAlignment="Center" Text="5" />
                                            <Slider x:Name="QsScaleSlider" Width="140" Minimum="1" Maximum="10" Value="5"
                                                IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="Both" IsMoveToPointEnabled="False"
                                                ValueChanged="QsScaleSlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Current: palette, flow speed, current length 2-8 -->
                                    <Grid x:Name="CuColorsRow" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="Effect colors" VerticalAlignment="Center" />
                                        <controls:MultiColorPickerControl x:Name="CuPicker"
                                            Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            MaxColors="3" ColorsChanged="CuPicker_ColorsChanged" />
                                    </Grid>
                                    <Border x:Name="CuSpeedSeparator" Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                        Visibility="Collapsed" />
                                    <Grid x:Name="CuSpeedRow" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="Flow speed" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="CuSpeedValueText" Width="30" HorizontalAlignment="Center" VerticalAlignment="Center" Text="5" />
                                            <Slider x:Name="CuSpeedSlider" Width="140" Minimum="1" Maximum="5" Value="5"
                                                IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="Both" IsMoveToPointEnabled="False"
                                                ValueChanged="CuSpeedSlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>
                                    <Border x:Name="CuWidthSeparator" Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                        Visibility="Collapsed" />
                                    <Grid x:Name="CuWidthRow" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0" FontTypography="Body" Text="Current length" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="CuWidthValueText" Width="30" HorizontalAlignment="Center" VerticalAlignment="Center" Text="4" />
                                            <Slider x:Name="CuWidthSlider" Width="140" Minimum="2" Maximum="8" Value="4"
                                                IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="Both" IsMoveToPointEnabled="False"
                                                ValueChanged="CuWidthSlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>

                               </StackPanel>
                            </ui:CardExpander>
                        </StackPanel>

                        <!-- ===== PER-KEY MODE CONTENT ===== -->
                        <StackPanel x:Name="PerKeyContent" Visibility="Collapsed">
                            <!-- Brightness (per-key mode) -->
                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Icon>
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE706;" FontSize="20" Margin="4,0,6,0" />
                                </ui:CardControl.Icon>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <ui:TextBlock FontTypography="Body" Text="Brightness" />
                                        <ui:TextBlock Margin="0,2,0,0"
                               FontTypography="Caption"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Adjust the backlight brightness level" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                                    <TextBlock x:Name="BrightnessValueTextPerKey"
                                       Width="30"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="5" />
                                    <Slider x:Name="BrightnessSliderPerKey"
                                        Width="140"
                                        Minimum="1"
                                        Maximum="7"
                                        Value="5"
                                        IsSnapToTickEnabled="True"
                                        TickFrequency="1"
                                        TickPlacement="Both"
                                        IsMoveToPointEnabled="False"
                                        ValueChanged="BrightnessSliderPerKey_ValueChanged" />
                                </StackPanel>
                            </ui:CardControl>

                            <!-- Keyboard visualizer -->
                            <controls:KeyboardVisualizerControl x:Name="_visualizer"
                                        Margin="0,0,0,8" />
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Row 1: Bottom bar — per-key RGB mode only (action buttons + picker).
             Hidden in effects/BetterRGB modes; ApplyPowerVisibility owns the state. -->
        <ui:Card x:Name="PerKeyBottomBar" Visibility="Collapsed"
              Grid.Row="1"
              MaxWidth="1052"
              HorizontalAlignment="Stretch"
              Margin="15,8,15,12"
              Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status (left) -->
                <TextBlock x:Name="_statusText"
                           Grid.Column="0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Select keys to edit their color."
                           VerticalAlignment="Center" />

                <!-- Action buttons (center, per-key mode only) -->
                <StackPanel x:Name="PerKeyActionButtons" Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,12,0"
                            Visibility="Collapsed">
                    <ui:Button x:Name="_selectAllBtn"
                               Appearance="Transparent"
                               Content="Select All"
                               Click="SelectAll_Click"
                               Margin="0,0,8,0" />
                    <ui:Button x:Name="_clearSelectBtn"
                               Appearance="Transparent"
                               Content="Clear Selection"
                               Click="ClearSelection_Click"
                               Margin="0,0,8,0" />
                    <ui:Button x:Name="_fillAllBtn"
                               Appearance="Transparent"
                               Content="Fill All"
                               Click="FillAll_Click" />
                </StackPanel>

                <!-- Color picker + Apply (right, per-key mode only) -->
                <StackPanel x:Name="PerKeyPickerPanel" Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <controls:ColorPickerControl x:Name="_colorPicker"
                                                 Margin="0,0,12,0"
                                                 SelectedColor="White"
                                                 ColorChangedDelayed="_colorPicker_ColorChangedDelayed" />
                    <ui:Button x:Name="_applyBtn"
                               Appearance="Primary"
                               Content="Apply"
                               Click="Apply_Click" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- 3. Overlays/Dialogs sit outside the ScrollViewer to freeze the entire UI if needed -->
        <Border x:Name="overlayAdaptiveWarning"
                Panel.ZIndex="10" 
                Grid.Row="0" 
                Grid.RowSpan="2" 
                Visibility="Collapsed" 
                Background="{DynamicResource SmokeFillColorDefaultBrush}"
                CornerRadius="4,0,0,0"/>

        <!-- Page-scoped snackbar presenter (above overlay) -->
        <ui:SnackbarPresenter x:Name="SnackbarPresenter"
                              Panel.ZIndex="11" MaxWidth="1080"/>
    </Grid>
</Page>
