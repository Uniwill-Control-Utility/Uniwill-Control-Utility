<Page x:Class="Uniwill_Control_Utility.Views.Pages.Keyboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Uniwill_Control_Utility.Views.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Uniwill_Control_Utility.Views.Controls"
      mc:Ignorable="d"
      d:DesignHeight="620" d:DesignWidth="800"
      Title="Keyboard"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True"
      ScrollViewer.CanContentScroll="False">

    <!-- Root Grid with two rows: scrollable content + bottom bar -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Full-width, full-height ScrollViewer ensures the scrollbar is glued
             to the absolute right edge and spans the entire page window vertically. -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      IsDeferredScrollingEnabled="False">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ScrollViewer.Style>

            <!-- 2. Centered max-width layout container INSIDE the scroll viewer. 
                 This aligns both the header and content to the exact same vertical axis. -->
            <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Page title block (16px side margin, 16px top for non-Home page) -->
                <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,16,0,0">
                    <TextBlock FontSize="26"
                               FontWeight="Medium"
                               Margin="12,0,16,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="Keyboard" />
                    <TextBlock Margin="12,8,16,12"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Customize your keyboard backlight and lighting effects."
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Row 1: Content cards (16px side margin, 16px top to match Dashboard) -->
                <StackPanel Grid.Row="1" Margin="12,16,16,18">

                    <!-- Unavailable state -->
                    <StackPanel x:Name="KeyboardUnavailable" Visibility="Collapsed">
                        <Border Margin="0,8,0,0"
                            Padding="14,12"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlFillColorSecondaryBrush}"
                            CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:FontIcon Grid.Column="0"
                                     FontFamily="Segoe Fluent Icons"
                                     Glyph="&#xE7A7;"
                                     FontSize="16"
                                     Margin="0,0,10,0"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Keyboard control is not available on this device. This feature requires an ITE HID lighting controller (vid_048d)."
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Available content -->
                    <StackPanel x:Name="KeyboardAvailable" Visibility="Visible">

                        <!-- Keyboard power toggle (first row, like the Light Bar page):
                             the single off switch for the keyboard. When off, every other
                             control on the page is hidden; the mini-tray Keyboard RGB
                             button mirrors this same PowerOn state. -->
                        <ui:CardControl x:Name="PowerCard" Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7E8;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="Keyboard Backlight" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Turn the keyboard backlight on or off" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="tsKeyboardPower"
                                 LabelPosition="Left"
                                 OnContent="On"
                                 OffContent="Off"
                                 IsChecked="True"
                                 Checked="TsKeyboardPower_Toggled"
                                 Unchecked="TsKeyboardPower_Toggled" />
                        </ui:CardControl>

                        <!-- Mode toggle: Effects / Per-Key -->
                        <ui:CardControl x:Name="ModeToggleCard" Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8D3;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="Per-key RGB control" />
                                    <ui:TextBlock Margin="0,2,0,0"
                           FontTypography="Caption"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Enable per-key color control instead of animation effects" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="ModeToggle"
                                 LabelPosition="Left"
                                 OnContent="On"
                                 OffContent="Off"
                                 Checked="ModeToggle_Checked"
                                 Unchecked="ModeToggle_Checked" />
                        </ui:CardControl>

                        <!-- BetterRGB streamer engine (port of OpenRevo's BetterRGB):
                             software-rendered frames streamed at high FPS; on battery
                             the AC policy auto-falls back to hardware MCU effects. -->
                        <ui:CardControl x:Name="EngineCard" Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE794;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="BetterRGB Streamer Engine" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                           FontTypography="Caption"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Render effects in software and stream them to the controller at high FPS; on battery, auto-falls back to hardware effects"
                                           TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="tsBetterRgbEngine"
                                 LabelPosition="Left"
                                 OnContent="On"
                                 OffContent="Off"
                                 Checked="EngineToggle_Toggled"
                                 Unchecked="EngineToggle_Toggled" />
                        </ui:CardControl>

                        <!-- Light bar sync — the front strip (single HID zone 2) mirrors
                             the rendered frame's bottom row while the engine streams
                             (SampleBottomRowAverage pushed as CMD_SET_COLOR at 10 Hz).
                             Dedicated row below the engine toggle; hidden while the
                             engine is off or the keyboard is powered off. -->
                        <ui:CardControl x:Name="LightBarSyncCard" Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEDAB;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="Light Bar Sync" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                           FontTypography="Caption"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Mirror the keyboard's bottom row onto the front light bar while the BetterRGB engine streams"
                                           TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="tsBetterRgbLightBarSync"
                                 LabelPosition="Left"
                                 OnContent="On"
                                 OffContent="Off"
                                 Checked="TsBetterRgbLightBarSync_Toggled"
                                 Unchecked="TsBetterRgbLightBarSync_Toggled" />
                        </ui:CardControl>

                        <!-- Idle Timer (common to both modes) -->
                        <ui:CardExpander x:Name="IdleTimerCard"
                             Margin="0,0,0,8"
                             IsExpanded="False"
                             Loaded="IdleTimerCard_Loaded"
                             Expanded="IdleTimerCard_Expanded"
                             Collapsed="IdleTimerCard_Collapsed">
                            <ui:CardExpander.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE916;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardExpander.Icon>
                            <ui:CardExpander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Idle Timer" />
                                        <ui:TextBlock Margin="0,2,0,0"
                               FontTypography="Caption"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Automatically turn off the keyboard backlight after a period of inactivity"
                               TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="tsIdleTimer"
                             Grid.Column="1"
                             Margin="4,0,0,0"
                             LabelPosition="Left"
                             OnContent="On"
                             OffContent="Off"
                             Checked="TsIdleTimer_Toggled"
                             Unchecked="TsIdleTimer_Toggled" />
                                </Grid>
                            </ui:CardExpander.Header>

                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Timeout" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                           FontTypography="Caption"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Time of inactivity before the keyboard turns off" />
                                    </StackPanel>
                                    <ComboBox x:Name="cmbIdleTimer"
                                      Grid.Column="1"
                                      Width="130"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      SelectedIndex="9"
                                      SelectionChanged="CmbIdleTimer_SelectionChanged"
                                      MouseLeftButtonDown="ComboBoxInCardExpander_MouseLeftButtonDown" />
                                </Grid>
                            </StackPanel>
                        </ui:CardExpander>

                        <!-- Auto power: backlight follows the AC plug state (common to
                             both per-key and effects modes) -->
                        <ui:CardControl x:Name="AutoPowerCard" Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xED39;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="Auto Off When Unplugged" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                           FontTypography="Caption"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Automatically turn the keyboard backlight off when the laptop is unplugged, and back on when plugged in"
                                           TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="tsAutoPowerUnplug"
                                 LabelPosition="Left"
                                 OnContent="On"
                                 OffContent="Off"
                                 IsChecked="False"
                                 Checked="TsAutoPowerUnplug_Toggled"
                                 Unchecked="TsAutoPowerUnplug_Toggled" />
                        </ui:CardControl>

                        <!-- ===== EFFECTS MODE CONTENT ===== -->
                        <StackPanel x:Name="EffectsContent">
                            <!-- Effect card with all controls -->
                            <ui:CardExpander x:Name="EffectsCardExpander"
                                 Margin="0,0,0,0"
                                 IsExpanded="True">
                                <ui:CardExpander.Icon>
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE794;" FontSize="20" Margin="4,0,6,0" />
                                </ui:CardExpander.Icon>
                                <ui:CardExpander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body" Text="Effects" />
                                            <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Choose between various keyboard lighting effects"
                                               TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox x:Name="cmbEffect"
                                          Grid.Column="1"
                                          Width="180"
                                          Margin="2,0,12,0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          SelectionChanged="CmbEffect_SelectionChanged"
                                          MouseLeftButtonDown="ComboBoxInCardExpander_MouseLeftButtonDown" />
                                    </Grid>
                                </ui:CardExpander.Header>
                                <StackPanel>

                                    <!-- Brightness (always visible at top) -->
                                    <Grid x:Name="BrightnessRow">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body" Text="Brightness" />
                                            <ui:TextBlock Margin="0,2,0,0"
                                   FontTypography="Caption"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="Adjust the backlight brightness level" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                            <TextBlock x:Name="BrightnessValueText"
                                               Width="30"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="5" />
                                            <Slider x:Name="BrightnessSlider"
                                                Width="140"
                                                Minimum="1"
                                                Maximum="7"
                                                Value="5"
                                                IsSnapToTickEnabled="True"
                                                TickFrequency="1"
                                                TickPlacement="Both"
                                                IsMoveToPointEnabled="False"
                                                ValueChanged="BrightnessSlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider between Brightness and effect controls (hidden for Rainbow) -->
                                    <Border x:Name="BrightnessSeparator" Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                        Visibility="Collapsed" />

                                    <!-- Color (visible for single-color effects) -->
                                    <Grid x:Name="ColorRow"
                                        Visibility="Visible"> 
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body" Text="Color" />
                                            <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Single color for Static mode" />
                                        </StackPanel>
                                        <controls:ColorPickerControl x:Name="ColorPicker"
                                             Grid.Column="1"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Center"
                                             SelectedColor="Aqua"
                                             ColorChangedDelayed="ColorPicker_ColorChangedDelayed" />
                                    </Grid>

                                    <!-- Multi-color picker -->
                                    <Grid x:Name="MultiColorRow"
                                        Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body"
                                               x:Name="MultiColorTitle"
                                               Text="Effect Colors" />  
                                            <ui:TextBlock Margin="0,2,0,0"
                                                FontTypography="Caption"
                                                x:Name="MultiColorSubtitle"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="7 colors required for this effect - click a swatch to edit" />
                                        </StackPanel>
                                        <controls:KeyboardMultiColorPickerControl x:Name="MultiColorPicker"
                                                          Grid.Column="1"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          ColorsChanged="MultiColorPicker_ColorsChanged" />
                                    </Grid>

                                    <!-- Full-width divider matching CardExpander's header/content separator -->
                                    <Border x:Name="SpeedSeparator" Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                                    <!-- Speed (visible for animated effects) -->
                                    <Grid x:Name="SpeedRow"
                                            Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body" Text="Speed" />
                                            <ui:TextBlock x:Name="SpeedSubtitle" Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Control the animation speed" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                            <TextBlock x:Name="SpeedValueText"
                                               Width="30"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="5" />
                                            <Slider x:Name="SpeedSlider"
                                                Width="140"
                                                Minimum="1"
                                                Maximum="10"
                                                Value="5"
                                                IsSnapToTickEnabled="True"
                                                TickFrequency="1"
                                                TickPlacement="Both"
                                                IsMoveToPointEnabled="False"
                                                ValueChanged="SpeedSlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Touch Reactive toggle (visible for Random, Ripple, Aurora, Spark) -->
                                    <!-- Full-width divider matching CardExpander's header/content separator -->
                                    <Border x:Name="TouchReactiveSeparator" Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                        Visibility="Collapsed" />
                                    <Grid x:Name="TouchReactiveRow"
                                        Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body" Text="React to key-press" />
                                            <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Effect triggers on keypress instead of running automatically" />
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="tsTouchReactive"
                                             Grid.Column="1"
                                             LabelPosition="Left"
                                             OnContent="On"
                                             OffContent="Off"
                                             Checked="TsTouchReactive_Toggled"
                                             Unchecked="TsTouchReactive_Toggled" />
                                    </Grid>

                                    <!-- Direction (visible for animated effects) -->
                                    <!-- Full-width divider matching CardExpander's header/content separator -->
                                    <Border x:Name="DirectionSeparator" Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                        Visibility="Collapsed" />
                                    <Grid x:Name="DirectionRow"
                                        Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body" Text="Direction" />
                                            <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Control the animation direction" />
                                        </StackPanel>
                                        <!-- Single row of direction toggle buttons -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,0,0">
                                            <ui:Button x:Name="btnDirLeftRight" Width="40" Height="36" Margin="0,0,4,0"
                                                Appearance="Transparent" Click="DirectionButton_Click" Tag="LeftRight">
                                                <TextBlock Text="&#x2192;" FontSize="18" HorizontalAlignment="Center"/>
                                            </ui:Button>
                                            <ui:Button x:Name="btnDirRightLeft" Width="40" Height="36" Margin="0,0,4,0"
                                                Appearance="Transparent" Click="DirectionButton_Click" Tag="RightLeft">
                                                <TextBlock Text="&#x2190;" FontSize="18" HorizontalAlignment="Center"/>
                                            </ui:Button>
                                            <ui:Button x:Name="btnDirDownUp" Width="40" Height="36" Margin="0,0,4,0"
                                                Appearance="Transparent" Click="DirectionButton_Click" Tag="DownUp">
                                                <TextBlock Text="&#x2191;" FontSize="18" HorizontalAlignment="Center"/>
                                            </ui:Button>
                                            <ui:Button x:Name="btnDirUpDown" Width="40" Height="36" Margin="0,0,4,0"
                                                Appearance="Transparent" Click="DirectionButton_Click" Tag="UpDown">
                                                <TextBlock Text="&#x2193;" FontSize="18" HorizontalAlignment="Center"/>
                                            </ui:Button>
                                            <ui:Button x:Name="btnDiagBRTL" Width="40" Height="36" Margin="0,0,4,0"
                                                Appearance="Transparent" Click="DirectionButton_Click" Tag="DiagonalBottomRightToTopLeft">
                                                <TextBlock Text="&#x2196;" FontSize="18" HorizontalAlignment="Center"/>
                                            </ui:Button>
                                            <ui:Button x:Name="btnDiagBLTR" Width="40" Height="36" Margin="0,0,0,0"
                                                Appearance="Transparent" Click="DirectionButton_Click" Tag="DiagonalBottomLeftToTopRight">
                                                <TextBlock Text="&#x2197;" FontSize="18" HorizontalAlignment="Center"/>
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>

                               </StackPanel>
                            </ui:CardExpander>

                            <!-- ===== BETTERRGB EFFECTS CARD (separate from the
                                 firmware Effects card above — the two engines no
                                 longer share controls) ===== -->
                            <ui:CardExpander x:Name="BetterRgbEffectsCardExpander"
                                 Margin="0,0,0,0"
                                 IsExpanded="True"
                                 Visibility="Collapsed">
                                <ui:CardExpander.Icon>
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE794;" FontSize="20" Margin="4,0,6,0" />
                                </ui:CardExpander.Icon>
                                <ui:CardExpander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body" Text="BetterRGB Effects" />
                                            <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Software-rendered effects streamed on the ITE 0xFF03 RGB interface"
                                               TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox x:Name="cmbBetterRgbEffect"
                                          Grid.Column="1"
                                          Width="180"
                                          Margin="2,0,12,0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          SelectionChanged="CmbBetterRgbEffect_SelectionChanged"
                                          MouseLeftButtonDown="ComboBoxInCardExpander_MouseLeftButtonDown" />
                                    </Grid>
                                </ui:CardExpander.Header>
                                <StackPanel>

                                    <!-- Global: brightness 0-100 (software multiplier, g_brightness).
                                         First row of the card - no divider above it. -->
                                    <Grid x:Name="BrightnessPercentRow"
                                        Visibility="Collapsed" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" >
                                            <ui:TextBlock FontTypography="Body" Text="Brightness" />
                                            <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="How bright the streamed effect is (0-100)" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                            <TextBlock x:Name="BrightnessPercentValueText"
                                               Width="40"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="100" />
                                            <Slider x:Name="BrightnessPercentSlider"
                                                Width="140"
                                                Minimum="3"
                                                Maximum="100"
                                                Value="100"
                                                IsSnapToTickEnabled="False"
                                                TickFrequency="25"
                                                TickPlacement="Both"
                                                IsMoveToPointEnabled="False"
                                                ValueChanged="BrightnessPercentSlider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Global: FPS 15-60 (reference TARGET_FPS_MIN/MAX;
                                         the pacer self-degrades when the device cannot
                                         sustain the target) -->
                                    <Border x:Name="FpsSeparator" Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                        Visibility="Collapsed" />
                                    <Grid x:Name="FpsRow"
                                        Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
