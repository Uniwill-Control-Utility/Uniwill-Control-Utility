<Page x:Class="Uniwill_Control_Utility.Views.Pages.Automations"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Uniwill_Control_Utility.Views.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      d:DataContext="{d:DesignInstance local:Automations, IsDesignTimeCreatable=False}"
      d:Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d"
      d:DesignHeight="650"
      d:DesignWidth="800"
      Title="Automations"
      Loaded="Page_Loaded"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Page.Resources>
        <Style TargetType="{x:Type CheckBox}"
               BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Style.Triggers>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter Property="Width" Value="20" />
                    <Setter Property="Height" Value="20" />
                    <Setter Property="MinWidth" Value="20" />
                    <Setter Property="MinHeight" Value="20" />
                    <Setter Property="Padding" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <!-- Root Grid spans full window space -->
    <Grid>

        <!-- Full-width, full-height ScrollViewer -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      IsDeferredScrollingEnabled="False">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Padding" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, RelativeSource={RelativeSource Self}}"
                                     Value="Visible">
                            <Setter Property="Padding" Value="0,0,8,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <!-- Centered max-width layout container -->
            <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Page title block -->
                <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,16,0,8">
                    <TextBlock FontSize="26"
                               FontWeight="Medium"
                               Margin="14,0,24,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="Automations" />
                    <TextBlock Margin="14,8,24,12"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Apply presets automatically when power or system state changes."
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Row 1: Content cards -->
                <StackPanel Grid.Row="1" Margin="12,0,16,16">

                <!-- Preset on Battery Charge -->
                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEBB5;" FontSize="20" Margin="4,0,6,0" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Body" Text="Preset on Battery Charge" />
                                <ui:TextBlock Margin="0,2,0,0"
                                           FontTypography="Caption"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Apply a preset whenever the battery begins charging"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="cbxCharge"
                                          MinWidth="150"
                                          Height="37"
                                          SelectedIndex="0"
                                          SelectionChanged="cbxCharge_SelectionChanged" />
                                <ui:Button x:Name="btnChargeLoad"
                                           Width="44"
                                           Height="37"
                                           Margin="8,0,0,0"
                                           ToolTip="Refresh the preset list"
                                           Click="btnChargeLoad_Click">
                                    <ui:SymbolIcon Symbol="ArrowSync20" FontSize="20" />
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </ui:CardControl.Header>
                </ui:CardControl>

                <!-- Preset on Battery Discharge -->
                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xECBC;" FontSize="20" Margin="4,0,6,0" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Body" Text="Preset on Battery Discharge" />
                                <ui:TextBlock Margin="0,2,0,0"
                                           FontTypography="Caption"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Apply a preset whenever the system begins running from battery power"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="cbxDischarge"
                                          MinWidth="150"
                                          Height="37"
                                          SelectedIndex="0"
                                          SelectionChanged="cbxDischarge_SelectionChanged" />
                                <ui:Button x:Name="btnDischargeLoad"
                                           Width="44"
                                           Height="37"
                                           Margin="8,0,0,0"
                                           ToolTip="Refresh the preset list"
                                           Click="btnDischargeLoad_Click">
                                    <ui:SymbolIcon Symbol="ArrowSync20" FontSize="20" />
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </ui:CardControl.Header>
                </ui:CardControl>

                <!-- Preset on System Resume -->
                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF83D;" FontSize="20" Margin="4,0,6,0" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Body" Text="Preset on System Resume" />
                                <ui:TextBlock Margin="0,2,0,0"
                                           FontTypography="Caption"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Apply a preset after the system resumes from sleep or hibernation"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="cbxResume"
                                          MinWidth="150"
                                          Height="37"
                                          SelectedIndex="0"
                                          SelectionChanged="cbxResume_SelectionChanged" />
                                <ui:Button x:Name="btnResumeLoad"
                                           Width="44"
                                           Height="37"
                                           Margin="8,0,0,0"
                                           ToolTip="Refresh the preset list"
                                           Click="btnResume_Click">
                                    <ui:SymbolIcon Symbol="ArrowSync20" FontSize="20" />
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </ui:CardControl.Header>
                </ui:CardControl>

                <!-- GPU Preference on Battery — only visible in Hybrid mode -->
                <ui:CardControl x:Name="CardGpuPowerSavingBattery"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                    <ui:CardControl.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xECBF;" FontSize="20" Margin="4,0,6,0" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Body" Text="GPU Preference on Battery" />
                                <ui:TextBlock Margin="0,2,0,0"
                                           FontTypography="Caption"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Control GPU preference when running on battery power"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="cbxGpuPowerSavingBattery"
                                      Grid.Column="1"
                                      MinWidth="150"
                                      Height="37"
                                      SelectedIndex="0"
                                      SelectionChanged="cbxGpuPowerSavingBattery_SelectionChanged" />
                        </Grid>
                    </ui:CardControl.Header>
                </ui:CardControl>

                <!-- GPU Preference when Plugged In — only visible in Hybrid mode -->
                <ui:CardControl x:Name="CardGpuPowerSavingPluggedIn"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                    <ui:CardControl.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE95F;" FontSize="20" Margin="4,0,6,0" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Body" Text="GPU Preference when Plugged In" />
                                <ui:TextBlock Margin="0,2,0,0"
                                           FontTypography="Caption"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Control GPU preference when the system is connected to power"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="cbxGpuPowerSavingPluggedIn"
                                      Grid.Column="1"
                                      MinWidth="150"
                                      Height="37"
                                      SelectedIndex="0"
                                      SelectionChanged="cbxGpuPowerSavingPluggedIn_SelectionChanged" />
                        </Grid>
                    </ui:CardControl.Header>
                </ui:CardControl>

                <!-- Internal-panel refresh rate on battery (hidden when the panel offers one rate) -->
                <ui:CardControl x:Name="CardRefreshRateBattery"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                    <ui:CardControl.Icon>
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE717;" FontSize="20" Margin="4,0,6,0" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Body" Text="Refresh Rate on Battery" />
                                <ui:TextBlock Margin="0,2,0,0"
                                           FontTypography="Caption"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Set the internal panel's refresh rate when running on battery power"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="cbxRefreshRateBattery"
                                      Grid.Column="1"
                                      MinWidth="150"
                                      Height="37"
                                      SelectionChanged="cbxRefreshRateBattery_SelectionChanged" />
                        </Grid>
                    </ui:CardControl.Header>
                </ui:CardControl>

                <!-- Internal-panel refresh rate when plugged in -->
                <ui:CardControl x:Name="CardRefreshRatePluggedIn"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                    <ui:CardControl.Icon>
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE95F;" FontSize="20" Margin="4,0,6,0" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Body" Text="Refresh Rate when Plugged In" />
                                <ui:TextBlock Margin="0,2,0,0"
                                           FontTypography="Caption"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Set the internal panel's refresh rate when connected to power"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="cbxRefreshRatePluggedIn"
                                      Grid.Column="1"
                                      MinWidth="150"
                                      Height="37"
                                      SelectionChanged="cbxRefreshRatePluggedIn_SelectionChanged" />
                        </Grid>
                    </ui:CardControl.Header>
                </ui:CardControl>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
