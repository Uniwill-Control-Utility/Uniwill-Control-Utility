<Page x:Class="Uniwill_Control_Utility.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="clr-namespace:Uniwill_Control_Utility.Helpers"
      xmlns:local="clr-namespace:Uniwill_Control_Utility.Views.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Settings"
      d:DataContext="{d:DesignInstance local:SettingsPage,
                              IsDesignTimeCreatable=False}"
      d:DesignHeight="850"
      d:DesignWidth="800"
      d:Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False"
      mc:Ignorable="d"
      Loaded="UiPage_Loaded"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Scrollable content -->
        <ScrollViewer x:Name="SettingsScrollViewer"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      IsDeferredScrollingEnabled="False">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Padding" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, RelativeSource={RelativeSource Self}}"
                                     Value="Visible">
                            <Setter Property="Padding" Value="0,0,8,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Page title block -->
                <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,16,0,0">
                    <TextBlock FontSize="26"
                               FontWeight="Medium"
                               Margin="12,0,16,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="Settings" />
                    <TextBlock Margin="12,8,16,12"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Configure startup behaviour, automation, diagnostics and updates"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Content cards -->
                <StackPanel Grid.Row="1" Margin="12,16,16,18">

                    <!-- Application behaviour -->
                    <ui:CardExpander Margin="0,0,0,8"
                                     IsExpanded="True">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="20" Margin="4,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Application behaviour" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Startup, language, and automation preferences"
                                               TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardExpander.Header>

                        <StackPanel>
                            <!-- Row: Language -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Language" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Select the display language for the application" />
                                </StackPanel>
                                <ComboBox x:Name="cbxLanguage"
                                          Grid.Column="1"
                                          Width="220"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="cbxLanguage_SelectionChanged"
                                          MouseLeftButtonDown="ComboBoxInCardExpander_MouseLeftButtonDown" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Start on system boot -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Start on system boot" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Launch the application automatically when Windows starts" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbStartBoot"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbStartBoot_Checked"
                                                 Unchecked="cbStartBoot_Unchecked" />
                            </Grid>

                            <!-- Divider (hidden with Startup delay row) -->
                            <Border x:Name="StartupDelayDivider" Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                    Visibility="Collapsed" />

                            <!-- Row: Startup delay (hidden when Start on system boot is OFF) -->
                            <Grid x:Name="StartupDelayRow" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Startup delay" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Wait before launching after logon (0–120 seconds)" />
                                </StackPanel>
                                <ui:NumberBox x:Name="nbStartupDelay"
                                              Grid.Column="1"
                                              HorizontalAlignment="Right"
                                              Minimum="0"
                                              Maximum="120"
                                              SmallChange="5"
                                              MaxDecimalPlaces="0"
                                              ValueChanged="nbStartupDelay_ValueChanged" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Startup progress overlay -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Show startup progress" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                  FontTypography="Caption"
                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                  Text="Display the startup progress window while the application is loading" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbShowStartupProgress"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbShowStartupProgress_Checked"
                                                 Unchecked="cbShowStartupProgress_Unchecked" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Start minimised -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Start minimised" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Open to the system tray instead of the main window" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbStartMini"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbStartMini_Checked"
                                                 Unchecked="cbStartMini_Unchecked" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Minimise instead of closing -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Minimise instead of closing" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Keep the application running in the system tray when closed" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbMinimizeClose"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbMinimizeClose_Checked"
                                                 Unchecked="cbMinimizeClose_Unchecked" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Disable notification pop-up -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Disable notification pop-up" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Hide the on-screen notification cards shown on preset, GPU mode and device changes" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbDisableToastPopups"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbDisableToastPopups_Checked"
                                                 Unchecked="cbDisableToastPopups_Unchecked" />
                            </Grid>

                            <!-- Divider -->
                            <Border x:Name="AutoCheckDivider"
                                    Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Check for updates automatically -->
                            <Grid x:Name="AutoCheckRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Check for updates automatically" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Automatically check GitHub for new releases on startup" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbAutoCheck"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbAutoCheck_Checked"
                                                 Unchecked="cbAutoCheck_Unchecked" />
                            </Grid>

                            <!-- Divider -->
                            <Border x:Name="AutoUpdateDivider"
                                    Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Automatic updates (silent download + apply on exit) -->
                            <Grid x:Name="AutoUpdateRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Automatic updates" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Download updates in the background and install when the application exits" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbAutoUpdate"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbAutoUpdate_Checked"
                                                 Unchecked="cbAutoUpdate_Unchecked" />
                            </Grid>

                            <!-- Divider -->
                            <Border x:Name="GuardianDivider"
                                    Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Crash guardian (watchdog) -->
                            <Grid x:Name="GuardianRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Relaunch the application after a crash" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Automatically restart UCU if it exits unexpectedly (registers a scheduled watchdog task)" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbGuardian"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbGuardian_Checked"
                                                 Unchecked="cbGuardian_Unchecked" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Start Adaptive Mode automatically -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Start Adaptive Mode automatically" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Enable Adaptive Mode tuning on application launch" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbAdaptive"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbAdaptive_Checked"
                                                 Unchecked="cbAdaptive_Unchecked" />
                            </Grid>

                         </StackPanel>
                    </ui:CardExpander>

                    <!-- Feature control -->
                    <ui:CardExpander Margin="0,0,0,8"
                                     IsExpanded="False">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE90F;" FontSize="20" Margin="6,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Feature control" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Choose which controls are enabled and which sections appear in the sidebar"
                                               TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <!-- Row: Disable GPU clock control -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="GPU clock control" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Controls GPU curve/core clock offset and memory clock offset in Presets and Adaptive pages"
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbDisableGpuClockControl"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbDisableGpuClockControl_Checked"
                                                 Unchecked="cbDisableGpuClockControl_Unchecked" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Disable Flydigi cooler functionality -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Flydigi cooler functionality" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Show or hide the Flydigi cooler controls. (App restart required)" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbHideFlydigi"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbHideFlydigi_Checked"
                                                 Unchecked="cbHideFlydigi_Unchecked" />
                            </Grid>

                            <!-- Divider -->
                            <Border x:Name="CpuVoltageControlDivider" Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Disable CPU voltage control (hidden on Intel — voltage control is AMD-only) -->
                            <Grid x:Name="CpuVoltageControlRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="CPU voltage control" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Disable if you perform voltage control via BIOS or if it's locked at the BIOS level"
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbDisableCpuVoltageControl"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbDisableCpuVoltageControl_Checked"
                                                 Unchecked="cbDisableCpuVoltageControl_Unchecked" />
                            </Grid>

                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Adaptive" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Show or hide Adaptive in the sidebar"
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbShowAdaptiveNavigation"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbShowAdaptiveNavigation_Checked"
                                                 Unchecked="cbShowAdaptiveNavigation_Unchecked" />
                            </Grid>

                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Hydro UI" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Show or hide Hydro UI in the sidebar on supported hardware"
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbShowHydroUiNavigation"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbShowHydroUiNavigation_Checked"
                                                 Unchecked="cbShowHydroUiNavigation_Unchecked" />
                            </Grid>

                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Light Bar" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Show or hide Light Bar in the sidebar on supported hardware"
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbShowLightBarNavigation"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbShowLightBarNavigation_Checked"
                                                 Unchecked="cbShowLightBarNavigation_Unchecked" />
                            </Grid>

                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Overlay" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Show or hide Overlay in the sidebar"
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbShowOverlayNavigation"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbShowOverlayNavigation_Checked"
                                                 Unchecked="cbShowOverlayNavigation_Unchecked" />
                            </Grid>

                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Auto" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Show or hide Auto in the sidebar"
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbShowAutoNavigation"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbShowAutoNavigation_Checked"
                                                 Unchecked="cbShowAutoNavigation_Unchecked" />
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Advanced features -->
                    <ui:CardExpander x:Name="PowerBoostCard"
                                     Margin="0,0,0,8"
                                     IsExpanded="False">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF196;" FontSize="20" Margin="6,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Advanced features" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Manage extra useful features"
                                               TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <!-- Row: Power boost mode -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Power boost mode" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Sets TDP and TGP slider limits to 250W (but requires mods for it to truly apply and disables Dynamic Boost)"
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbPowerBoostMode"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbPowerBoostMode_Checked"
                                                 Unchecked="cbPowerBoostMode_Unchecked" />
                            </Grid>
                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Q-Key button preset switching -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Q-Key button preset switching" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Enabling it lets the physical key (next to the power button) switch between power presets when pressed"
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbQKeyIntercept"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbQKeyIntercept_Checked"
                                                 Unchecked="cbQKeyIntercept_Unchecked" />
                            </Grid>

                            <!-- Row: CPU Advanced Performance Menu (gated: Intel + firmware support) -->
                            <Border x:Name="ApMenuDivider" Height="1" Margin="-58,12,-46,12"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                            <Grid x:Name="ApMenuRow" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="CPU Advanced Performance Menu" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Unlocks the Advanced Performance Menu (CPU and memory overclocking) in BIOS setup. Takes effect on the next boot."
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbCpuAdvancedPerformanceMenu"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbCpuAdvancedPerformanceMenu_Checked"
                                                 Unchecked="cbCpuAdvancedPerformanceMenu_Unchecked" />
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Hardware management -->
                    <ui:CardExpander x:Name="HardwareManagementCard"
                                     Margin="0,0,0,8"
                                     IsExpanded="False">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEC7A;" FontSize="20" Margin="6,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Hardware management" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Enable or disable hardware features at the Windows level"
                                               TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardExpander.Header>

                        <StackPanel>
                            <!-- Row: Wi-Fi -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Wi-Fi" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Turn the Wi-Fi radio on or off, like the Settings quick toggle" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbWifiToggle"
                                                 Grid.Column="1"
                                                 IsChecked="True"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbWifiToggle_Checked"
                                                 Unchecked="cbWifiToggle_Unchecked" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Bluetooth -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Bluetooth" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Turn the Bluetooth radio on or off, like the Settings quick toggle" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbBluetoothToggle"
                                                 Grid.Column="1"
                                                 IsChecked="True"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbBluetoothToggle_Checked"
                                                 Unchecked="cbBluetoothToggle_Unchecked" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Webcam -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Webcam" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Enable or disable the camera device in Device Manager (PnP hotswap)" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbWebcamToggle"
                                                 Grid.Column="1"
                                                 IsChecked="True"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbWebcamToggle_Checked"
                                                 Unchecked="cbWebcamToggle_Unchecked" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Touchpad -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Touchpad" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Enable or disable the touchpad via the Windows Settings admin flow" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbTouchpadToggle"
                                                 Grid.Column="1"
                                                 IsChecked="True"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbTouchpadToggle_Checked"
                                                 Unchecked="cbTouchpadToggle_Unchecked" />
                            </Grid>

                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Preset backup -->
                    <ui:CardExpander Margin="0,0,0,8"
                                     IsExpanded="False">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7AA;" FontSize="20" Margin="6,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Backup &amp; restore" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Back up or restore all presets, settings, and profiles"
                                               TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardExpander.Header>

                        <StackPanel>
                            <!-- Row: Backup / Import -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Full backup" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Includes all app preferences"
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ui:Button x:Name="btnBackupPresets"
                                               Width="190"
                                               Click="btnBackupPresets_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,8,0"
                                                           FontSize="22"
                                                           Symbol="ArrowDownload20" />
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="Export backup" />
                                        </StackPanel>
                                    </ui:Button>

                                    <ui:Button x:Name="btnImportPresets"
                                               Width="190"
                                               Margin="9,0,0,0"
                                               Appearance="Primary"
                                               Click="btnImportPresets_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,8,0"
                                                           FontSize="22"
                                                           Symbol="ArrowUpload20" />
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="Import backup" />
                                        </StackPanel>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>

                            <ui:InfoBar x:Name="PresetBackupStatus"
                                        Margin="0,10,0,0"
                                        IsClosable="True"
                                        IsOpen="False" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Diagnostics -->
                    <ui:CardExpander Margin="0,0,0,8"
                                     IsExpanded="False">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9D9;" FontSize="20" Margin="6,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Diagnostics" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Logging level and troubleshooting tools"
                                               TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardExpander.Header>

                        <StackPanel>
                            <!-- Row: Log level -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Diagnostic logging" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Control the verbosity of diagnostic log output" />
                                </StackPanel>
                                <ComboBox x:Name="cbxLogLevel"
                                          Grid.Column="1"
                                          Width="220"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          SelectionChanged="cbxLogLevel_SelectionChanged"
                                          MouseLeftButtonDown="ComboBoxInCardExpander_MouseLeftButtonDown">
                                    <ComboBoxItem Content="Off" />
                                    <ComboBoxItem Content="Error only" />
                                    <ComboBoxItem Content="Info" />
                                    <ComboBoxItem Content="Debug" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>


                    <!-- System Info section -->
                    <TextBlock Margin="0,16,0,0"
                               FontSize="20"
                               FontWeight="Medium"
                               Text="System Info" />

                    <TextBlock Margin="0,4,0,0"
                               FontSize="14"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Review detailed device, processor, memory and battery information"
                               TextWrapping="Wrap" />

                    <!-- Drivers card (conditionally visible for XMG / PCSpecialist) -->
                    <ui:CardControl x:Name="CardDrivers"
                                    Margin="0,12,0,8"
                                    Visibility="Collapsed">
                        <ui:CardControl.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;" FontSize="20" Margin="6,0,6,0" />
                        </ui:CardControl.Icon>
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Official Driver Download Page" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Open the manufacturer's driver download page for your laptop model" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:Button x:Name="btnOpenDrivers"
                                   Content="Open"
                                   Click="BtnOpenDrivers_Click" />
                    </ui:CardControl>

                    <!-- System Identity card -->
                    <ui:CardExpander x:Name="sdWindows"
                                     Margin="0,0,0,0"
                                     IsEnabled="True"
                                     IsExpanded="False">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7F8;" FontSize="20" Margin="6,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="System Identity" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Laptop model, hardware identifiers, CPU, GPU, and memory details" />
                            </StackPanel>
                        </ui:CardExpander.Header>

                        <StackPanel>
                            <!-- Display Name -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Display Name" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Detected laptop model name" />
                                </StackPanel>
                                <TextBlock x:Name="tbDisplayName"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Manufacturer -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Manufacturer" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="System manufacturer from WMI" />
                                </StackPanel>
                                <TextBlock x:Name="tbManufacturer"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Baseboard Product -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Baseboard Product" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Baseboard product identifier from WMI" />
                                </StackPanel>
                                <TextBlock x:Name="tbBaseboardProduct"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- System SKU -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="System SKU" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="System SKU number from WMI" />
                                </StackPanel>
                                <TextBlock x:Name="tbSystemSku"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- CPU -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="CPU" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Processor name" />
                                </StackPanel>
                                <TextBlock x:Name="tbCpuName"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- GPU -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="GPU" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Graphics processor name" />
                                </StackPanel>
                                <TextBlock x:Name="tbGpuName"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- RAM Manufacturer -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="RAM Manufacturer" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Memory module manufacturer" />
                                </StackPanel>
                                <TextBlock x:Name="tbRamManufacturer"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- RAM Capacity -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="RAM Capacity" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Total memory capacity" />
                                </StackPanel>
                                <TextBlock x:Name="tbRamCapacity"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- RAM Speed -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="RAM Speed" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Configured memory speed" />
                                </StackPanel>
                                <TextBlock x:Name="tbRamSpeed"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- RAM Model -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="RAM Model" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Memory module part number" />
                                </StackPanel>
                                <TextBlock x:Name="tbRamModel"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
