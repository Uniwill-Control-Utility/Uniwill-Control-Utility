<Page x:Class="Uniwill_Control_Utility.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="clr-namespace:Uniwill_Control_Utility.Helpers"
      xmlns:local="clr-namespace:Uniwill_Control_Utility.Views.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Settings"
      d:DataContext="{d:DesignInstance local:SettingsPage,
                              IsDesignTimeCreatable=False}"
      d:DesignHeight="850"
      d:DesignWidth="800"
      d:Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      ScrollViewer.CanContentScroll="False"
      mc:Ignorable="d"
      Loaded="UiPage_Loaded"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Scrollable content -->
        <ScrollViewer x:Name="SettingsScrollViewer"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      IsDeferredScrollingEnabled="False">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Padding" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, RelativeSource={RelativeSource Self}}"
                                     Value="Visible">
                            <Setter Property="Padding" Value="0,0,8,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Page title block -->
                <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,16,0,0">
                    <TextBlock FontSize="26"
                               FontWeight="Medium"
                               Margin="12,0,16,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="Settings" />
                    <TextBlock Margin="12,8,16,12"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Configure startup behaviour, automation, diagnostics and updates."
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Content cards -->
                <StackPanel Grid.Row="1" Margin="12,16,16,18">

                    <!-- MiniLED Local Dimming (hidden for non-MiniLED panels) -->
                    <ui:CardControl x:Name="CardLocalDimming" Margin="0,0,0,8" Visibility="Collapsed">
                        <ui:CardControl.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE706;" FontSize="20" Margin="4,0,6,0" />
                        </ui:CardControl.Icon>
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="MiniLED Local Dimming" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Enable or disable MiniLED local dimming on the display." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="tsLocalDimming"
                                         LabelPosition="Left"
                                         OnContent="On"
                                         OffContent="Off"
                                         Checked="TsLocalDimming_Toggled"
                                         Unchecked="TsLocalDimming_Toggled" />
                    </ui:CardControl>

                    <!-- Application behaviour -->
                    <ui:CardExpander Margin="0,0,0,8"
                                     IsExpanded="True">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="20" Margin="4,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Application behaviour" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Startup, language, and automation preferences."
                                               TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardExpander.Header>

                        <StackPanel>
                            <!-- Row: Language -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Language" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Select the display language for the application." />
                                </StackPanel>
                                <ComboBox x:Name="cbxLanguage"
                                          Grid.Column="1"
                                          Width="220"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="cbxLanguage_SelectionChanged"
                                          MouseLeftButtonDown="ComboBoxInCardExpander_MouseLeftButtonDown" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Start on system boot -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Start on system boot" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Launch the application automatically when Windows starts." />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbStartBoot"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbStartBoot_Checked"
                                                 Unchecked="cbStartBoot_Unchecked" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Start minimised -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Start minimised" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Open to the system tray instead of the main window." />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbStartMini"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbStartMini_Checked"
                                                 Unchecked="cbStartMini_Unchecked" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Minimise instead of closing -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Minimise instead of closing" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Keep the application running in the system tray when closed." />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbMinimizeClose"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbMinimizeClose_Checked"
                                                 Unchecked="cbMinimizeClose_Unchecked" />
                            </Grid>

                            <!-- Divider -->
                            <Border x:Name="AutoCheckDivider"
                                    Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                    Visibility="Collapsed" />

                            <!-- Row: Check for updates automatically (hidden) -->
                            <Grid x:Name="AutoCheckRow" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Check for updates automatically" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Automatically check GitHub for new releases on startup." />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbAutoCheck"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbAutoCheck_Checked"
                                                 Unchecked="cbAutoCheck_Unchecked" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Start Adaptive Mode automatically -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Start Adaptive Mode automatically" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Enable Adaptive Mode tuning on application launch." />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbAdaptive"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbAdaptive_Checked"
                                                 Unchecked="cbAdaptive_Unchecked" />
                            </Grid>

                            <!-- Divider -->
                            <Border x:Name="GpuPowerBoostDivider"
                                    Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}"
                                    Visibility="Collapsed" />

                            <!-- Row: GPU Power Boost (RTX 5080/5090 only) -->
                            <Grid x:Name="GpuPowerBoostRow" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="GPU Power Boost" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Allow GPU TGP up to 225W. Only enable if your cooling solution can sustain it." />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbGpuPowerBoost"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbGpuPowerBoost_Checked"
                                                 Unchecked="cbGpuPowerBoost_Unchecked" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Disable Flydigi cooler functionality -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Disable Flydigi cooler functionality" />
                                    <ui:TextBlock Margin="0,2,0,2"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Disconnect the Flydigi cooler and hide all related UI elements. (App restart required)" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbHideFlydigi"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbHideFlydigi_Checked"
                                                 Unchecked="cbHideFlydigi_Unchecked" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Row: Disable CPU voltage control -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Disable CPU voltage control" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="For those who perform voltage control via BIOS (or for cases where it's locked down on the BIOS level)"
                                                   TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="cbDisableCpuVoltageControl"
                                                 Grid.Column="1"
                                                 LabelPosition="Left"
                                                 OnContent="On"
                                                 OffContent="Off"
                                                 Checked="cbDisableCpuVoltageControl_Checked"
                                                 Unchecked="cbDisableCpuVoltageControl_Unchecked" />
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Preset backup -->
                    <ui:CardExpander Margin="0,0,0,8"
                                     IsExpanded="False">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7AA;" FontSize="20" Margin="4,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Preset backup" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Back up or import custom and adaptive mode presets."
                                               TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardExpander.Header>

                        <StackPanel>
                            <!-- Row: Backup / Import -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Preset files" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Existing presets with the same name will be replaced during import." />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ui:Button x:Name="btnBackupPresets"
                                               Width="190"
                                               Click="btnBackupPresets_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,8,0"
                                                           FontSize="22"
                                                           Symbol="ArrowDownload20" />
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="Back up presets" />
                                        </StackPanel>
                                    </ui:Button>

                                    <ui:Button x:Name="btnImportPresets"
                                               Width="190"
                                               Margin="9,0,0,0"
                                               Appearance="Primary"
                                               Click="btnImportPresets_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,8,0"
                                                           FontSize="22"
                                                           Symbol="ArrowUpload20" />
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="Import presets" />
                                        </StackPanel>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>

                            <ui:InfoBar x:Name="PresetBackupStatus"
                                        Margin="0,10,0,0"
                                        IsClosable="True"
                                        IsOpen="False" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Diagnostics -->
                    <ui:CardExpander Margin="0,0,0,8"
                                     IsExpanded="False">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9D9;" FontSize="20" Margin="4,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Diagnostics" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Logging level, stress testing, and troubleshooting tools."
                                               TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:CardExpander.Header>

                        <StackPanel>
                            <!-- Row: Log level -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Diagnostic logging" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Control the verbosity of diagnostic log output." />
                                </StackPanel>
                                <ComboBox x:Name="cbxLogLevel"
                                          Grid.Column="1"
                                          Width="220"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          SelectionChanged="cbxLogLevel_SelectionChanged"
                                          MouseLeftButtonDown="ComboBoxInCardExpander_MouseLeftButtonDown">
                                    <ComboBoxItem Content="Off" />
                                    <ComboBoxItem Content="Error only" />
                                    <ComboBoxItem Content="Info" />
                                    <ComboBoxItem Content="Debug" />
                                </ComboBox>
                            </Grid>

                            <!-- Row: Stress test (hidden) -->
                            <Grid Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Stress test" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Run a CPU stress test to validate cooling." />
                                </StackPanel>
                                <ui:Button x:Name="btnStressTest"
                                           Grid.Column="1"
                                           Width="190"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Appearance="Caution"
                                           Click="btnStressTest_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Fire20"
                                                       FontSize="22"
                                                       Margin="0,0,8,0" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="Start Stress Test" />
                                    </StackPanel>
                                </ui:Button>
                            </Grid>

                            <ui:InfoBar Margin="0,10,0,0"
                                        IsOpen="True"
                                        IsClosable="False"
                                        Severity="Warning"
                                        Title="High CPU load"
                                        Message="The stress test places extreme load on the CPU. Ensure cooling is adequate and proceed at your own risk."
                                        Visibility="Collapsed" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- About Uniwill Control Utility -->
                    <ui:Card Margin="0,0,0,8" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock FontSize="17"
                                       FontWeight="Medium"
                                       Text="About Uniwill Control Utility" />

                            <TextBlock x:Name="tbAppVerion"
                                       Margin="0,7,0,12" />

                            <StackPanel Orientation="Horizontal"
                                       Visibility="Collapsed">
                                <ui:Button x:Name="btnCheck"
                                           Width="178"
                                           Click="btnCheck_Click">

                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowSync20"
                                                       FontSize="22"
                                                       Margin="0,0,8,0" />

                                        <TextBlock VerticalAlignment="Center"
                                                   Text="Check for Updates" />
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button x:Name="btnDownload"
                                           Width="178"
                                           Margin="9,0,0,0"
                                           Appearance="Primary"
                                           Visibility="Collapsed"
                                           Click="btnDownload_Click">

                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowDownload20"
                                                       FontSize="22"
                                                       Margin="0,0,8,0" />

                                        <TextBlock VerticalAlignment="Center"
                                                   Text="Download Update" />
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>

                            <TextBlock x:Name="tbDownloadMsg"
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Stretch"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:Card>

                    <!-- System Info section -->
                    <TextBlock Margin="0,16,0,0"
                               FontSize="20"
                               FontWeight="Medium"
                               Text="System Info" />

                    <TextBlock Margin="0,4,0,0"
                               FontSize="14"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Review detailed device, processor, memory and battery information."
                               TextWrapping="Wrap" />

                    <ui:CardExpander x:Name="sdWindows"
                                     Margin="0,12,0,0"
                                     IsEnabled="True"
                                     IsExpanded="False">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7F8;" FontSize="20" Margin="4,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Laptop Information" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="System name, manufacturer, and model." />
                            </StackPanel>
                        </ui:CardExpander.Header>

                        <StackPanel>
                            <!-- Name -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Name" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Computer name on the network." />
                                </StackPanel>
                                <TextBlock x:Name="tbDeviceName"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Producer -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Producer" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Hardware manufacturer." />
                                </StackPanel>
                                <TextBlock x:Name="tbDeviceProducer"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Margin="-58,12,-46,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <!-- Model -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Model" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Device model identifier." />
                                </StackPanel>
                                <TextBlock x:Name="tbDeviceModel"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                    <ui:CardExpander x:Name="sdCPU"
                                     Margin="0,8,0,0"
                                     IsEnabled="True"
                                     IsExpanded="False">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEEA1;" FontSize="20" Margin="4,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Processor Information" />
