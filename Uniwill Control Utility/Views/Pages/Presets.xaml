<Page x:Class="Uniwill_Control_Utility.Views.Pages.Presets"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Uniwill_Control_Utility.Views.Pages"
      xmlns:controls="clr-namespace:Uniwill_Control_Utility.Views.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      d:DataContext="{d:DesignInstance local:Presets, IsDesignTimeCreatable=False}"
      d:Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d"
      d:DesignHeight="1200"
      d:DesignWidth="900"
      Title="Presets"
      Loaded="Page_Loaded"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <Style x:Key="ProfileButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ProfileButtonActiveStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <!-- Root Grid with two rows: scrollable content + bottom bar -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Full-width, full-height ScrollViewer -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      IsDeferredScrollingEnabled="False">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ScrollViewer.Style>

            <!-- Centered max-width layout container -->
            <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Page title block -->
                <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,16,0,0">
                    <TextBlock FontSize="26"
                               FontWeight="Medium"
                               Margin="14,0,16,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="Power Presets" />
                    <TextBlock Margin="14,8,16,12"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Select one of the default power presets or create your own one."
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Row 1: Content cards -->
                <StackPanel Grid.Row="1" Margin="12,16,16,18">

                    <!-- Profile Selector Card -->
                    <ui:Card Margin="0,0,0,8"
                             Padding="8"
                             SnapsToDevicePixels="True">
                        <UniformGrid Columns="4" Rows="1">
                            <Button x:Name="btnOffice" Style="{StaticResource ProfileButtonStyle}" Click="btnOffice_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BE;" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" Text="Office" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnGaming" Style="{StaticResource ProfileButtonStyle}" Click="btnGaming_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE967;" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" Text="Gaming" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnTurbo" Style="{StaticResource ProfileButtonStyle}" Click="btnTurbo_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE945;" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" Text="Turbo" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnCustom" Style="{StaticResource ProfileButtonStyle}" Click="btnCustom_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" Text="Custom" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </ui:Card>

                    <!-- Status Card: the live CPU/GPU contract, and — on its own row, under the
                         same full-width rule the other cards use between sections — the
                         unlock's numbers while it is applied. -->
                    <ui:Card Margin="12,8,0,16"
                             Padding="15"
                             HorizontalAlignment="Center">
                        <StackPanel>
                            <Grid HorizontalAlignment="Center" Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="24,0,0,0">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="CPU" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="tbPl1Label" Grid.Row="0" Grid.Column="0" Width="120" FontSize="13" Text="Sustained (SPL)" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="tbPl1" FontSize="13" FontWeight="SemiBold" Text="-- W" />

                                        <TextBlock x:Name="tbPl2Label" Grid.Row="1" Grid.Column="0" FontSize="13" Text="Boost (FPL)" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="tbPl2" FontSize="13" FontWeight="SemiBold" Text="-- W" Margin="0,4,0,0" />

                                        <TextBlock x:Name="tbTjMaxLabel" Grid.Row="2" Grid.Column="0" Width="120" FontSize="13" Text="TjMax" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="tbTjMax" FontSize="13" FontWeight="SemiBold" Text="-- °C" Margin="0,4,0,0" />

                                        <TextBlock x:Name="tbCoLabel" Grid.Row="3" Grid.Column="0" Width="120" FontSize="13" Text="CO Offset" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="tbCoOffset" FontSize="13" FontWeight="SemiBold" Text="-- | --" Margin="0,4,0,0" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Margin="0,0,24,0">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="GPU" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Width="120" FontSize="13" Text="GPU TGP" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="tbGpuTgp" FontSize="13" FontWeight="SemiBold" Text="-- W" />

                                        <TextBlock x:Name="tbDbLabel" Grid.Row="1" Grid.Column="0" FontSize="13" Text="Dynamic Boost" Margin="0,4,0,0" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="tbGpuDb" Grid.Row="1" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Text="Off" Margin="0,4,0,0" />

                                        <TextBlock x:Name="tbCoreLabel" Grid.Row="2" Grid.Column="0" FontSize="13" Text="Core Offset" Margin="0,4,0,0" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="tbCoreClock" Grid.Row="2" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Text="--" Margin="0,4,0,0" />

                                        <TextBlock x:Name="tbMemLabel" Grid.Row="3" Grid.Column="0" FontSize="13" Text="Memory Offset" Margin="0,4,0,0" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="tbMemClock" Grid.Row="3" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Text="--" Margin="0,4,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- The unlock's numbers, read back from the driver. It exists only
                                 while the unlock is applied; with it off the card already says
                                 what the GPU is running on. The colour carries the verdict; a
                                 number the driver could not be asked for stays a dash pair,
                                 and the card's reason line says why. -->
                            <StackPanel x:Name="spRomStatusRow" Visibility="Collapsed">
                                <Border Height="1"
                                        Margin="0,12,0,10"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="24,0,24,0" VerticalAlignment="Center">
                                    <ui:TextBlock FontTypography="BodyStrong"
                                                  VerticalAlignment="Center"
                                                  Text="Extra GPU power" />

                                    <!-- The one state with nothing to measure: the unlock is
                                         live while the feature that owns it is off. One line,
                                         and the two ways out of it. -->
                                    <ui:TextBlock x:Name="tbRomStatusPbmOff"
                                                  MaxWidth="480"
                                                  Margin="24,0,0,0"
                                                  VerticalAlignment="Center"
                                                  FontTypography="Caption"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  TextWrapping="Wrap"
                                                  Visibility="Collapsed"
                                                  Text="Extra GPU power is applied but Power boost mode is off. Restore stock to turn it off, or turn Power boost mode on." />

                                    <StackPanel x:Name="spRomStatusValues" Orientation="Horizontal" Margin="24,0,0,0">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="TGP" />
                                            <TextBlock x:Name="tbRomStatRequest" Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Text="-- W" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Budget" />
                                            <TextBlock x:Name="tbRomStatBudget" Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Text="-- W" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="NVVDD" />
                                            <TextBlock x:Name="tbRomStatNvvdd" Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Text="-- A" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="MSVDD" />
                                            <TextBlock x:Name="tbRomStatMsvdd" Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Text="-- A" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Board input" />
                                            <TextBlock x:Name="tbRomStatBoard" Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Text="-- A" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- ===== CUSTOM PANEL (hidden by default) ===== -->
                    <StackPanel x:Name="customScroll" Visibility="Collapsed">

                        <!-- CPU Power Tuning (SMU) -->
                        <ui:CardExpander x:Name="sdCpuPower"
                                        Margin="0,0,0,8"
                                        IsEnabled="True"
                                        IsExpanded="False">
                            <ui:CardExpander.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE950;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardExpander.Icon>
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="AMD CPU Power Tuning" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Direct SMU power limits via PCI config space" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <!-- Sustained Power Limit (SPL) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="Sustained (SPL)" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="Slow Power Limit - sustained power ceiling via SMU" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Sustained power limit (SMU slow-limit)" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblSustained"
                                                   Width="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="75 W" />
                                        <Slider x:Name="sdSustained" Width="140" Maximum="160" Minimum="35" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Boost Power Limit (FPL) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="Boost (FPL)" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="Fast Power Limit - short burst ceiling via SMU" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Boost power limit (SMU fast-limit)" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblBoost"
                                                   Width="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="85 W" />
                                        <Slider x:Name="sdBoost" Width="140" Maximum="160" Minimum="35" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- TjMax (AMD only) -->
                                <Grid x:Name="gridCustomTjMax">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="TjMax" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="Maximum CPU temperature before thermal throttling" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Thermal throttle temperature" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblTjMax"
                                                   Width="42"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="95 °C" />
                                        <Slider x:Name="sdTjMax" Width="140" Maximum="105" Minimum="70" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- CO controls container (hidden when EnableCpuVoltageControl is OFF) -->
                                <StackPanel x:Name="coControlsPanel">
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Curve Optimizer mode selection -->
                                <Grid x:Name="gridCustomCoUnified" Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Mode" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Unified, per-CCD or per-core offset" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="2,0"
                                                >
                                        <RadioButton x:Name="rbCoUnified"
                                                     GroupName="CoMode"
                                                     Content="Unified"
                                                     IsChecked="True"
                                                     Margin="0,0,8,0"
                                                     HorizontalContentAlignment="Center"
                                                     FontSize="13"
                                                     Click="rbCoMode_Click"
                                                     Width="90"
                                                     MinWidth="20"/>
                                        <RadioButton x:Name="rbCoPerCcd"
                                                     GroupName="CoMode"
                                                     Content="Per-CCD"
                                                     HorizontalContentAlignment="Center"
                                                     FontSize="13"
                                                     Click="rbCoMode_Click"
                                                     Width="90"
                                                     MinWidth="20"/>
                                        <RadioButton x:Name="rbCoPerCore"
                                                     GroupName="CoMode"
                                                     Content="Per-Core"
                                                     HorizontalContentAlignment="Center"
                                                     FontSize="13"
                                                     Margin="8,0,0,0"
                                                     Click="rbCoMode_Click"
                                                     Width="90"
                                                     MinWidth="20"/>
                                    </StackPanel>
                                </Grid>
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Unified voltage offset slider -->
                                <Grid x:Name="gridCustomCoUnifiedSlider">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="Offset" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="~3-5 mV per 1 point" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="All-core offset (-50 to 0)" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblCoUnified"
                                                   Width="30"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="0" />
                                        <Slider x:Name="sdCoUnified" Width="140" Maximum="0" Minimum="-50" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- CCD 0 Voltage Offset (AMD only) -->
                                <Grid x:Name="gridCustomCoCcd0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock FontTypography="Body" Text="CCD 0 Offset" VerticalAlignment="Center"/>
                                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="~3-5 mV per 1 point" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,4">
                                        <TextBlock x:Name="lblCoCcd0"
                                                   Width="30"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="0" />
                                        <Slider x:Name="sdCoCcd0" Width="140" Maximum="0" Minimum="-50" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- Divider (visible only in Per-CCD mode) -->
                                <Border x:Name="dividerCoPerCcd" Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- CCD 1 Voltage Offset (AMD only) -->
                                <Grid x:Name="gridCustomCoCcd1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock FontTypography="Body" Text="CCD 1 Offset" VerticalAlignment="Center"/>
                                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="~3-5 mV per 1 point" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,4">
                                        <TextBlock x:Name="lblCoCcd1"
                                                   Width="30"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="0" />
                                        <Slider x:Name="sdCoCcd1" Width="140" Maximum="0" Minimum="-50" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- Per-core offsets (AMD only) -->
                                <Grid x:Name="gridCustomCoPerCore" Margin="0,4,0,4" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Per-Core Offsets" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="One offset per physical core" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblCoPerCore"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Button x:Name="btnCoPerCore"
                                                Content="Configure per core…"
                                                Click="btnCoPerCore_Click"
                                                Padding="12,4" />
                                    </StackPanel>
                                </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>

  
                        <!-- Intel Tuning (Intel only) -->
                        <ui:CardExpander x:Name="sdIntelTuning"
                                        Margin="0,0,0,8"
                                        IsEnabled="True"
                                        IsExpanded="False">
                            <ui:CardExpander.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE950;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardExpander.Icon>
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="Intel CPU Tuning" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="MSR-based power, voltage, and ratio controls" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <!-- Intel PL1 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="PL1" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="Intel sustained power limit (MSR 0x610)" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Sustained power limit" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblIntelPl1"
                                                   Width="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="45 W" />
                                        <Slider x:Name="sdIntelPl1" Width="140" Maximum="200" Minimum="10" Value="45" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Intel PL2 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="PL2" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="Intel boost power limit (MSR 0x610)" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Boost power limit" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblIntelPl2"
                                                   Width="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="60 W" />
                                        <Slider x:Name="sdIntelPl2" Width="140" Maximum="200" Minimum="10" Value="60" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- Intel Undervolt controls container — removed: voltage control is AMD-only -->
                                <StackPanel x:Name="intelVoltControlsPanel" Visibility="Collapsed">
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Intel Undervolt CPU -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="Offset" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="CPU voltage offset (MSR 0x150 plane 0)" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Voltage offset" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblIntelVolt"
                                                   Width="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="0 mV" />
                                        <Slider x:Name="sdIntelVolt" Width="140" Maximum="0" Minimum="-100" Value="0" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>

                        <!-- GPU Tuning -->
                        <ui:CardExpander x:Name="sdNvidia"
                                        Margin="0,0,0,8"
                                        IsEnabled="True"
                                        IsExpanded="False">
                            <ui:CardExpander.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF211;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardExpander.Icon>
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="Nvidia GPU Tuning" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="GPU power limit, core and memory clock offsets" />
                                    <!-- Why the controls are inert, when they are: the engine has no
                                         power table to write from. In the header so the reason is
                                         readable without expanding the card. -->
                                    <TextBlock x:Name="tbGpuPowerReason"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel x:Name="sdNvidiaBody">
                                <!-- GPU Power Limit (TGP base) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="TGP" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Base power limit of the GPU" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblNvPower"
                                                   Width="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="150 W" />
                                        <Slider x:Name="sdNvPower" Width="140" Maximum="175" Minimum="50" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- Dynamic Boost Controls (hidden when Power boost mode is ON) -->
                                <StackPanel x:Name="DynamicBoostPanel">
                                    <!-- Divider -->
                                    <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                    <!-- Dynamic Boost Toggle -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:TextBlock FontTypography="Body" Text="Dynamic Boost" />
                                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="Allow GPU to borrow power from CPU" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ui:TextBlock Margin="0,2,0,0"
                                                           FontTypography="Caption"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="Enable NVIDIA Dynamic Boost" />
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="togDynamicBoost" Grid.Column="1" Margin="4,0,0,0" LabelPosition="Left" OnContent="On" OffContent="Off" Checked="togDynamicBoost_Checked" Unchecked="togDynamicBoost_Unchecked" />
                                    </Grid>
                                    <!-- Dynamic Boost Offset (hidden when toggle is off) -->
                                    <StackPanel x:Name="spNvDbOffset" Visibility="Collapsed">
                                        <!-- Divider -->
                                        <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                        <Grid Margin="0,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body" Text="Dynamic Boost Offset" />
                                            <ui:TextBlock Margin="0,2,0,0"
                                                           FontTypography="Caption"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="Extra GPU power borrowed from CPU" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    >
                                            <TextBlock x:Name="lblNvDbOffset"
                                                       Width="48"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Text="5 W" />
                                            <Slider x:Name="sdNvDbOffset" Width="140" Maximum="25" Minimum="0" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                </StackPanel>
                                <!-- GPU Clock Controls (hidden when EnableGpuClockControl is OFF) -->
                                <StackPanel x:Name="GpuClockControlsPanel">
                                    <!-- Divider -->
                                    <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                    <!-- Curve Editor Button -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body" Text="Curve Editor" />
                                            <ui:TextBlock Margin="0,2,0,0"
                                                           FontTypography="Caption"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="Edit voltage-frequency curve per point" />
                                        </StackPanel>
                                        <Button x:Name="btnVfCurve"
                                                Grid.Column="1"
                                                Content="Edit Curve"
                                                Click="btnVfCurve_Click"
                                                Margin="4,0,0,0"
                                                Padding="12,4" />
                                    </Grid>
                                    <!-- Divider -->
                                    <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                    <!-- Core Clock Offset -->
                                    <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <ui:TextBlock FontTypography="Body" Text="Core Clock Offset" />
                                                <ui:TextBlock Margin="0,2,0,0"
                                                               FontTypography="Caption"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               Text="Uniform core frequency offset" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <TextBlock x:Name="lblNvCore"
                                                           Width="60"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Text="0 MHz" />
                                                <Slider x:Name="sdNvCore"
                                                        Width="140"
                                                        Maximum="1000"
                                                        Minimum="-1000"
                                                        TickFrequency="5"
                                                        SmallChange="5"
                                                        LargeChange="25"
                                                        IsSnapToTickEnabled="True"
                                                        TickPlacement="None"
                                                        VerticalAlignment="Center"
                                                        TouchDown="SizeSlider_TouchDown"
                                                        ValueChanged="Slider_ValueChanged" />
                                            </StackPanel>
                                        </Grid>
                                    <!-- Divider -->
                                    <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                    <!-- Memory Clock Offset -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body" Text="Memory Clock Offset" />
                                            <ui:TextBlock Margin="0,2,0,0"
                                                           FontTypography="Caption"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="Memory frequency offset" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <!-- Wider than the core row's 60: four digits plus the unit clip there. The slider is fixed at 140 and the column is Auto right-aligned, so the slider stays put and only the value box grows leftwards. -->
                                            <TextBlock x:Name="lblNvMem"
                                                       Width="76"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Text="0 MHz" />
                                            <Slider x:Name="sdNvMem" Width="140" Maximum="3000" Minimum="-1000" TickFrequency="50" IsSnapToTickEnabled="True" TickPlacement="None" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>
                        <!-- GPU power ceiling override: a machine-wide driver setting, kept with
                             the tuning editors it belongs beside. Collapsed by default: the act is
                             one statement and two buttons, and each measurement lives in the
                             quick configuration it belongs to. The numbers the unlock produces are
                             on the status card above, so this card never repeats them. -->
                        <ui:CardExpander x:Name="cardRomOverride"
                                         Margin="0,0,0,8"
                                         IsEnabled="True"
                                         IsExpanded="False"
                                         Visibility="Collapsed">
                            <ui:CardExpander.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE945;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardExpander.Icon>
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="Extra GPU power" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Raises the GPU's power ceiling at driver level" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <!-- Power boost mode off while an override is live: the card is
                                     shown for one reason only - removing the override. The line
                                     says why, and Restore stock is the act. -->
                                <ui:TextBlock x:Name="tbRomPbmOffLine"
                                              Margin="0,8,0,0"
                                              FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              TextWrapping="Wrap"
                                              Visibility="Collapsed"
                                              Text="Extra GPU power is applied but Power boost mode is off. Restore stock to turn it off, or turn Power boost mode on." />

                                <!-- One row: the statement on the left, both actions on the right,
                                     because the statement is what gates them. Both actions stay on
                                     the card - the irrelevant one is disabled and explained, never
                                     hidden and never a silent no-op. The "still applied, feature
                                     off" state has nothing to state, so the checkbox and the rule
                                     above it go and Restore stock stands alone in the row. -->
                                <StackPanel>
                                    <Border x:Name="brRomConsent" Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox x:Name="chkRomConsent"
                                                  Grid.Column="0"
                                                  Margin="0,0,16,0"
                                                  VerticalAlignment="Center"
                                                  FontSize="12"
                                                  Checked="chkRomConsent_Changed"
                                                  Unchecked="chkRomConsent_Changed">
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="I understand this changes driver-level settings and restarts the GPU" />
                                        </CheckBox>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <ui:Button x:Name="btnRomUnlock"
                                                       Padding="16,6"
                                                       Appearance="Primary"
                                                       Click="btnRomUnlock_Click"
                                                       Content="Unlock extra GPU power" />
                                            <ui:Button x:Name="btnRomRestore"
                                                       Margin="8,0,0,0"
                                                       Padding="16,6"
                                                       Appearance="Secondary"
                                                       Click="btnRomRestore_Click"
                                                       Content="Restore stock" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                                <!-- Three measured configurations, one click each, for a card that is
                                     already unlocked: they set the target and that tier's three rail
                                     currents, and 250 W also sets this unit's clock offsets. Each
                                     button's caption is its tooltip, so the row is one line and the
                                     numbers stay one hover - or one Tab stop - away. The 250 W set's
                                     adapter caution keeps a visible marker on the button itself: a
                                     caution may not live only in a tooltip. Label and buttons share
                                     one row: the label is the row's left column, the three buttons
                                     its right. Each button carries that tier's warning colour as its
                                     fill; the foreground is the matching text token, so the pairing
                                     reads on the light tint and on the dark one. The template's own
                                     hover, pressed and disabled states still own the background while
                                     they are active, so a disabled button is never a coloured one. -->
                                <StackPanel x:Name="spQuickApply">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:TextBlock Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      FontTypography="BodyStrong"
                                                      Text="Quick configurations" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ui:Button x:Name="btnApply200"
                                                       Margin="0,0,8,0"
                                                       Padding="16,6"
                                                       Appearance="Secondary"
                                                       Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                       Click="btnApply200_Click"
                                                       ToolTipService.ShowDuration="60000"
                                                       ToolTipService.ShowOnDisabled="True"
                                                       Content="Apply 200 W">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock x:Name="tbQuick200Tip"
                                                                   MaxWidth="400"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    </ToolTip>
                                                </ToolTipService.ToolTip>
                                            </ui:Button>

                                            <ui:Button x:Name="btnApply225"
                                                       Margin="0,0,8,0"
                                                       Padding="16,6"
                                                       Appearance="Secondary"
                                                       Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       Click="btnApply225_Click"
                                                       ToolTipService.ShowDuration="60000"
                                                       ToolTipService.ShowOnDisabled="True"
                                                       Content="Apply 225 W (tested)">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock x:Name="tbQuick225Tip"
                                                                   MaxWidth="400"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    </ToolTip>
                                                </ToolTipService.ToolTip>
                                            </ui:Button>

                                            <ui:Button x:Name="btnApply250"
                                                       Padding="16,6"
                                                       Appearance="Secondary"
                                                       Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                       Click="btnApply250_Click"
                                                       ToolTipService.ShowDuration="60000"
                                                       ToolTipService.ShowOnDisabled="True">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- The caution the rails block carries, as the one
                                                         visible part of it that cannot be hovered away. -->
                                                    <ui:FontIcon FontFamily="Segoe Fluent Icons"
                                                                 Glyph="&#xE7BA;"
                                                                 FontSize="14"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                    <TextBlock VerticalAlignment="Center"
                                                               Text="Apply 250 W" />
                                                </StackPanel>
                                                <ToolTipService.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock x:Name="tbQuick250Tip"
                                                                   MaxWidth="400"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    </ToolTip>
                                                </ToolTipService.ToolTip>
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Why the three are dimmed, when they are: the same one line the
                                         card uses for its own actions. -->
                                    <TextBlock x:Name="tbQuickApplyReason"
                                               Margin="0,8,0,0"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <!-- One line, and only for a state that needs explaining: a refusal,
                                     a partial apply, a read that failed, or why an action is
                                     dimmed. A clean unlock says itself in the status card's row. -->
                                <TextBlock x:Name="tbRomOverrideNote"
                                           Margin="0,8,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <StackPanel x:Name="spRomBusy"
                                            Margin="0,10,0,0"
                                            Visibility="Collapsed">
                                    <ProgressBar Height="4" IsIndeterminate="True" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Restarting the GPU. The screen may go blank for up to 60 seconds." />
                                </StackPanel>

                                <!-- Divider -->
                                <Border x:Name="brRailDivider" Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                                <!-- The runtime rail currents. A live NVAPI write (no restart, no
                                     blank screen, no consent), so it follows the unlock's state:
                                     inert and explained until it is applied. The page's Apply writes
                                     them, in the same act that applies the preset, and the slot
                                     carries them, so a preset switch moves them with the rest of its
                                     values. One block with its divider, because the card's "override
                                     is still live" state shows no sliders at all. -->
                                <StackPanel x:Name="spRailSection">
                                    <StackPanel x:Name="spRailControls">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <ui:TextBlock FontTypography="Body" Text="NVVDD (GPU core)" />
                                                <ui:TextBlock x:Name="tbRailNvvdd"
                                                               Margin="0,2,0,0"
                                                               FontTypography="Caption"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               TextWrapping="Wrap"
                                                               Text="-- A" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <TextBlock x:Name="lblRailNvvdd"
                                                           Width="64"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Text="-- A" />
                                                <Slider x:Name="sdRailNvvdd"
                                                        Width="140"
                                                        VerticalAlignment="Center"
                                                        TickPlacement="Both"
                                                        TickFrequency="5000"
                                                        SmallChange="1000"
                                                        LargeChange="5000"
                                                        IsSnapToTickEnabled="False"
                                                        ValueChanged="RailSlider_ValueChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Divider -->
                                        <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <ui:TextBlock FontTypography="Body" Text="MSVDD (memory)" />
                                                <ui:TextBlock x:Name="tbRailMsvdd"
                                                               Margin="0,2,0,0"
                                                               FontTypography="Caption"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               TextWrapping="Wrap"
                                                               Text="-- A" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <TextBlock x:Name="lblRailMsvdd"
                                                           Width="64"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Text="-- A" />
                                                <Slider x:Name="sdRailMsvdd"
                                                        Width="140"
                                                        VerticalAlignment="Center"
                                                        TickPlacement="Both"
                                                        TickFrequency="1000"
                                                        SmallChange="1000"
                                                        LargeChange="5000"
                                                        IsSnapToTickEnabled="False"
                                                        ValueChanged="RailSlider_ValueChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Divider -->
                                        <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <ui:TextBlock FontTypography="Body" Text="Board input" />
                                                <ui:TextBlock x:Name="tbRailBoardInput"
                                                               Margin="0,2,0,0"
                                                               FontTypography="Caption"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               TextWrapping="Wrap"
                                                               Text="-- A" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <TextBlock x:Name="lblRailBoardInput"
                                                           Width="64"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Text="-- A" />
                                                <Slider x:Name="sdRailBoardInput"
                                                        Width="140"
                                                        VerticalAlignment="Center"
                                                        TickPlacement="Both"
                                                        TickFrequency="250"
                                                        SmallChange="100"
                                                        LargeChange="1000"
                                                        IsSnapToTickEnabled="False"
                                                        ValueChanged="RailSlider_ValueChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Warn, never clamp: this is the setting that can outdraw the
                                             adapter once the CPU is loaded too. -->
                                        <TextBlock x:Name="tbRailCaution"
                                                   Margin="0,6,0,0"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Visibility="Collapsed"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                   Text="Above 14.0 A the GPU can outdraw what the laptop's power adapter supplies once the CPU is also loaded — we have seen this machine fail with an out-of-memory error. Nothing is clamped here." />
                                    </StackPanel>

                                    <!-- Outside the disabled group: a reason a dimmed control
                                         cannot state for itself. -->
                                    <TextBlock x:Name="tbRailNote"
                                               Margin="0,6,0,0"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock x:Name="tbRailReason"
                                               Margin="0,2,0,0"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>

 
                    </StackPanel>
                    <!-- end customScroll StackPanel -->
                </StackPanel>
                <!-- end Row 1 content StackPanel -->
            </Grid>
        </ScrollViewer>

        <!-- Row 1: Bottom bar with Custom preset RadioButtons (left) and Save/Apply (right) -->
        <ui:Card Grid.Row="1"
              x:Name="bottomBar"
              Visibility="Collapsed"
              Margin="12,8,16,12"
              Padding="12,8"
              MaxWidth="1052"
              >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: 5 Custom preset RadioButtons -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBlock Text="Profile: "
                              VerticalAlignment="Center"
                              FontSize="13"
                              Margin="0,0,8,0"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <RadioButton x:Name="rbProfile1"
                             GroupName="CustomProfile"
                             Content="1"
                             IsChecked="True"
                             MinWidth="50"
                             Width="36"
                             Margin="0,0,12,0"
                             HorizontalContentAlignment="Center"
                             FontSize="13"
                             Click="rbProfile_Click" />
                <RadioButton x:Name="rbProfile2"
                             GroupName="CustomProfile"
                             Content="2"
                             MinWidth="50"
                             Width="36"
                             Margin="0,0,12,0"
                             HorizontalContentAlignment="Center"
                             FontSize="13"
                             Click="rbProfile_Click" />
                <RadioButton x:Name="rbProfile3"
                             GroupName="CustomProfile"
                             Content="3"
                             MinWidth="50"
                             Margin="0,0,12,0"
                             HorizontalContentAlignment="Center"
                             FontSize="13"
                             Click="rbProfile_Click" />
                <RadioButton x:Name="rbProfile4"
                             GroupName="CustomProfile"
                             Content="4"
                             MinWidth="50"
                             Margin="0,0,12,0"
                             HorizontalContentAlignment="Center"
                             FontSize="13"
                             Click="rbProfile_Click" />
                <RadioButton x:Name="rbProfile5"
                             GroupName="CustomProfile"
                             Content="5"
                             MinWidth="60"
                             Margin="0,0,12,0"
                             HorizontalContentAlignment="Center"
                             FontSize="13"
                             Click="rbProfile_Click" />
            </StackPanel>

            <!-- Center: Boost mode label (hidden by default) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:TextBlock x:Name="lblPresetMode"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                               Visibility="Collapsed" />
            </StackPanel>

            <!-- Right: Clear, Save + Apply buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="btnClear"
                           Appearance="Secondary"
                           Click="btnClear_Click"
                           Margin="0,0,8,0"
                           Height="36"
                           Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="16" Margin="0,0,12,0" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </ui:Button>
                <ui:Button x:Name="btnSave"
                           Appearance="Secondary"
                           Click="btnSave_Click"
                           Margin="0,0,8,0"
                           Height="36"
                           Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74E;" FontSize="16" Margin="0,0,12,0" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </ui:Button>
                <ui:Button x:Name="btnApply"
                           Appearance="Primary"
                           Click="btnApply_Click"
                           Height="36"
                           Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" FontSize="16" Margin="0,0,12,0" />
                        <TextBlock Text="Apply" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Dark overlay for Adaptive Mode override (full-page, covers all rows) -->
        <Border x:Name="overlayAdaptiveWarning"
                Grid.Row="0"
                Grid.RowSpan="2"
                Panel.ZIndex="10"
                Visibility="Collapsed"
                Background="{DynamicResource SmokeFillColorDefaultBrush}"
                CornerRadius="4,0,0,0"
                IsHitTestVisible="True"/>
        <!-- SnackbarPresenter for Adaptive Mode override warning and preset save/clear feedback -->
        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="11" MaxWidth="1080"
                              HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="0,0,0,0"/>
    </Grid>
</Page>
