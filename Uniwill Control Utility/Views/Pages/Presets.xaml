<Page x:Class="Uniwill_Control_Utility.Views.Pages.Presets"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Uniwill_Control_Utility.Views.Pages"
      xmlns:controls="clr-namespace:Uniwill_Control_Utility.Views.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      d:DataContext="{d:DesignInstance local:Presets, IsDesignTimeCreatable=False}"
      d:Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d"
      d:DesignHeight="1200"
      d:DesignWidth="900"
      Title="Presets"
      Loaded="Page_Loaded"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <Style x:Key="ProfileButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ProfileButtonActiveStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <!-- Root Grid with two rows: scrollable content + bottom bar -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Full-width, full-height ScrollViewer -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      IsDeferredScrollingEnabled="False">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ScrollViewer.Style>

            <!-- Centered max-width layout container -->
            <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Page title block -->
                <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,16,0,0">
                    <TextBlock FontSize="26"
                               FontWeight="Medium"
                               Margin="14,0,16,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="Power Presets" />
                    <TextBlock Margin="14,8,16,12"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Select one of the default power presets or create your own one."
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Row 1: Content cards -->
                <StackPanel Grid.Row="1" Margin="12,16,16,18">

                    <!-- Profile Selector Card -->
                    <ui:Card Margin="0,0,0,8"
                             Padding="8"
                             SnapsToDevicePixels="True">
                        <UniformGrid Columns="4" Rows="1">
                            <Button x:Name="btnOffice" Style="{StaticResource ProfileButtonStyle}" Click="btnOffice_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BE;" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" Text="Office" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnGaming" Style="{StaticResource ProfileButtonStyle}" Click="btnGaming_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE967;" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" Text="Gaming" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnTurbo" Style="{StaticResource ProfileButtonStyle}" Click="btnTurbo_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE945;" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" Text="Turbo" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnCustom" Style="{StaticResource ProfileButtonStyle}" Click="btnCustom_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" Text="Custom" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </ui:Card>

                    <!-- Status Card -->
                    <ui:Card Margin="12,8,0,16" 
                             Padding="15"
                             HorizontalAlignment="Center">
                        <Grid HorizontalAlignment="Center" Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="24,0,0,0">
                                <ui:TextBlock FontTypography="BodyStrong" Text="CPU" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="tbPl1Label" Grid.Row="0" Grid.Column="0" Width="120" FontSize="13" Text="Sustained (SPL)" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="tbPl1" FontSize="13" FontWeight="SemiBold" Text="-- W" />

                                    <TextBlock x:Name="tbPl2Label" Grid.Row="1" Grid.Column="0" FontSize="13" Text="Boost (FPL)" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="tbPl2" FontSize="13" FontWeight="SemiBold" Text="-- W" Margin="0,4,0,0" />

                                    <TextBlock x:Name="tbTjMaxLabel" Grid.Row="2" Grid.Column="0" Width="120" FontSize="13" Text="TjMax" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="tbTjMax" FontSize="13" FontWeight="SemiBold" Text="-- °C" Margin="0,4,0,0" />

                                    <TextBlock x:Name="tbCoLabel" Grid.Row="3" Grid.Column="0" Width="120" FontSize="13" Text="CO Offset" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="tbCoOffset" FontSize="13" FontWeight="SemiBold" Text="-- | --" Margin="0,4,0,0" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Margin="0,0,24,0
                                        ">
                                <ui:TextBlock FontTypography="BodyStrong" Text="GPU" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Width="120" FontSize="13" Text="GPU TGP" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="tbGpuTgp" FontSize="13" FontWeight="SemiBold" Text="-- W" />

                                    <TextBlock x:Name="tbDbLabel" Grid.Row="1" Grid.Column="0" FontSize="13" Text="Dynamic Boost" Margin="0,4,0,0" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="tbGpuDb" Grid.Row="1" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Text="Off" Margin="0,4,0,0" />

                                    <TextBlock x:Name="tbCoreLabel" Grid.Row="2" Grid.Column="0" FontSize="13" Text="Core Offset" Margin="0,4,0,0" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="tbCoreClock" Grid.Row="2" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Text="--" Margin="0,4,0,0" />

                                    <TextBlock x:Name="tbMemLabel" Grid.Row="3" Grid.Column="0" FontSize="13" Text="Memory Offset" Margin="0,4,0,0" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="tbMemClock" Grid.Row="3" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Text="--" Margin="0,4,0,0" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <!-- ===== CUSTOM PANEL (hidden by default) ===== -->
                    <StackPanel x:Name="customScroll" Visibility="Collapsed">

                        <!-- CPU Power Tuning (SMU) -->
                        <ui:CardExpander x:Name="sdCpuPower"
                                        Margin="0,0,0,8"
                                        IsEnabled="True"
                                        IsExpanded="False">
                            <ui:CardExpander.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE950;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardExpander.Icon>
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="AMD CPU Power Tuning" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Direct SMU power limits via PCI config space." />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <!-- Sustained Power Limit (SPL) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="Sustained (SPL)" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="Slow Power Limit - sustained power ceiling via SMU" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Sustained power limit (SMU slow-limit)" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblSustained"
                                                   Width="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="75 W" />
                                        <Slider x:Name="sdSustained" Width="140" Maximum="160" Minimum="45" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Boost Power Limit (FPL) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="Boost (FPL)" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="Fast Power Limit - short burst ceiling via SMU" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Boost power limit (SMU fast-limit)" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblBoost"
                                                   Width="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="85 W" />
                                        <Slider x:Name="sdBoost" Width="140" Maximum="160" Minimum="45" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- TjMax (AMD only) -->
                                <Grid x:Name="gridCustomTjMax">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="TjMax" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="Maximum CPU temperature before thermal throttling" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Thermal throttle temperature" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblTjMax"
                                                   Width="42"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="95 °C" />
                                        <Slider x:Name="sdTjMax" Width="140" Maximum="105" Minimum="70" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- CO controls container (hidden when DisableCpuVoltageControl is ON) -->
                                <StackPanel x:Name="coControlsPanel">
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Curve Optimizer mode selection -->
                                <Grid x:Name="gridCustomCoUnified" Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Mode" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Unified or per-CCD offset" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="2,0"
                                                >
                                        <RadioButton x:Name="rbCoUnified"
                                                     GroupName="CoMode"
                                                     Content="Unified"
                                                     IsChecked="True"
                                                     Margin="0,0,8,0"
                                                     HorizontalContentAlignment="Center"
                                                     FontSize="13"
                                                     Click="rbCoMode_Click"
                                                     Width="90"
                                                     MinWidth="20"/>
                                        <RadioButton x:Name="rbCoPerCcd"
                                                     GroupName="CoMode"
                                                     Content="Per-CCD"
                                                     HorizontalContentAlignment="Center"
                                                     FontSize="13"
                                                     Click="rbCoMode_Click"
                                                     Width="90"
                                                     MinWidth="20"/>
                                    </StackPanel>
                                </Grid>
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Unified voltage offset slider -->
                                <Grid x:Name="gridCustomCoUnifiedSlider">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="Offset" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="~3-5 mV per 1 point" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="All-core offset (-50 to 0)" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblCoUnified"
                                                   Width="30"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="0" />
                                        <Slider x:Name="sdCoUnified" Width="140" Maximum="0" Minimum="-50" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- CCD 0 Voltage Offset (AMD only) -->
                                <Grid x:Name="gridCustomCoCcd0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock FontTypography="Body" Text="CCD 0 Offset" VerticalAlignment="Center"/>
                                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="~3-5 mV per 1 point" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,4">
                                        <TextBlock x:Name="lblCoCcd0"
                                                   Width="30"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="0" />
                                        <Slider x:Name="sdCoCcd0" Width="140" Maximum="0" Minimum="-50" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- Divider (visible only in Per-CCD mode) -->
                                <Border x:Name="dividerCoPerCcd" Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- CCD 1 Voltage Offset (AMD only) -->
                                <Grid x:Name="gridCustomCoCcd1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock FontTypography="Body" Text="CCD 1 Offset" VerticalAlignment="Center"/>
                                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="~3-5 mV per 1 point" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,4">
                                        <TextBlock x:Name="lblCoCcd1"
                                                   Width="30"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="0" />
                                        <Slider x:Name="sdCoCcd1" Width="140" Maximum="0" Minimum="-50" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>

  
                        <!-- Intel Tuning (Intel only) -->
                        <ui:CardExpander x:Name="sdIntelTuning"
                                        Margin="0,0,0,8"
                                        IsEnabled="True"
                                        IsExpanded="False">
                            <ui:CardExpander.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE950;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardExpander.Icon>
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="Intel CPU Tuning" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="MSR-based power, voltage, and ratio controls." />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <!-- Intel PL1 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="PL1" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="Intel sustained power limit (MSR 0x610)" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Sustained power limit" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblIntelPl1"
                                                   Width="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="45 W" />
                                        <Slider x:Name="sdIntelPl1" Width="140" Maximum="200" Minimum="10" Value="45" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Intel PL2 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="PL2" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="Intel boost power limit (MSR 0x610)" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Boost power limit" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblIntelPl2"
                                                   Width="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="60 W" />
                                        <Slider x:Name="sdIntelPl2" Width="140" Maximum="200" Minimum="10" Value="60" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- Intel Undervolt controls container (hidden when DisableCpuVoltageControl is ON) -->
                                <StackPanel x:Name="intelVoltControlsPanel">
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Intel Undervolt CPU -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="Offset" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="CPU voltage offset (MSR 0x150 plane 0)" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Voltage offset" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblIntelVolt"
                                                   Width="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="0 mV" />
                                        <Slider x:Name="sdIntelVolt" Width="140" Maximum="0" Minimum="-100" Value="0" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>

                        <!-- GPU Tuning -->
                        <ui:CardExpander x:Name="sdNvidia"
                                        Margin="0,0,0,8"
                                        IsEnabled="True"
                                        IsExpanded="False">
                            <ui:CardExpander.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF211;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardExpander.Icon>
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="Nvidia GPU Tuning" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="GPU power limit, core and memory clock offsets." />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <!-- GPU Power Limit (TGP base) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="TGP" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Base power limit of the GPU" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblNvPower"
                                                   Width="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="150 W" />
                                        <Slider x:Name="sdNvPower" Width="140" Maximum="175" Minimum="50" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- Dynamic Boost Controls (hidden when GPU Power Boost is ON) -->
                                <StackPanel x:Name="DynamicBoostPanel">
                                    <!-- Divider -->
                                    <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                    <!-- Dynamic Boost Toggle -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:TextBlock FontTypography="Body" Text="Dynamic Boost" />
                                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="Allow GPU to borrow power from CPU" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ui:TextBlock Margin="0,2,0,0"
                                                           FontTypography="Caption"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="Enable NVIDIA Dynamic Boost" />
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="togDynamicBoost" Grid.Column="1" Margin="4,0,0,0" LabelPosition="Left" OnContent="On" OffContent="Off" Checked="togDynamicBoost_Checked" Unchecked="togDynamicBoost_Unchecked" />
                                    </Grid>
                                    <!-- Dynamic Boost Offset (hidden when toggle is off) -->
                                    <StackPanel x:Name="spNvDbOffset" Visibility="Collapsed">
                                        <!-- Divider -->
                                        <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                        <Grid Margin="0,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body" Text="Dynamic Boost Offset" />
                                            <ui:TextBlock Margin="0,2,0,0"
                                                           FontTypography="Caption"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="Extra GPU power borrowed from CPU" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    >
                                            <TextBlock x:Name="lblNvDbOffset"
                                                       Width="48"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Text="5 W" />
                                            <Slider x:Name="sdNvDbOffset" Width="140" Maximum="25" Minimum="0" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                </StackPanel>
                                <!-- GPU Clock Controls (hidden when DisableGpuClockControl is ON) -->
                                <StackPanel x:Name="GpuClockControlsPanel">
                                    <!-- Divider -->
                                    <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                    <!-- Curve Editor Button -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body" Text="Curve Editor" />
                                            <ui:TextBlock Margin="0,2,0,0"
                                                           FontTypography="Caption"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="Edit voltage-frequency curve per point" />
                                        </StackPanel>
                                        <Button x:Name="btnVfCurve"
                                                Grid.Column="1"
                                                Content="Edit Curve"
                                                Click="btnVfCurve_Click"
                                                Margin="4,0,0,0"
                                                Padding="12,4" />
                                    </Grid>
                                    <!-- Divider -->
                                    <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                    <!-- Core Clock Offset -->
                                    <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <ui:TextBlock FontTypography="Body" Text="Core Clock Offset" />
                                                <ui:TextBlock Margin="0,2,0,0"
                                                               FontTypography="Caption"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               Text="Uniform core frequency offset" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <TextBlock x:Name="lblNvCore"
                                                           Width="60"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Text="0 MHz" />
                                                <Slider x:Name="sdNvCore"
                                                        Width="140"
                                                        Maximum="1000"
                                                        Minimum="-1000"
                                                        TickFrequency="50"
                                                        IsSnapToTickEnabled="True"
                                                        TickPlacement="None"
                                                        VerticalAlignment="Center"
                                                        TouchDown="SizeSlider_TouchDown"
                                                        ValueChanged="Slider_ValueChanged" />
                                            </StackPanel>
                                        </Grid>
                                    <!-- Divider -->
                                    <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                    <!-- Memory Clock Offset -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body" Text="Memory Clock Offset" />
                                            <ui:TextBlock Margin="0,2,0,0"
                                                           FontTypography="Caption"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="Memory frequency offset" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="lblNvMem"
                                                       Width="60"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Text="0 MHz" />
                                            <Slider x:Name="sdNvMem" Width="140" Maximum="3000" Minimum="-1000" TickFrequency="50" IsSnapToTickEnabled="True" TickPlacement="None" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>

 
                    </StackPanel>
                    <!-- end customScroll StackPanel -->
                </StackPanel>
                <!-- end Row 1 content StackPanel -->
            </Grid>
        </ScrollViewer>

        <!-- Row 1: Bottom bar with Custom preset RadioButtons (left) and Save/Apply (right) -->
        <ui:Card Grid.Row="1"
              x:Name="bottomBar"
              Visibility="Collapsed"
              Margin="12,8,16,12"
              Padding="12,8"
              MaxWidth="1052"
              >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: 5 Custom preset RadioButtons -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBlock Text="Profile: "
                              VerticalAlignment="Center"
                              FontSize="13"
                              Margin="0,0,8,0"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <RadioButton x:Name="rbProfile1"
                             GroupName="CustomProfile"
                             Content="1"
                             IsChecked="True"
                             MinWidth="50"
                             Width="36"
                             Margin="0,0,12,0"
                             HorizontalContentAlignment="Center"
                             FontSize="13"
                             Click="rbProfile_Click" />
                <RadioButton x:Name="rbProfile2"
                             GroupName="CustomProfile"
                             Content="2"
                             MinWidth="50"
                             Width="36"
                             Margin="0,0,12,0"
                             HorizontalContentAlignment="Center"
                             FontSize="13"
                             Click="rbProfile_Click" />
                <RadioButton x:Name="rbProfile3"
                             GroupName="CustomProfile"
                             Content="3"
                             MinWidth="50"
                             Margin="0,0,12,0"
                             HorizontalContentAlignment="Center"
                             FontSize="13"
                             Click="rbProfile_Click" />
                <RadioButton x:Name="rbProfile4"
                             GroupName="CustomProfile"
                             Content="4"
                             MinWidth="50"
                             Margin="0,0,12,0"
                             HorizontalContentAlignment="Center"
                             FontSize="13"
                             Click="rbProfile_Click" />
                <RadioButton x:Name="rbProfile5"
                             GroupName="CustomProfile"
                             Content="5"
                             MinWidth="60"
                             Margin="0,0,12,0"
                             HorizontalContentAlignment="Center"
                             FontSize="13"
                             Click="rbProfile_Click" />
            </StackPanel>

            <!-- Right: Save + Apply buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="cbApplyOnStartup"
                          Content="Apply on startup"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center"
                          FontSize="13"
                          Click="cbApplyOnStartup_Click" />
                <ui:Button x:Name="btnSave"
                           Appearance="Secondary"
                           Click="btnSave_Click"
                           Margin="0,0,8,0"
                           Height="36"
                           Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74E;" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </ui:Button>
                <ui:Button x:Name="btnApply"
                           Appearance="Primary"
                           Click="btnApply_Click"
                           Height="36"
                           Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="Apply" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Dark overlay for Adaptive Mode override (full-page, covers all rows) -->
        <Border x:Name="overlayAdaptiveWarning"
                Grid.Row="0"
                Grid.RowSpan="2"
                Panel.ZIndex="10"
                Visibility="Collapsed"
                Background="{DynamicResource SmokeFillColorDefaultBrush}"
                CornerRadius="4,0,0,0"
                IsHitTestVisible="True"/>
        <!-- SnackbarPresenter for Adaptive Mode override warning -->
        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="11"  MaxWidth="1080"/>
    </Grid>
</Page>
