<Page x:Class="Uniwill_Control_Utility.Views.Pages.Presets"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Uniwill_Control_Utility.Views.Pages"
      xmlns:controls="clr-namespace:Uniwill_Control_Utility.Views.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      d:DataContext="{d:DesignInstance local:Presets, IsDesignTimeCreatable=False}"
      d:Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d"
      d:DesignHeight="1200"
      d:DesignWidth="900"
      Title="Presets"
      Loaded="Page_Loaded"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <Style x:Key="ProfileButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ProfileButtonActiveStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <!-- Root Grid with two rows: scrollable content + bottom bar -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Full-width, full-height ScrollViewer -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      IsDeferredScrollingEnabled="False">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ScrollViewer.Style>

            <!-- Centered max-width layout container -->
            <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Page title block -->
                <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,24,0,0">
                    <TextBlock FontSize="26"
                               FontWeight="Medium"
                               Margin="16,0,16,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="Power Profiles" />
                    <TextBlock Margin="16,8,16,12"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Select a power profile or customize your own settings."
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Row 1: Content cards -->
                <StackPanel Grid.Row="1" Margin="16,16,16,18">

                    <!-- Profile Selector Card -->
                    <ui:Card Margin="0,0,0,8"
                             Padding="8"
                             RenderOptions.EdgeMode="Aliased"
                             SnapsToDevicePixels="True">
                        <UniformGrid Columns="4" Rows="1">
                            <Button x:Name="btnOffice" Style="{StaticResource ProfileButtonStyle}" Click="btnOffice_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BE;" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" Text="Office" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnGaming" Style="{StaticResource ProfileButtonStyle}" Click="btnGaming_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE967;" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" Text="Gaming" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnTurbo" Style="{StaticResource ProfileButtonStyle}" Click="btnTurbo_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE945;" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" Text="Turbo" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnCustom" Style="{StaticResource ProfileButtonStyle}" Click="btnCustom_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" Text="Custom" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </ui:Card>

                    <!-- Status Card -->
                    <ui:Card Margin="0,0,0,8" 
                             Padding="15"
                             RenderOptions.EdgeMode="Aliased"
                             SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <ui:TextBlock FontTypography="BodyStrong" Text="CPU Power Limits" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Width="120" FontSize="13" Text="Sustained (SPL)" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="tbPl1" FontSize="13" FontWeight="SemiBold" Text="-- W" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="13" Text="Boost (FPL)" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="tbPl2" FontSize="13" FontWeight="SemiBold" Text="-- W" Margin="0,4,0,0" />

                                    <Grid x:Name="gridStatusTjMax" Grid.Row="2" Grid.Column="0" ColumnSpan="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="13" Text="TjMax" Margin="0,4,0,0" />
                                        <TextBlock Grid.Column="1" x:Name="tbTjMax" FontSize="13" FontWeight="SemiBold" Text="-- °C" Margin="0,4,0,0" />
                                    </Grid>

                                    <TextBlock Grid.Row="3" Grid.Column="0" FontSize="13" Text="Curve Optimizer" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="tbCoAll" FontSize="13" FontWeight="SemiBold" Text="--" Margin="0,4,0,0" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <ui:TextBlock FontTypography="BodyStrong" Text="GPU Power Limits" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Width="120" FontSize="13" Text="GPU TGP" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="tbGpuTgp" FontSize="13" FontWeight="SemiBold" Text="-- W" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="13" Text="Dynamic Boost" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="tbGpuDb" FontSize="13" FontWeight="SemiBold" Text="Off" Margin="0,4,0,0" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" FontSize="13" Text="Active Profile" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="tbActiveProfile" FontSize="13" FontWeight="SemiBold" Text="None" Margin="0,4,0,0" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <!-- ===== CUSTOM PANEL (hidden by default) ===== -->
                    <StackPanel x:Name="customScroll" Visibility="Collapsed">

                        <!-- CPU Power Tuning (SMU) -->
                        <ui:CardExpander x:Name="sdCpuPower"
                                        Margin="0,0,0,8"
                                        IsEnabled="True"
                                        IsExpanded="False">
                            <ui:CardExpander.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE950;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardExpander.Icon>
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="CPU Power Tuning" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Direct SMU power limits via PCI config space." />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <!-- Sustained Power Limit (SPL) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="Sustained (SPL)" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="Slow Power Limit - sustained power ceiling via SMU" VerticalAlignment="Top" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Sustained power limit (SMU slow-limit)" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblSustained"
                                                   Width="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="75 W" />
                                        <Slider x:Name="sdSustained" Width="140" Maximum="255" Minimum="5" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="None" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Boost Power Limit (FPL) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="Boost (FPL)" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="Fast Power Limit - short burst ceiling via SMU" VerticalAlignment="Top" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Boost power limit (SMU fast-limit)" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblBoost"
                                                   Width="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="85 W" />
                                        <Slider x:Name="sdBoost" Width="140" Maximum="255" Minimum="5" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="None" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- TjMax (AMD only) -->
                                <Grid x:Name="gridCustomTjMax">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="TjMax" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="Maximum CPU temperature before thermal throttling" VerticalAlignment="Top" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Thermal throttle temperature" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblTjMax"
                                                   Width="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="95 °C" />
                                        <Slider x:Name="sdTjMax" Width="140" Maximum="105" Minimum="70" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                 <!-- Divider -->
                                 <Border x:Name="dividerAfterTjMax" Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                 <!-- Curve Optimizer (AMD only) -->
                                 <Grid x:Name="sdAmdCoAll">
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="*" />
                                         <ColumnDefinition Width="Auto" />
                                     </Grid.ColumnDefinitions>
                                     <StackPanel Grid.Column="0">
                                         <StackPanel Orientation="Horizontal">
                                             <ui:TextBlock FontTypography="Body" Text="Curve Optimizer" />
                                             <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="Global voltage offset. Positive = undervolt." VerticalAlignment="Top" />
                                         </StackPanel>
                                         <ui:TextBlock Margin="0,2,0,0"
                                                        FontTypography="Caption"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        Text="Global voltage offset (all cores)" />
                                     </StackPanel>
                                     <StackPanel Grid.Column="1"
                                                 Orientation="Horizontal"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Center">
                                         <TextBlock x:Name="lblCoAll"
                                                    Width="40"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"
                                                    Text="0" />
                                         <Slider x:Name="sdCoAll" Width="140" Maximum="0" Minimum="-50" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                     </StackPanel>
                                 </Grid>
                            </StackPanel>
                        </ui:CardExpander>

  
                        <!-- Intel Tuning (Intel only) -->
                        <ui:CardExpander x:Name="sdIntelTuning"
                                        Margin="0,0,0,8"
                                        IsEnabled="True"
                                        IsExpanded="False">
                            <ui:CardExpander.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE950;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardExpander.Icon>
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="Intel Tuning" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="MSR-based power, voltage, and ratio controls." />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <!-- Intel PL1 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="PL1" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="Intel sustained power limit (MSR 0x610)" VerticalAlignment="Top" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Sustained power limit" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblIntelPl1"
                                                   Width="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="45 W" />
                                        <Slider x:Name="sdIntelPl1" Width="140" Maximum="400" Minimum="5" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="None" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Intel PL2 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="PL2" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="Intel boost power limit (MSR 0x610)" VerticalAlignment="Top" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Boost power limit" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblIntelPl2"
                                                   Width="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="60 W" />
                                        <Slider x:Name="sdIntelPl2" Width="140" Maximum="400" Minimum="5" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="None" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Intel Undervolt CPU -->
                                <StackPanel>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="CPU Undervolt" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="CPU voltage offset (MSR 0x150 plane 0)" VerticalAlignment="Top" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Voltage offset" />
                                    </StackPanel>
                                    <StackPanel
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblIntelVolt"
                                                   Width="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="0 mV" />
                                        <Slider x:Name="sdIntelVolt" Width="140" Maximum="0" Minimum="-150" TickFrequency="10" IsSnapToTickEnabled="True" TickPlacement="None" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>

                        <!-- GPU Tuning -->
                        <ui:CardExpander x:Name="sdNvidia"
                                        Margin="0,0,0,8"
                                        IsEnabled="True"
                                        IsExpanded="False">
                            <ui:CardExpander.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF211;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardExpander.Icon>
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="GPU Tuning" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="GPU power limit, core and memory clock offsets." />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <!-- GPU Power Limit (TGP base) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="GPU TGP" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="GPU Total Graphics Power (TGP)" VerticalAlignment="Top" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Base power limit" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblNvPower"
                                                   Width="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="150 W" />
                                        <Slider x:Name="sdNvPower" Width="140" Maximum="150" Minimum="0" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Dynamic Boost Toggle -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="Dynamic Boost" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7C3;" FontSize="14" Margin="6,2,0,0" ToolTip="Allow GPU to borrow power from CPU" VerticalAlignment="Top" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Enable NVIDIA Dynamic Boost" />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="togDynamicBoost" Grid.Column="1" Margin="4,0,0,0" LabelPosition="Left" OnContent="On" OffContent="Off" Checked="togDynamicBoost_Checked" Unchecked="togDynamicBoost_Unchecked" />
                                </Grid>
                                <!-- Dynamic Boost Offset (hidden when toggle is off) -->
                                <StackPanel x:Name="spNvDbOffset" Visibility="Collapsed">
                                    <!-- Divider -->
                                    <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body" Text="Dynamic Boost Offset" />
                                            <ui:TextBlock Margin="0,2,0,0"
                                                           FontTypography="Caption"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="Extra GPU power borrowed from CPU" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    >
                                            <TextBlock x:Name="lblNvDbOffset"
                                                       Width="48"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Text="5 W" />
                                            <Slider x:Name="sdNvDbOffset" Width="140" Maximum="25" Minimum="0" TickFrequency="5" IsSnapToTickEnabled="True" TickPlacement="Both" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Curve Editor Button -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:TextBlock FontTypography="Body" Text="Curve Editor" />
                                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="14" Margin="6,2,0,0" ToolTip="Per-point V-F curve editor" VerticalAlignment="Top" />
                                        </StackPanel>
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Edit voltage-frequency curve per point" />
                                    </StackPanel>
                                    <Button x:Name="btnVfCurve"
                                            Grid.Column="1"
                                            Content="Edit Curve"
                                            Click="btnVfCurve_Click"
                                            Margin="4,0,0,0"
                                            Padding="12,4" />
                                </Grid>
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Core Clock Offset (always visible) -->
                                <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body" Text="Core Clock Offset" />
                                            <ui:TextBlock Margin="0,2,0,0"
                                                           FontTypography="Caption"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Text="Uniform core frequency offset" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="lblNvCore"
                                                       Width="60"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Text="0 MHz" />
                                            <Slider x:Name="sdNvCore"
                                                    Width="140"
                                                    Maximum="1000"
                                                    Minimum="-1000"
                                                    TickFrequency="50"
                                                    IsSnapToTickEnabled="True"
                                                    TickPlacement="None"
                                                    VerticalAlignment="Center"
                                                    TouchDown="SizeSlider_TouchDown"
                                                    ValueChanged="Slider_ValueChanged" />
                                        </StackPanel>
                                    </Grid>
                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Memory Clock Offset -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Memory Clock Offset" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Memory frequency offset" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="lblNvMem"
                                                   Width="60"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Text="0 MHz" />
                                        <Slider x:Name="sdNvMem" Width="140" Maximum="2000" Minimum="-1000" TickFrequency="50" IsSnapToTickEnabled="True" TickPlacement="None" VerticalAlignment="Center" TouchDown="SizeSlider_TouchDown" ValueChanged="Slider_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ui:CardExpander>

 
                        <!-- Apply Button -->
                        <ui:Button x:Name="btnApply"
                                   Margin="0,12,0,0"
                                   Height="40"
                                   Appearance="Primary"
                                   HorizontalAlignment="Right"
                                   Click="btnApply_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" FontSize="20" Margin="0,0,8,0" />
                                <TextBlock Text="Apply Settings" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                    <!-- end customScroll StackPanel -->
                </StackPanel>
                <!-- end Row 1 content StackPanel -->
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
