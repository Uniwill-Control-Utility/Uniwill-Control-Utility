<Page x:Class="Uniwill_Control_Utility.Views.Pages.Presets"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Uniwill_Control_Utility.Views.Pages"
      xmlns:controls="clr-namespace:Uniwill_Control_Utility.Views.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      d:DataContext="{d:DesignInstance local:Presets, IsDesignTimeCreatable=False}"
      d:Background="{DynamicResource ApplicationBackgroundBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d"
      d:DesignHeight="1200"
      d:DesignWidth="900"
      Title="Presets"
      Loaded="Page_Loaded"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <Style x:Key="ProfileButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ProfileButtonActiveStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <!-- Root Grid with two rows: scrollable content + bottom bar -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Full-width, full-height ScrollViewer -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      IsDeferredScrollingEnabled="False">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ScrollViewer.Style>

            <!-- Centered max-width layout container -->
            <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Page title block -->
                <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,16,0,0">
                    <TextBlock FontSize="26"
                               FontWeight="Medium"
                               Margin="14,0,16,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="Power Presets" />
                    <TextBlock Margin="14,8,16,12"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Select one of the default power presets or create your own one."
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Row 1: Content cards -->
                <StackPanel Grid.Row="1" Margin="12,16,16,18">

                    <!-- Profile Selector Card -->
                    <ui:Card Margin="0,0,0,8"
                             Padding="8"
                             SnapsToDevicePixels="True">
                        <UniformGrid Columns="4" Rows="1">
                            <Button x:Name="btnOffice" Style="{StaticResource ProfileButtonStyle}" Click="btnOffice_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BE;" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" Text="Office" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnGaming" Style="{StaticResource ProfileButtonStyle}" Click="btnGaming_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE967;" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" Text="Gaming" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnTurbo" Style="{StaticResource ProfileButtonStyle}" Click="btnTurbo_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE945;" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" Text="Turbo" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnCustom" Style="{StaticResource ProfileButtonStyle}" Click="btnCustom_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" Text="Custom" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </ui:Card>

                    <!-- Status Card: the live CPU/GPU contract, and — on its own row, under the
                         same full-width rule the other cards use between sections — the
                         unlock's numbers while it is applied. -->
                    <ui:Card Margin="12,8,0,16"
                             Padding="15"
                             HorizontalAlignment="Center">
                        <StackPanel>
                            <Grid HorizontalAlignment="Center" Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center" Margin="24,0,0,0">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="CPU" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="tbPl1Label" Grid.Row="0" Grid.Column="0" Width="120" FontSize="13" Text="Sustained (SPL)" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="tbPl1" FontSize="13" FontWeight="SemiBold" Text="-- W" />

                                        <TextBlock x:Name="tbPl2Label" Grid.Row="1" Grid.Column="0" FontSize="13" Text="Boost (FPL)" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="tbPl2" FontSize="13" FontWeight="SemiBold" Text="-- W" Margin="0,4,0,0" />

                                        <TextBlock x:Name="tbTjMaxLabel" Grid.Row="2" Grid.Column="0" Width="120" FontSize="13" Text="TjMax" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="tbTjMax" FontSize="13" FontWeight="SemiBold" Text="-- °C" Margin="0,4,0,0" />

                                        <TextBlock x:Name="tbCoLabel" Grid.Row="3" Grid.Column="0" Width="120" FontSize="13" Text="CO Offset" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="tbCoOffset" FontSize="13" FontWeight="SemiBold" Text="-- | --" Margin="0,4,0,0" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Margin="0,0,24,0">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="GPU" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Width="120" FontSize="13" Text="GPU TGP" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="tbGpuTgp" FontSize="13" FontWeight="SemiBold" Text="-- W" />

                                        <TextBlock x:Name="tbDbLabel" Grid.Row="1" Grid.Column="0" FontSize="13" Text="Dynamic Boost" Margin="0,4,0,0" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="tbGpuDb" Grid.Row="1" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Text="Off" Margin="0,4,0,0" />

                                        <TextBlock x:Name="tbCoreLabel" Grid.Row="2" Grid.Column="0" FontSize="13" Text="Core Offset" Margin="0,4,0,0" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="tbCoreClock" Grid.Row="2" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Text="--" Margin="0,4,0,0" />

                                        <TextBlock x:Name="tbMemLabel" Grid.Row="3" Grid.Column="0" FontSize="13" Text="Memory Offset" Margin="0,4,0,0" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="tbMemClock" Grid.Row="3" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Text="--" Margin="0,4,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- The unlock's numbers, read back from the driver. It exists only
                                 while the unlock is applied; with it off the card already says
                                 what the GPU is running on. Every coloured number carries its
                                 own word, so nothing here is colour alone. -->
                            <StackPanel x:Name="spRomStatusRow" Visibility="Collapsed">
                                <Border Height="1"
                                        Margin="0,12,0,10"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="24,0,24,0" VerticalAlignment="Center">
                                    <ui:TextBlock FontTypography="BodyStrong"
                                                  VerticalAlignment="Center"
                                                  Text="Extra GPU power" />

                                    <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Ceiling" />
                                            <TextBlock x:Name="tbRomStatCeiling" Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Text="-- W" />
                                            <TextBlock x:Name="tbRomStatCeilingWord" Margin="0,1,0,0" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Request" />
                                            <TextBlock x:Name="tbRomStatRequest" Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Text="-- W" />
                                            <TextBlock x:Name="tbRomStatRequestWord" Margin="0,1,0,0" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Budget" />
                                            <TextBlock x:Name="tbRomStatBudget" Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Text="-- W" />
                                            <TextBlock x:Name="tbRomStatBudgetWord" Margin="0,1,0,0" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="NVVDD" />
                                            <TextBlock x:Name="tbRomStatNvvdd" Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Text="-- A" />
                                            <TextBlock x:Name="tbRomStatNvvddWord" Margin="0,1,0,0" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="MSVDD" />
                                            <TextBlock x:Name="tbRomStatMsvdd" Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Text="-- A" />
                                            <TextBlock x:Name="tbRomStatMsvddWord" Margin="0,1,0,0" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Board input" />
                                            <TextBlock x:Name="tbRomStatBoard" Margin="0,2,0,0" FontSize="13" FontWeight="SemiBold" Text="-- A" />
                                            <TextBlock x:Name="tbRomStatBoardWord" Margin="0,1,0,0" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- GPU power ceiling override. Sits above the tuning editors so it is
                         reachable from every preset: it is a machine-wide driver-level
                         setting, not a per-preset value.

                         The layout is the act first (consent, the two buttons), then the
                         measured facts as one scannable block, then the rail sliders closed
                         behind a disclosure row. The live numbers the unlock produces are on
                         the status card above, so this card never repeats them. -->
                    <ui:Card x:Name="cardRomOverride"
                             Margin="0,0,0,8"
                             Padding="15"
                             Visibility="Collapsed">
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="Extra GPU power" />
                            <ui:TextBlock Margin="0,2,0,0"
                                           FontTypography="Caption"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Text="Raises the GPU's power ceiling at driver level" />

                            <CheckBox x:Name="chkRomConsent"
                                      Margin="0,16,0,0"
                                      FontSize="12"
                                      Visibility="Collapsed"
                                      Checked="chkRomConsent_Changed"
                                      Unchecked="chkRomConsent_Changed"
                                      Content="I understand this changes driver-level settings and restarts the GPU" />

                            <!-- Both actions stay on the card: the irrelevant one is disabled
                                 and explained, never hidden and never a silent no-op. -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <ui:Button x:Name="btnRomUnlock"
                                           Padding="16,6"
                                           Appearance="Primary"
                                           Click="btnRomUnlock_Click"
                                           Content="Unlock extra GPU power" />
                                <ui:Button x:Name="btnRomRestore"
                                           Margin="8,0,0,0"
                                           Padding="16,6"
                                           Appearance="Secondary"
                                           Click="btnRomRestore_Click"
                                           Content="Restore stock" />
                            </StackPanel>

                            <!-- One line, and only for a state that needs explaining: a refusal,
                                 a partial apply, a read that failed, or why an action is
                                 dimmed. A clean unlock says itself in the status card's row. -->
                            <TextBlock x:Name="tbRomOverrideNote"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <StackPanel x:Name="spRomBusy"
                                        Margin="0,10,0,0"
                                        Visibility="Collapsed">
                                <ProgressBar Height="4" IsIndeterminate="True" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Restarting the GPU. The screen may go blank for up to 60 seconds." />
                            </StackPanel>

                            <!-- Facts the numbers cannot say: the tier we measured, the stock
                                 rails it replaces, and the run behind the example offset. -->
                            <Border Height="1"
                                    Margin="0,16,0,12"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                            <ui:TextBlock FontTypography="Caption"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Measured on our test unit" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Ceiling" />
                                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Text="250 W" />

                                <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Target" Margin="0,2,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Text="225 W" Margin="0,2,0,0" />

                                <TextBlock Grid.Row="2" Grid.Column="0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Rails" Margin="0,2,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" TextWrapping="Wrap" Text="250 A · 70 A · 14.026 A" Margin="0,2,0,0" />

                                <TextBlock Grid.Row="3" Grid.Column="0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Stock rails" Margin="0,2,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12" TextWrapping="Wrap" Text="210 A · 60 A · 11.053 A" Margin="0,2,0,0" />

                                <TextBlock Grid.Row="4" Grid.Column="0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Driver max" Margin="0,2,0,0" />
                                <TextBlock Grid.Row="4" Grid.Column="1" FontSize="12" TextWrapping="Wrap" Text="294 A · 84 A · 17.021 A" Margin="0,2,0,0" />
                            </Grid>
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="The EC publishes a 95 W base TGP, so the cTGP offset is 130 and Dynamic Boost is off." />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="With a +233 MHz core offset we measured 214 W board power at 0.975-0.985 V, PerfCap VRel — power was no longer the binding limit. The offset is per card and yours to set on this page, so another unit may take more or crash well below it, and we have not measured a wattage without one. Hotspot 58-63 °C at 215 W with the liquid cooler connected, 81.7 °C without it." />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="Overrides the driver's power policy only: the GPU's firmware is unchanged, and Restore stock undoes it." />

                            <!-- Advanced: the runtime rail currents. A separate, live NVAPI
                                 write (no restart, no blank screen, no consent), so it stays
                                 closed until asked for and follows the unlock's state. -->
                            <Border Height="1"
                                    Margin="0,16,0,4"
                                    Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                            <ui:Button x:Name="btnRomAdvanced"
                                       Padding="0,6"
                                       HorizontalAlignment="Left"
                                       Appearance="Transparent"
                                       Click="btnRomAdvanced_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon x:Name="icRomAdvanced"
                                                 FontFamily="Segoe Fluent Icons"
                                                 Glyph="&#xE70D;"
                                                 FontSize="12"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center" />
                                    <TextBlock x:Name="tbRomAdvanced"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Text="Show advanced" />
                                </StackPanel>
                            </ui:Button>

                            <StackPanel x:Name="spRomAdvanced"
                                        Margin="0,8,0,0"
                                        Visibility="Collapsed">
                                <ui:TextBlock FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap"
                                               Text="These values are machine-wide and are not saved with a preset." />

                                <StackPanel x:Name="spRailControls" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body" Text="NVVDD (GPU core)" />
                                            <ui:TextBlock x:Name="tbRailNvvdd"
                                                           Margin="0,2,0,0"
                                                           FontTypography="Caption"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Text="-- A" />
                                        </StackPanel>
                                        <Slider x:Name="sdRailNvvdd"
                                                Grid.Column="1"
                                                Width="140"
                                                VerticalAlignment="Center"
                                                ValueChanged="RailSlider_ValueChanged" />
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body" Text="MSVDD (memory)" />
                                            <ui:TextBlock x:Name="tbRailMsvdd"
                                                           Margin="0,2,0,0"
                                                           FontTypography="Caption"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Text="-- A" />
                                        </StackPanel>
                                        <Slider x:Name="sdRailMsvdd"
                                                Grid.Column="1"
                                                Width="140"
                                                VerticalAlignment="Center"
                                                ValueChanged="RailSlider_ValueChanged" />
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <ui:TextBlock FontTypography="Body" Text="Board input" />
                                            <ui:TextBlock x:Name="tbRailBoardInput"
                                                           Margin="0,2,0,0"
                                                           FontTypography="Caption"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Text="-- A" />
                                        </StackPanel>
                                        <Slider x:Name="sdRailBoardInput"
                                                Grid.Column="1"
                                                Width="140"
                                                VerticalAlignment="Center"
                                                ValueChanged="RailSlider_ValueChanged" />
                                    </Grid>

                                    <!-- Warn, never clamp: this is the setting that can outdraw the
                                         adapter once the CPU is loaded too. -->
                                    <TextBlock x:Name="tbRailCaution"
                                               Margin="0,6,0,0"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Text="Above 14.0 A the GPU can outdraw what the laptop's power adapter supplies once the CPU is also loaded — we have seen this machine fail with an out-of-memory error. Nothing is clamped here." />

                                    <ui:Button x:Name="btnRailApply"
                                               Margin="0,12,0,0"
                                               Padding="16,6"
                                               HorizontalAlignment="Left"
                                               Appearance="Primary"
                                               Click="btnRailApply_Click"
                                               Content="Apply limits" />
                                </StackPanel>

                                <!-- Outside the disabled group: a reason a dimmed control
                                     cannot state for itself. -->
                                <TextBlock x:Name="tbRailNote"
                                           Margin="0,6,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock x:Name="tbRailReason"
                                           Margin="0,2,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- ===== CUSTOM PANEL (hidden by default) ===== -->
                    <StackPanel x:Name="customScroll" Visibility="Collapsed">

                        <!-- CPU Power Tuning (SMU) -->
                        <ui:CardExpander x:Name="sdCpuPower"
                                        Margin="0,0,0,8"
                                        IsEnabled="True"
                                        IsExpanded="False">
                            <ui:CardExpander.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE950;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardExpander.Icon>
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="AMD CPU Power Tuning" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Direct SMU power limits via PCI config space" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <!-- Sustained Power Limit (SPL) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
