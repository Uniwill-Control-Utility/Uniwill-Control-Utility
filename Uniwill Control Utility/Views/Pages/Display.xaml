<Page x:Class="Uniwill_Control_Utility.Views.Pages.Display"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="650" d:DesignWidth="900"
      Title="Display"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <!-- Inactive GPU mode card button -->
        <Style x:Key="GpuModeButtonStyle"
		       TargetType="{x:Type Button}"
		       BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="200"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Active (selected) GPU mode card button with hover/press states -->
        <Style x:Key="GpuModeButtonActiveStyle"
		       TargetType="{x:Type Button}">
            <Setter Property="Height" Value="200"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundBorder"
											                               Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
												                        Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackgroundBorder"
											                               Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
												                        Value="{DynamicResource AccentFillColorTertiaryBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ContentPresenter"
											                 Storyboard.TargetProperty="Opacity"
											                 To="0.5" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="BackgroundBorder"
							        Background="{TemplateBinding Background}"
							        CornerRadius="4">
                                <ContentPresenter x:Name="ContentPresenter"
								                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
								                  Content="{TemplateBinding Content}"
								                  ContentTemplate="{TemplateBinding ContentTemplate}"
								                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
								                  RecognizesAccessKey="True"
								                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Scrollable content -->
        <ScrollViewer Grid.Row="0"
		              VerticalScrollBarVisibility="Auto"
		              HorizontalScrollBarVisibility="Disabled"
		              CanContentScroll="False"
		              PanningMode="VerticalOnly"
		              IsDeferredScrollingEnabled="False">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ScrollViewer.Style>

            <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Page title block -->
                <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,16,0,0">
                    <TextBlock FontSize="26"
					           FontWeight="Medium"
					           Margin="12,0,16,0"
					           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
					           Text="Display"/>
                    <TextBlock Margin="12,8,16,12"
					           FontSize="12"
					           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
					           Text="Manage GPU modes and other display-related features."
					           TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Content cards -->
                <StackPanel Grid.Row="1" Margin="12,16,16,18">

                    <!-- Unavailable state -->
                    <ui:CardControl x:Name="DisplayUnavailable" Visibility="Collapsed" Margin="0,0,0,8">
                        <ui:CardControl.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A7;" FontSize="20" Margin="4,0,6,0"/>
                        </ui:CardControl.Icon>
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Display control unavailable"/>
                                <ui:TextBlock Margin="0,2,0,0"
								              FontTypography="Caption"
								              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
								              Text="GPU MUX control is not available on this device"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                    </ui:CardControl>

                    <!-- Available content -->
                    <StackPanel x:Name="DisplayAvailable">

                        <!-- GPU Display Mode — header + buttons in one Card -->
                        <ui:Card Margin="0,0,0,8"
						         Padding="0"
						         SnapsToDevicePixels="True">
                            <StackPanel>
                                <!-- Header row: icon, title, caption -->
                                <Grid Margin="24,16,16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Grid.Column="0"
									             FontFamily="Segoe Fluent Icons"
									             Glyph="&#xF211;"
									             FontSize="20"
									             Margin="-6,0,18,0"
									             VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <ui:TextBlock FontTypography="Body" Text="GPU Display Mode"/>
                                        <ui:TextBlock Margin="0,2,0,0"
										              FontTypography="Caption"
										              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
										              Text="Select how the display connects to the GPU"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Margin="0,12,0,0" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                                <!-- GPU Mode Selector -->
                                    <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- iGPU Only -->
                                <Button Grid.Column="0"
								        x:Name="btnIgpuOnly"
								        Style="{StaticResource GpuModeButtonStyle}"
								        Click="btnGpuMode_Click"
								        Tag="2"
								        HorizontalContentAlignment="Stretch"
								        VerticalContentAlignment="Stretch"
								        Padding="0"
                                        Margin="8,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- TOP SECTION: Graphic Vector -->
                                        <Viewbox Grid.Row="0" Width="240" Height="140" Stretch="Uniform" Margin="0,0,0,10">
                                            <Canvas Width="200" Height="115">
                                                <!-- TOP: Laptop Display -->
                                                <Border Canvas.Left="70" Canvas.Top="15" Width="60" Height="38" CornerRadius="4"
												        BorderThickness="2" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <Border Canvas.Left="63" Canvas.Top="54" Width="74" Height="5" CornerRadius="0,0,2,2"
												        BorderThickness="2" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>

                                                <!-- BOTTOM ROW: iGPU Component (Active) -->
                                                <Border Canvas.Left="25" Canvas.Top="85" Width="40" Height="24" CornerRadius="3"
												        BorderThickness="1.5" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9.5" FontWeight="SemiBold"
													           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="iGPU"/>
                                                </Border>

                                                <!-- BOTTOM ROW: MUX Switch Component (Active) -->
                                                <Border Canvas.Left="80" Canvas.Top="85" Width="40" Height="24" CornerRadius="3"
												        BorderThickness="1.5" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9.5" FontWeight="Bold"
													           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="MUX"/>
                                                </Border>

                                                <!-- BOTTOM ROW: dGPU Component (Inactive / Dimmed) -->
                                                <Border Canvas.Left="135" Canvas.Top="85" Width="40" Height="24" CornerRadius="3" Opacity="0.3"
												        BorderThickness="1.5" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9.5"
													           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="dGPU"/>
                                                </Border>

                                                <!-- PATHWAYS: Straight Horizontal Arrow (iGPU -> MUX) -->
                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
												      Data="M 65,97 L 75,97"/>
                                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M 80,97 L 75,94 L 75,100 Z"/>

                                                <!-- PATHWAYS: Output Arrow (MUX -> Laptop Base) -->
                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
												      Data="M 100,85 L 100,64"/>
                                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M 100,60 L 96,66 L 104,66 Z"/>
                                            </Canvas>
                                        </Viewbox>

                                        <!-- BOTTOM SECTION: Full Span Background Text Area -->
                                        <Border x:Name="borderIgpuLabel"
										        Grid.Row="1"
										        Background="{DynamicResource SmokeFillColorDefaultBrush}"
										        Padding="0,10,0,10"
										        BorderThickness="0,1,0,0"
										        Opacity="0.85">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
											           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
											           Text="iGPU Only"/>
                                        </Border>
                                    </Grid>
                                </Button>

                                <!-- Hybrid -->
                                <Button Grid.Column="1"
								        x:Name="btnHybrid"
								        Style="{StaticResource GpuModeButtonStyle}"
								        Click="btnGpuMode_Click"
								        Tag="0"
								        HorizontalContentAlignment="Stretch"
								        VerticalContentAlignment="Stretch"
								        Padding="0"
                                        Margin="0,12,8,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- TOP SECTION: Graphic Vector -->
                                        <Viewbox Grid.Row="0" Width="240" Height="140" Stretch="Uniform" Margin="0,0,0,10">
                                            <Canvas Width="200" Height="115">
                                                <!-- TOP: Laptop Display -->
                                                <Border Canvas.Left="70" Canvas.Top="15" Width="60" Height="38" CornerRadius="4"
												        BorderThickness="2" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <Border Canvas.Left="63" Canvas.Top="54" Width="74" Height="5" CornerRadius="0,0,2,2"
												        BorderThickness="2" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>

                                                <!-- BOTTOM ROW: iGPU Component (Active) -->
                                                <Border Canvas.Left="25" Canvas.Top="85" Width="40" Height="24" CornerRadius="3"
												        BorderThickness="1.5" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9.5" FontWeight="SemiBold"
													           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="iGPU"/>
                                                </Border>

                                                <!-- BOTTOM ROW: MUX Switch Component (Active) -->
                                                <Border Canvas.Left="80" Canvas.Top="85" Width="40" Height="24" CornerRadius="3"
												        BorderThickness="1.5" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9.5" FontWeight="Bold"
													           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="MUX"/>
                                                </Border>

                                                <!-- BOTTOM ROW: dGPU Component (Active) -->
                                                <Border Canvas.Left="135" Canvas.Top="85" Width="40" Height="24" CornerRadius="3"
												        BorderThickness="1.5" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9.5" FontWeight="SemiBold"
													           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="dGPU"/>
                                                </Border>

                                                <!-- PATHWAYS: Straight Horizontal Arrow (iGPU -> MUX) -->
                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
												      Data="M 65,97 L 75,97"/>
                                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M 80,97 L 75,94 L 75,100 Z"/>

                                                <!-- PATHWAYS: Straight Horizontal Arrow (dGPU -> MUX) -->
                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
												      Data="M 135,97 L 125,97"/>
                                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M 120,97 L 125,94 L 125,100 Z"/>

                                                <!-- PATHWAYS: Output Arrow (MUX -> Laptop Base) -->
                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
												      Data="M 100,85 L 100,64"/>
                                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M 100,60 L 96,66 L 104,66 Z"/>
                                            </Canvas>
                                        </Viewbox>

                                        <!-- BOTTOM SECTION: Full Span Background Text Area -->
                                        <Border x:Name="borderHybridLabel"
										        Grid.Row="1"
										        Background="{DynamicResource SmokeFillColorDefaultBrush}"
										        Padding="0,10,0,10"
										        BorderThickness="0,1,0,0"
										        Opacity="0.85">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
											           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
											           Text="Hybrid (NVIDIA Optimus)"/>
                                        </Border>
                                    </Grid>
                                </Button>


                                <!-- dGPU Only -->
                                <Button Grid.Column="2"
								        x:Name="btnDgpuOnly"
								        Style="{StaticResource GpuModeButtonStyle}"
								        Click="btnGpuMode_Click"
								        Tag="1"
								        HorizontalContentAlignment="Stretch"
								        VerticalContentAlignment="Stretch"
								        Padding="0"
                                        Margin="0,12,8,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- TOP SECTION: Graphic Vector -->
                                        <Viewbox Grid.Row="0" Width="240" Height="140" Stretch="Uniform" Margin="0,0,0,10">
                                            <Canvas Width="200" Height="115">
                                                <!-- TOP: Laptop Display -->
                                                <Border Canvas.Left="70" Canvas.Top="15" Width="60" Height="38" CornerRadius="4"
												        BorderThickness="2" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <Border Canvas.Left="63" Canvas.Top="54" Width="74" Height="5" CornerRadius="0,0,2,2"
												        BorderThickness="2" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>

                                                <!-- BOTTOM ROW: iGPU Component (Inactive / Dimmed) -->
                                                <Border Canvas.Left="25" Canvas.Top="85" Width="40" Height="24" CornerRadius="3" Opacity="0.3"
												        BorderThickness="1.5" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9.5"
													           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="iGPU"/>
                                                </Border>

                                                <!-- BOTTOM ROW: MUX Switch Component (Active) -->
                                                <Border Canvas.Left="80" Canvas.Top="85" Width="40" Height="24" CornerRadius="3"
												        BorderThickness="1.5" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9.5" FontWeight="Bold"
													           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="MUX"/>
                                                </Border>

                                                <!-- BOTTOM ROW: dGPU Component (Active) -->
                                                <Border Canvas.Left="135" Canvas.Top="85" Width="40" Height="24" CornerRadius="3"
												        BorderThickness="2" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9.5" FontWeight="Bold"
													           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="dGPU"/>
                                                </Border>

                                                <!-- PATHWAYS: Straight Horizontal Arrow (dGPU -> MUX) -->
                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
												      Data="M 135,97 L 125,97"/>
                                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M 120,97 L 125,94 L 125,100 Z"/>

                                                <!-- PATHWAYS: Output Arrow (MUX -> Laptop Base) -->
                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
												      Data="M 100,85 L 100,64"/>
                                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M 100,60 L 96,66 L 104,66 Z"/>
                                            </Canvas>
                                        </Viewbox>

                                        <!-- BOTTOM SECTION: Full Span Background Text Area -->
                                        <Border x:Name="borderDgpuLabel"
										        Grid.Row="1"
										        Background="{DynamicResource SmokeFillColorDefaultBrush}"
										        Padding="0,10,0,10"
										        BorderThickness="0,1,0,0"
										        Opacity="0.85">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
											           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
											           Text="dGPU Only"/>
                                        </Border>
                                    </Grid>
                                </Button>


                                    </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- iGPU Power Saving Mode — only visible in Hybrid mode -->
                        <ui:Card x:Name="CardGpuPowerSaving" Margin="0,0,0,8" Visibility="Collapsed" Padding="0" SnapsToDevicePixels="True">
                            <StackPanel>
                                <!-- Header row -->
                                <Grid Margin="24,16,16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:FontIcon Grid.Column="0"
									             FontFamily="Segoe Fluent Icons"
									             Glyph="&#xEBC0;"
									             FontSize="20"
									             Margin="-6,0,18,0"
									             VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <ui:TextBlock FontTypography="Body" Text="iGPU Power Saving Mode"/>
                                        <ui:TextBlock Margin="0,2,0,0"
										              FontTypography="Caption"
										              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
										              Text="Control GPU preference without rebooting. Only available in Hybrid mode."/>
                                    </StackPanel>
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Margin="0,12,0,0" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                                <!-- Power Saving Mode Selector — 3 buttons with the cooldown
                                     Border inside the same Grid, spanning all three columns
                                     (ZIndex paints it on top of the buttons). -->
                                <Grid Margin="8,12,8,8">
                                    <!-- Button row + cooldown overlay -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- On (Power Saving) -->
                                        <Button Grid.Column="0"
								                x:Name="btnPowerSavingOn"
								                Style="{StaticResource GpuModeButtonStyle}"
								                Click="btnPowerSaving_Click"
								                Tag="0"
								                HorizontalContentAlignment="Stretch"
								                VerticalContentAlignment="Stretch"
								                Padding="12,8"
								                Height="80">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEC0A;" FontSize="24" Margin="0,0,0,6"/>
                                                <TextBlock Text="On"
												           FontSize="13"
												           FontWeight="SemiBold"
												           HorizontalAlignment="Center"
												           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <TextBlock Text="Prefer iGPU"
												           FontSize="11"
												           HorizontalAlignment="Center"
												           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
												           Opacity="0.7"
												           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Auto -->
                                        <Button Grid.Column="1"
                                            x:Name="btnPowerSavingAuto"
                                            Style="{StaticResource GpuModeButtonStyle}"
                                            Click="btnPowerSaving_Click"
                                            Tag="2"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Padding="12,8"
                                            Height="80">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8AB;" FontSize="24" Margin="0,0,0,6"/>
                                                <TextBlock Text="Auto"
									           FontSize="13"
									           FontWeight="SemiBold"
									           HorizontalAlignment="Center"
									           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <TextBlock Text="Driver decides"
									           FontSize="11"
									           HorizontalAlignment="Center"
									           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
									           Opacity="0.7"
									           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Off (Performance) -->
                                        <Button Grid.Column="2"
								                x:Name="btnPowerSavingOff"
								                Style="{StaticResource GpuModeButtonStyle}"
								                Click="btnPowerSaving_Click"
								                Tag="1"
								                HorizontalContentAlignment="Stretch"
								                VerticalContentAlignment="Stretch"
								                Padding="12,8"
								                Height="80">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEC4A;" FontSize="24" Margin="0,0,0,6"/>
                                                <TextBlock Text="Off"
												           FontSize="13"
												           FontWeight="SemiBold"
												           HorizontalAlignment="Center"
												           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <TextBlock Text="Prefer dGPU"
												           FontSize="11"
												           HorizontalAlignment="Center"
												           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
												           Opacity="0.7"
												           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Cooldown overlay — spans all three columns of the
                                             button Grid so it covers the buttons (ZIndex on top) -->
                                        <Border x:Name="borderPowerSavingCooldown"
                                                Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                                Visibility="Collapsed"
                                                Background="{DynamicResource SmokeFillColorDefaultBrush}"
                                                CornerRadius="4"
                                                Panel.ZIndex="1">
                                            <TextBlock x:Name="txtCooldownCountdown"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Reboot warning -->
                        <ui:CardControl Margin="0,0,0,8"
						                Visibility="Collapsed"
						                x:Name="cardRebootWarning"
						                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                            <ui:CardControl.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7BA;" FontSize="20" Margin="4,0,6,0"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="Reboot required"/>
                                    <ui:TextBlock Margin="0,2,0,0"
									              FontTypography="Caption"
									              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
									              Text="The MUX switch change will take effect after a system restart"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button x:Name="btnRestartNow"
							           Content="Restart now"
							           Appearance="Caution"
							           Click="btnRestartNow_Click"/>
                        </ui:CardControl>

                        <!-- MiniLED Local Dimming (hidden for non-MiniLED panels) -->
                        <ui:CardControl x:Name="CardLocalDimming" Margin="0,0,0,8" Visibility="Collapsed">
                            <ui:CardControl.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE706;" FontSize="20" Margin="4,0,6,0"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="MiniLED local dimming"/>
                                    <ui:TextBlock Margin="0,2,0,0"
									              FontTypography="Caption"
									              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
									              Text="Enable or disable MiniLED local dimming on the display"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="tsLocalDimming"
                                             LabelPosition="Left"
                                             OnContent="On"
                                             OffContent="Off"
                                             Checked="TsLocalDimming_Toggled"
                                             Unchecked="TsLocalDimming_Toggled"/>
                        </ui:CardControl>

                        <!-- Display Refresh Rate (hidden when the laptop panel offers a single rate) -->
                        <ui:CardControl x:Name="CardRefreshRate" Margin="0,0,0,8" Visibility="Collapsed">
                            <ui:CardControl.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="18" Margin="5,0,7,0"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="Display Refresh Rate"/>
                                    <ui:TextBlock Margin="0,2,0,0"
                                                  FontTypography="Caption"
                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                  Text="Switch the refresh rate of the laptop panel via the Windows display-mode pathway"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="cbRefreshRate"
                                      Width="180"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      SelectionChanged="cbRefreshRate_SelectionChanged"/>
                        </ui:CardControl>

                        <!-- Display Color Calibration (hidden when only Default is available) -->
                        <ui:CardControl x:Name="CardColorCalibration" Margin="0,0,0,8" Visibility="Collapsed">
                            <ui:CardControl.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE790;" FontSize="20" Margin="4,0,6,0"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="Color Calibration"/>
                                    <ui:TextBlock Margin="0,2,0,0"
                                                  FontTypography="Caption"
                                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                  Text="Associate a Windows ICC color profile with the display in use via the ICM profile-association registry"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="cbColorCalibration"
                                      Width="180"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      SelectionChanged="cbColorCalibration_SelectionChanged"/>
                        </ui:CardControl>

                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Row 1: Bottom bar — live panel-model status -->
        <ui:Card x:Name="bottomBar" Grid.Row="1" MaxWidth="1052" HorizontalAlignment="Stretch" Margin="12,8,16,12" Padding="12,8" SnapsToDevicePixels="True">
            <!-- Monitor info for the laptop panel, left side -->
            <TextBlock
                       x:Name="tbRefreshRateTarget"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="--"/>
        </ui:Card>
    </Grid>
</Page>
