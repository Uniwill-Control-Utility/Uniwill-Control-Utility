<Page x:Class="Uniwill_Control_Utility.Views.Pages.Watercooler"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Uniwill_Control_Utility.Views.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance local:Watercooler, IsDesignTimeCreatable=False}"
      d:Background="{DynamicResource ApplicationBackgroundBrush}"
      d:DesignHeight="650" d:DesignWidth="900"
      Title="Watercooler Control"
      Unloaded="Page_Unloaded"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True"
      ScrollViewer.CanContentScroll="False">

    <!-- Root Grid with single row: full-height ScrollViewer for centered max-width layout.
         The scrollbar is glued to the absolute right edge and spans the entire window vertically. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Full-height ScrollViewer -->
        <ScrollViewer x:Name="PageScrollViewer"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      IsDeferredScrollingEnabled="False">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Padding" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, RelativeSource={RelativeSource Self}}"
                                     Value="Visible">
                            <Setter Property="Padding" Value="0,0,8,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <!-- Centered max-width layout container. Header and content share the same axis. -->
            <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Page title block (16px side margin, 16px top for non-Home page) -->
                <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,16,0,0">
                    <TextBlock x:Name="tbPageTitle"
                               FontSize="26"
                               FontWeight="Medium"
                               Margin="12,0,16,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="Hydro UI" />
                    <TextBlock Margin="12,8,16,12"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Control your LCT watercooler's pump speed, fan RPM, RGB lighting, and device settings."
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Row 1: Content cards (16px side margin, 16px top) -->
                <StackPanel Grid.Row="1" Margin="12,16,16,18">

                <!-- Device Status -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column 1: Device image with glow -->
                        <StackPanel Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="16">
                            <Grid Margin="0,24,0,36">
                                <!-- Colored glow layer behind -->
                                <Rectangle x:Name="rectGlowOverlay"
                                               Width="165"
                                               Height="140"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Fill="#007ACC"
                                               Opacity="0"
                                               RenderOptions.EdgeMode="Unspecified"
                                               Margin="0,12,0,12">
                                    <Rectangle.Effect>
                                        <BlurEffect Radius="60"/>
                                    </Rectangle.Effect>
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://application:,,,/Assets/HydroUI/mk2.png"
                                                        Stretch="Fill" />
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <!-- Sharp original image on top -->
                                <Image x:Name="imgDevice"
                                           Width="320"
                                           Height="140"
                                           Stretch="Uniform"
                                           Source="pack://application:,,,/Assets/HydroUI/mk2.png"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            <!-- Temperature metrics -->
                            <Grid Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="CPU Temp" FontWeight="SemiBold" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock x:Name="tbCpuTemp" Text="--" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                                <Rectangle Grid.Column="1" Height="30" Width="1" Fill="{DynamicResource ControlFillColorSecondaryBrush}" Margin="12,4"/>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="GPU Temp" FontWeight="SemiBold" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock x:Name="tbGpuTemp" Text="--" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Column 2: Status + action -->
                        <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                            <!-- Connected state -->
                            <StackPanel x:Name="spConnectedState" Visibility="Collapsed">
                                <ui:FontIcon FontFamily="Segoe Fluent Icons"
                                                 Glyph="&#xE73E;"
                                                 FontSize="24"
                                                 Foreground="Green"
                                                 HorizontalAlignment="Center"
                                                 Margin="0,0,0,8"/>
                                <TextBlock Text="Connected"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,16"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Button x:Name="btnDisconnect"
                                            Content="Disconnect"
                                            Width="140"
                                            Click="btnDisconnect_Click"/>
                            </StackPanel>

                            <!-- Disconnected state -->
                            <StackPanel x:Name="spDisconnectedState">
                                <ui:FontIcon FontFamily="Segoe Fluent Icons"
                                                 Glyph="&#xE711;"
                                                 FontSize="24"
                                                 Foreground="Red"
                                                 HorizontalAlignment="Center"
                                                 Margin="0,0,0,8"/>
                                <TextBlock Text="Disconnected"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,16"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                <!-- Device discovery row -->
                                <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="cbxDevices" Grid.Column="0" Margin="0,0,8,0" MinWidth="200" SelectionChanged="cbxDevices_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text=" (" Margin="6,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Hidden"/>
                                                    <TextBlock Text="{Binding Address}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Hidden"/>
                                                    <TextBlock Text=")" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Hidden"/>
                                                    <TextBlock Text="  RSSI: " Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="Hidden"/>
                                                    <TextBlock Text="{Binding Rssi}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="Hidden"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button x:Name="btnScan" Grid.Column="1" Content="Scan" Width="80" Click="btnScan_Click"/>
                                </Grid>

                                <Button x:Name="btnConnect"
                                            Content="Connect"
                                            Width="140"
                                            Click="btnConnect_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Controls (hidden until connected) -->
                <StackPanel x:Name="spControls" Visibility="Collapsed">

                        <!-- Smart Mode -->
                        <ui:CardExpander x:Name="SmartModeCardExpander"
                            Margin="0,0,0,8"
                            IsExpanded="False">        
                            <ui:CardExpander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconLucide Grid.Column="0"
                                       Kind="BrainCircuit"
                                       Width="20"
                                      Height="20"
                                       Margin="4,0,20,0"
                                       VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <ui:TextBlock FontTypography="Body" Text="Smart Mode" />
                                        <ui:TextBlock Margin="0,2,0,0"
                               FontTypography="Caption"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Automatically adjust pump and fan based on temperature." />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="tsSmartMode"
                              Grid.Column="2"
                              Margin="24,0,14,0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              LabelPosition="Left"
                              OnContent="On"
                              OffContent="Off"
                              Checked="tsSmartMode_Checked"
                              Unchecked="tsSmartMode_Unchecked" />
                                </Grid>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <!-- Temperature source -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Temperature Source" />
                                        <ui:TextBlock Margin="0,2,0,0"
                               FontTypography="Caption"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Which temperature to monitor for control." />
                                    </StackPanel>
                                    <ComboBox x:Name="cbxSmartModeTempSource"
                      Grid.Column="1"
                      MinWidth="160"
                      Margin="4,0,0,0"
                      SelectionChanged="cbxSmartModeTempSource_SelectionChanged">
                                        <ComboBoxItem Content="Highest (CPU/GPU)"/>
                                        <ComboBoxItem Content="CPU"/>
                                        <ComboBoxItem Content="GPU"/>
                                    </ComboBox>
                                </Grid>
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Thresholds -->
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Thresholds" />
                                        <ui:TextBlock Margin="0,2,0,0"
                               FontTypography="Caption"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Low = idle speed, High = boost speed. The gap prevents oscillation." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="4,0,0,0">
                                        <TextBox x:Name="tbSmartModeLow"
                         Width="50"
                         Margin="0,0,4,0"
                         HorizontalAlignment="Right"
                         Text="50"
                         PreviewTextInput="TextBox_NumericOnly"
                         LostFocus="tbSmartModeThresholds_LostFocus" />
                                        <TextBlock VerticalAlignment="Center"
                           Margin="4,0,4,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="°C → " />
                                        <TextBox x:Name="tbSmartModeHigh"
                         Width="50"
                         Margin="0,0,4,0"
                         HorizontalAlignment="Right"
                         Text="70"
                         PreviewTextInput="TextBox_NumericOnly"
                         LostFocus="tbSmartModeThresholds_LostFocus" />
                                        <TextBlock VerticalAlignment="Center"
                           Margin="4,0,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="°C" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Pump speed selection -->
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Pump Speeds" />
                                        <ui:TextBlock Margin="0,2,0,0"
                               FontTypography="Caption"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Idle (low temp) and Boost (high temp) pump voltages." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="4,0,0,0">
                                        <ComboBox x:Name="cbxSmartModeIdlePump"
                          Width="80"
                          Margin="0,0,8,0"
                          SelectionChanged="cbxSmartModeSpeed_SelectionChanged">
                                            <ComboBoxItem Content="Off"/>
                                            <ComboBoxItem Content="7 V"/>
                                            <ComboBoxItem Content="8 V"/>
                                            <ComboBoxItem Content="11 V"/>
                                        </ComboBox>
                                        <TextBlock VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="→" />
                                        <ComboBox x:Name="cbxSmartModeBoostPump"
                          Width="80"
                          SelectionChanged="cbxSmartModeSpeed_SelectionChanged">
                                            <ComboBoxItem Content="Off"/>
                                            <ComboBoxItem Content="7 V"/>
                                            <ComboBoxItem Content="8 V"/>
                                            <ComboBoxItem Content="11 V"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                                <!-- Fan speed selection -->
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Fan Speeds" />
                                        <ui:TextBlock Margin="0,2,0,0"
                               FontTypography="Caption"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Idle (low temp) and Boost (high temp) fan duty cycles." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="4,0,0,0">
                                        <ComboBox x:Name="cbxSmartModeIdleFan"
                          Width="80"
                          Margin="0,0,8,0"
                          SelectionChanged="cbxSmartModeSpeed_SelectionChanged">
                                            <ComboBoxItem Content="Off"/>
                                            <ComboBoxItem Content="25%"/>
                                            <ComboBoxItem Content="50%"/>
                                            <ComboBoxItem Content="75%"/>
                                            <ComboBoxItem Content="90%"/>
                                            <ComboBoxItem Content="95%"/>
                                            <ComboBoxItem Content="100%"/>
                                        </ComboBox>
                                        <TextBlock VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="→" />
                                        <ComboBox x:Name="cbxSmartModeBoostFan"
                          Width="80"
                          SelectionChanged="cbxSmartModeSpeed_SelectionChanged">
                                            <ComboBoxItem Content="Off"/>
                                            <ComboBoxItem Content="25%"/>
                                            <ComboBoxItem Content="50%"/>
                                            <ComboBoxItem Content="75%"/>
                                            <ComboBoxItem Content="90%"/>
                                            <ComboBoxItem Content="95%"/>
                                            <ComboBoxItem Content="100%"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ui:CardExpander>

                        <!-- Pump Control -->
                        <ui:CardControl x:Name="PumpVoltageCard" Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE945;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="Pump Voltage" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Select pump voltage level. Higher voltage = more cooling." />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="cbxPumpVoltage" MinWidth="160" SelectionChanged="cbxPumpVoltage_SelectionChanged">
                                <ComboBoxItem Content="Off"/>
                                <ComboBoxItem Content="7 V"/>
                                <ComboBoxItem Content="8 V"/>
                                <ComboBoxItem Content="11 V"/>
                            </ComboBox>
                        </ui:CardControl>

                        <!-- Fan Control -->
                        <ui:CardControl x:Name="FanSpeedCard" Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconLucide 
                                        Grid.Column="0"
                                        Kind="Fan"
                                        Width="20"
                                        Height="20"
                                        Margin="4,0,20,0"
                                        VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <ui:TextBlock FontTypography="Body" Text="Fan Speed" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                           FontTypography="Caption"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="Select fan duty cycle. Higher = more airflow, more noise." />
                                    </StackPanel>
                                </Grid>
                            </ui:CardControl.Header>
                        <ComboBox x:Name="cbxFanSpeed" MinWidth="160" SelectionChanged="cbxFanSpeed_SelectionChanged">
                            <ComboBoxItem Content="Off"/>
                            <ComboBoxItem Content="25%"/>
                            <ComboBoxItem Content="50%"/>
                            <ComboBoxItem Content="75%"/>
                            <ComboBoxItem Content="90%"/>
                            <ComboBoxItem Content="95%"/>
                            <ComboBoxItem Content="100%"/>
                        </ComboBox>
                    </ui:CardControl>

                    <!-- RGB Effect -->
                    <ui:CardExpander x:Name="RgbCardExpander"
                                     Margin="0,0,0,8"
                                     IsExpanded="False">
                        <ui:CardExpander.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE794;" FontSize="20" Margin="4,0,6,0" />
                        </ui:CardExpander.Icon>
                        <ui:CardExpander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="RGB Effect" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                       FontTypography="Caption"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="Configure RGB lighting effects and colors." />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="tsRgbEnabled"
                                  Grid.Column="1"
                                  Margin="24,0,14,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  LabelPosition="Left"
                                  OnContent="On"
                                  OffContent="Off"
                                  Checked="tsRgbEnabled_Checked"
                                  Unchecked="tsRgbEnabled_Unchecked" />
                            </Grid>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <!-- Effect mode -->
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Effect" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                       FontTypography="Caption"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="Choose an RGB lighting effect." />
                                </StackPanel>
                                <ComboBox x:Name="cbxRgbMode"
                                          Grid.Column="1"
                                          MinWidth="160"
                                          Margin="4,0,0,0"
                                          SelectionChanged="cbxRgbMode_SelectionChanged">
                                    <ComboBoxItem Content="Static"/>
                                    <ComboBoxItem Content="Breathe"/>
                                    <ComboBoxItem Content="Colorful"/>
                                    <ComboBoxItem Content="Breathe Color"/>
                                </ComboBox>
                            </Grid>
                            <Border x:Name="RgbDivider" Height="1" Margin="-58,12,-46,12" Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                            <!-- Color (only for Static and Breathe) -->
                            <Grid x:Name="RgbColorRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <ui:TextBlock FontTypography="Body" Text="Color" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                       FontTypography="Caption"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="Pick the color for the selected RGB mode." />
                                </StackPanel>
                                <ComboBox x:Name="cbxRgbColor"
                                          Grid.Column="1"
                                          MinWidth="160"
                                          Margin="4,0,0,0"
                                          SelectionChanged="cbxRgbColor_SelectionChanged">
                                    <ComboBoxItem Content="Red"/>
                                    <ComboBoxItem Content="Green"/>
                                    <ComboBoxItem Content="Blue"/>
                                    <ComboBoxItem Content="White"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Auto-Connect -->
                    <ui:CardControl Margin="0,0,0,8">
                        <ui:CardControl.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE777;" FontSize="20" Margin="4,0,6,0" />
                        </ui:CardControl.Icon>
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Auto-Connect on Startup" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Automatically connect to the last known device on startup." />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch x:Name="tsAutoConnect"
                                         Margin="4,0,0,0"
                                         LabelPosition="Left"
                                         OnContent="On"
                                         OffContent="Off"
                                         Checked="tsAutoConnect_Checked"
                                         Unchecked="tsAutoConnect_Unchecked" />
                    </ui:CardControl>

                </StackPanel>

            </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Dark overlay to block input when Adaptive Mode override is active -->
        <Border x:Name="overlayAdaptiveWarning"
                Visibility="Collapsed"
                Background="{DynamicResource SmokeFillColorDefaultBrush}"
                CornerRadius="4,0,0,0"
                IsHitTestVisible="True" />

        <!-- SnackbarPresenter for Adaptive Mode override warning -->
        <ui:SnackbarPresenter x:Name="SnackbarPresenter"
                              Panel.ZIndex="11"  MaxWidth="1080"/>
    </Grid>
</Page>
