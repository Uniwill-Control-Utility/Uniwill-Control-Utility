<Page x:Class="Uniwill_Control_Utility.Views.Pages.Battery"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="650" d:DesignWidth="900"
      Title="Battery"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True"
      ScrollViewer.CanContentScroll="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Scrollable content -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly"
                      IsDeferredScrollingEnabled="False">
            <ScrollViewer.Style>
                <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ScrollViewer.Style>

            <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Page title block -->
                <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,16,0,0">
                    <TextBlock FontSize="26"
                               FontWeight="Medium"
                               Margin="12,0,16,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="Battery" />
                    <TextBlock Margin="12,8,16,12"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Manage battery charging limit and view health information."
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Content cards -->
                <StackPanel Grid.Row="1" Margin="12,16,16,18">

                    <!-- Unavailable state -->
                    <ui:CardControl x:Name="BatteryUnavailable" Visibility="Collapsed" Margin="0,0,0,8">
                        <ui:CardControl.Icon>
                            <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A7;" FontSize="20" Margin="4,0,6,0" />
                        </ui:CardControl.Icon>
                        <ui:CardControl.Header>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Body" Text="Battery control unavailable" />
                                <ui:TextBlock Margin="0,2,0,0"
                                               FontTypography="Caption"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="Battery management is not available on this device" />
                            </StackPanel>
                        </ui:CardControl.Header>
                    </ui:CardControl>

                    <!-- Available content -->
                    <StackPanel x:Name="BatteryAvailable">

                        <!-- Charging Limit -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9A3;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="Charging Limit" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Limit the maximum charge level to extend battery lifespan" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="cbChargingLimit"
                                      Width="180"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      SelectionChanged="cbChargingLimit_SelectionChanged">
                                <ComboBoxItem Content="100%" />
                                <ComboBoxItem Content="80%" />
                                <ComboBoxItem Content="60%" />
                            </ComboBox>
                        </ui:CardControl>

                        <!-- Battery Telemetry CardExpander -->
                        <ui:CardExpander Margin="0,0,0,8"
                                         IsExpanded="True">
                            <ui:CardExpander.Icon>
                                <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="20" Margin="4,0,6,0" />
                            </ui:CardExpander.Icon>
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <ui:TextBlock FontTypography="Body" Text="Battery Telemetry" />
                                    <ui:TextBlock Margin="0,2,0,0"
                                                   FontTypography="Caption"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="Live battery metrics from the EC" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>

                                <!-- Current Charge Limit -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Current Charge Limit" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Active charging limit from the EC" />
                                    </StackPanel>
                                    <TextBlock x:Name="tbChargeLimit"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="--%" />
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                                <!-- Power Source -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Power Source" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Current power input state" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <ui:FontIcon x:Name="iconPowerSource"
                                                     FontFamily="Segoe Fluent Icons"
                                                     Glyph="&#xE9A3;"
                                                     FontSize="14"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center" />
                                        <TextBlock x:Name="tbPowerSource"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="--" />
                                    </StackPanel>
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                                <!-- State of Charge -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="State of Charge" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Current battery charge percentage" />
                                    </StackPanel>
                                    <TextBlock x:Name="tbStateOfCharge"
                                               Grid.Column="1"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               Text="--%" />
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                                <!-- Battery Health -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Battery Health" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Remaining capacity relative to design" />
                                    </StackPanel>
                                    <TextBlock x:Name="tbHealth"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="--%" />
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                                <!-- Temperature -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Temperature" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Internal battery temperature" />
                                    </StackPanel>
                                    <TextBlock x:Name="tbTemperature"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="-- °C" />
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                                <!-- Cycle Count -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Cycle Count" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Number of full charge/discharge cycles" />
                                    </StackPanel>
                                    <TextBlock x:Name="tbCycleCount"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="--" />
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                                <!-- Present Voltage -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Present Voltage" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Current battery voltage" />
                                    </StackPanel>
                                    <TextBlock x:Name="tbVoltage"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="-- mV" />
                                </Grid>

                                <!-- Divider -->
                                <Border Height="1" Margin="-58,12,-46,12"
                                        Background="{DynamicResource CardStrokeColorDefaultSolidBrush}" />

                                <!-- Charge Rate -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ui:TextBlock FontTypography="Body" Text="Charge Rate" />
                                        <ui:TextBlock Margin="0,2,0,0"
                                                       FontTypography="Caption"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="Current charge or discharge current" />
                                    </StackPanel>
                                    <TextBlock x:Name="tbChargeRate"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="-- mA" />
                                </Grid>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Row 1: Bottom bar — Refresh button anchored right -->
        <ui:Card x:Name="bottomBar" Grid.Row="1" MaxWidth="1052" HorizontalAlignment="Stretch" Margin="12,8,16,12" Padding="12,8" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="1"
                           x:Name="btnRefresh"
                           Click="btnRefresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" Margin="0,0,12,0" />
                        <TextBlock Text="Refresh" Margin="0,0,0,1"/>
                    </StackPanel>
                </ui:Button>
            </Grid>
        </ui:Card>
    </Grid>
</Page>
