<UserControl x:Class="Uniwill_Control_Utility.Views.Controls.HydroUiControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Uniwill_Control_Utility.Views.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FlowDirection="LeftToRight"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             UseLayoutRounding="True">

    <Grid>
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="20"
            MinHeight="160"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Drop24" FontSize="23" />
                <TextBlock Grid.Column="2" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22" FontWeight="SemiBold" Text="Hydro UI" />
                <Border Grid.Column="3" Height="32" Padding="14,0" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="#4BD879" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Text="Normal" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <Grid x:Name="spConnected" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Margin="0,0,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="12" Text="Fan Speed" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="_fanLabel" Margin="0,2,0,0" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="SemiBold" Text="--" />
                    </StackPanel>
                    <controls:DashboardSegmentedBar x:Name="_fanBar" Grid.Column="1" Height="10" Margin="26,0,0,0" VerticalAlignment="Center" Maximum="100" Segments="20" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                </Grid>

                <Border Grid.Column="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <Grid Grid.Column="2" Margin="22,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="12" Text="Pump" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="_pumpLabel" Margin="0,2,0,0" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="SemiBold" Text="--" />
                    </StackPanel>
                    <controls:DashboardSegmentedBar x:Name="_pumpBar" Grid.Column="1" Height="10" Margin="26,0,0,0" VerticalAlignment="Center" Maximum="12" Segments="20" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                </Grid>
            </Grid>

            <Grid x:Name="spDisconnected" Grid.Row="3" Visibility="Collapsed">
                <TextBlock VerticalAlignment="Center" Text="Disconnected" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Grid>
        </Border>
        <Border Style="{StaticResource DashboardInteractiveCardHoverBorderStyle}" />
    </Grid>
</UserControl>
