<UserControl x:Class="Uniwill_Control_Utility.Views.Controls.BatteryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Uniwill_Control_Utility.Views.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FlowDirection="LeftToRight"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             UseLayoutRounding="True">

    <Grid>
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            MinHeight="250"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="20" />
                <RowDefinition Height="92" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:FontIcon
                    FontFamily="Segoe Fluent Icons"
                    Glyph="&#xEBC0;"
                    FontSize="20"
                    Margin="4,0,2,0"/>
                <TextBlock Grid.Column="2"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="Battery"/>
                <Border x:Name="_healthPill" Grid.Column="3" Height="32" Padding="14,0" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:FontIcon x:Name="_healthIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xEB51;" FontSize="16" />
                        <TextBlock x:Name="_healthState" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <Grid Grid.Row="3" Margin="4,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="_batteryHealthHero" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="36" FontWeight="SemiBold" Text="--" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock  Margin="1,-1,0,0" FontSize="12" Text="Health" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border Grid.Column="1" Margin="0,6" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <StackPanel Grid.Column="2" Margin="22,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="_chargeLimitHero" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="36" FontWeight="SemiBold" Text="--" />
                    <TextBlock Margin="1,-1,0,0" FontSize="12" Text="Charge Limit" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="5" Margin="4,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Temperature" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <controls:SegmentedBar x:Name="_batteryTempBar" Grid.Column="1" Height="10" Margin="12,0" Maximum="100" Segments="20" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                <TextBlock x:Name="_batteryTempLabel" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Medium" Text="--" />
            </Grid>
        </Grid>
        </Border>
        <Border Style="{StaticResource DashboardInteractiveCardHoverBorderStyle}" />
    </Grid>
</UserControl>
