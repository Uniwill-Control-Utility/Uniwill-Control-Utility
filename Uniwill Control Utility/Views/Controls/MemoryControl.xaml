<UserControl x:Class="Uniwill_Control_Utility.Views.Controls.MemoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Uniwill_Control_Utility.Views.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FlowDirection="LeftToRight"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             UseLayoutRounding="True">

    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="20"
            MinHeight="250"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="10" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Ram20" FontSize="22" />
                <TextBlock Grid.Column="2" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22" FontWeight="SemiBold" Text="Memory" />
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock x:Name="_memoryUsedHero" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="34" FontWeight="SemiBold" Text="--" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="_memoryTotalHero" Margin="6,0,0,3" VerticalAlignment="Bottom" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="23" FontWeight="SemiBold" Text="" />
                    </StackPanel>
                    <TextBlock Margin="1,-2,0,0" FontSize="12" Text="Used memory" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock x:Name="_memoryPercent" Grid.Column="1" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22" FontWeight="SemiBold" Text="--" />
            </Grid>

            <controls:DashboardSegmentedBar x:Name="_memoryBar" Grid.Row="5" Height="10" Maximum="100" Segments="24" Fill="{DynamicResource AccentFillColorDefaultBrush}" />

            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" VerticalAlignment="Center" FontSize="12" Text="Module" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="_moduleModel" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="Medium" Text="Not available" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="12" Text="Speed" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="_moduleSpeed" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="Medium" Text="Not available" />

                <TextBlock Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" FontSize="12" Text="DIMM #1" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <controls:DashboardSegmentedBar x:Name="_memoryTemp1Bar" Grid.Row="0" Grid.Column="4" Height="8" Margin="6,0" Maximum="100" Segments="10" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                <TextBlock x:Name="_memoryTemp1Label" Grid.Row="0" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Medium" Text="--" />

                <TextBlock Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" FontSize="12" Text="DIMM #2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <controls:DashboardSegmentedBar x:Name="_memoryTemp2Bar" Grid.Row="1" Grid.Column="4" Height="8" Margin="6,0" Maximum="100" Segments="10" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                <TextBlock x:Name="_memoryTemp2Label" Grid.Row="1" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Medium" Text="--" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
