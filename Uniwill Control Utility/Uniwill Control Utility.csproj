<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Task Manager shows the exe file name — spaces are intentional. -->
    <AssemblyName>Uniwill Control Utility</AssemblyName>
    <PackageIcon>Assets/applicationIcon-256.png</PackageIcon>
    <Title>$(AssemblyName)</Title>
    <Authors>jgudec</Authors>
    <UseWindowsForms>True</UseWindowsForms>
    <SignAssembly>False</SignAssembly>
	<Copyright>© 2020-2026 UXTU Team, 2026 UCU Team</Copyright>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <!-- Single source of truth for the version: flows to AssemblyVersion, FileVersion,
         the About page, and build\pack.ps1 (Velopack packVersion).
         Must be 3-part (a.b.c) - Velopack rejects 4-part versions. Bump the third
         part for every release. -->
    <!-- Version: Directory.Build.props, the single source of truth. -->
    <!-- Custom Main in App.xaml.cs runs the Velopack bootstrap before WPF starts,
         so App.xaml is compiled as a Page (not ApplicationDefinition). -->
    <StartupObject>Uniwill_Control_Utility.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>True</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Optimize>True</Optimize>
  </PropertyGroup>

  <!-- Self-contained publish settings (use: dotnet publish -c Release -r win-x64 /p:SelfContained=true) -->
  <PropertyGroup Condition="'$(SelfContained)'=='true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtracting>true</IncludeAllContentForSelfExtracting>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

