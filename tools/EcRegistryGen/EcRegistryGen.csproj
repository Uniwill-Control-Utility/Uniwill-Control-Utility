<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build-time code generator for the EC registry (Ec\Registry\EcAddresses.json ->
       UCU.Core\Ec\Generated\EcAddresses.g.cs). Not part of the product: no product
       assembly references it, the solution does not build it, and the UCU.Core target
       drives it on demand. The Core suite links EcRegistryGenerator.cs so the tests
       pin the exact code the build runs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EcRegistryGen</AssemblyName>
    <RootNamespace>EcRegistryGen</RootNamespace>
    <Version>0.0.0</Version>
  </PropertyGroup>

</Project>
