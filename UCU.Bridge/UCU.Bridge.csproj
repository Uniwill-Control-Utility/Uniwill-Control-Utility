<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev-only in-process capability bridge: implements the same capability
       interfaces as UCU.Client's proxies, directly on EcEngine, for the app's
       "dev-inprocess" mode (run the UI against the EC without installing the
       service). It is the assembly that holds the UCU.Hardware reference, which
       is what lets the app itself drop that reference. Deleted in phase 6. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <AssemblyName>UCU.Bridge</AssemblyName>
    <RootNamespace>UCU.Bridge</RootNamespace>
    <Version>0.9.6</Version>
    <Copyright>© 2020-2026 UXTU Team, 2026 UCU Team</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UCU.Core\UCU.Core.csproj" />
    <ProjectReference Include="..\UCU.Contracts\UCU.Contracts.csproj" />
    <ProjectReference Include="..\UCU.Hardware\UCU.Hardware.csproj" />
  </ItemGroup>

</Project>
